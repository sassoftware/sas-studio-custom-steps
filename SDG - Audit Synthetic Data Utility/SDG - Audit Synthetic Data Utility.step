{"creationTimeStamp":"2026-09-06T13:06:52.246986Z","createdBy":"gerdaw","modifiedTimeStamp":"2026-09-06T13:19:06.058313Z","modifiedBy":"gerdaw","id":"8a64852b-380a-4492-837f-dde16aed6e67","name":"SDG - Audit Synthetic Data Utility.step","displayName":"SDG - Audit Synthetic Data Utility.step","localDisplayName":"SDG - Audit Synthetic Data Utility.step","links":[{"method":"GET","rel":"self","href":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","uri":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","type":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"alternate","href":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","uri":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","type":"application/vnd.sas.data.flow.step.summary"},{"method":"GET","rel":"up","href":"/dataFlows/steps","uri":"/dataFlows/steps","type":"application/vnd.sas.collection","itemType":"application/vnd.sas.data.flow.step.summary"},{"method":"PUT","rel":"update","href":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","uri":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","type":"application/vnd.sas.data.flow.step","responseType":"application/vnd.sas.data.flow.step"},{"method":"DELETE","rel":"delete","href":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","uri":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67"},{"method":"POST","rel":"copy","href":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67/copy","uri":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67/copy","responseType":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"transferExport","href":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","uri":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","responseType":"application/vnd.sas.transfer.object"},{"method":"PUT","rel":"transferImportUpdate","href":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","uri":"/dataFlows/steps/8a64852b-380a-4492-837f-dde16aed6e67","type":"application/vnd.sas.transfer.object","responseType":"application/vnd.sas.summary"}],"metadataVersion":1,"version":2,"type":"code","flowMetadata":{"inputPorts":[{"name":"realTable","displayName":"realTable","localDisplayName":"realTable","minEntries":1,"maxEntries":1,"defaultEntries":0,"type":"table"},{"name":"synthTable","displayName":"synthTable","localDisplayName":"synthTable","minEntries":1,"maxEntries":1,"defaultEntries":0,"type":"table"}],"outputPorts":[{"name":"summary","displayName":"summary","localDisplayName":"summary","minEntries":1,"maxEntries":1,"defaultEntries":0,"type":"table"}]},"ui":"{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"page1\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Controls\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"realTable\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Provide real data:\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"filter\": false\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"synthTable\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Provide synthetic data:\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"filter\": false\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"outLib\",\n\t\t\t\t\t\"type\": \"libraryselector\",\n\t\t\t\t\t\"label\": \"Provide output library name:\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"summary\",\n\t\t\t\t\t\"type\": \"outputtable\",\n\t\t\t\t\t\"label\": \"Provide name for the summary table:\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"summary table\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"extraTables\",\n\t\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\t\"label\": \"Create detail tables for the variables\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"tablePrefix\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Provide prefix for the output tables:\",\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"filterCondition\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Filter condition:\",\n\t\t\t\t\t\"placeholder\": \"e.g. BAD = 1\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"about\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"title1\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Synthetic Data Fidelity & Utility Audit\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"intro_text\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"This custom step compares a real dataset against a synthetic dataset to produce a composite similarity score. It evaluates data fidelity across four dimensions: numeric univariate similarity (mean, median, standard deviation), categorical univariate similarity (total variation distance and Jensen–Shannon divergence), categorical relationship fidelity (pairwise Cramér's V comparison), and numeric relationship fidelity (pairwise Spearman correlation comparison). Each dimension produces a detail table for drill-through analysis, and the results are combined into weighted statistical and relational similarity scores — proportional to the number of numeric and categorical variables — giving a single overall similarity percentage. An optional filter condition allows evaluation on specific subsets of the data.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"Parameters\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Parameters\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"Parameters_text\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"1. Real data — the two-level name of the real (original) dataset to use as the baseline for comparison (e.g. CASUSER.REAL).\\n2. Synthetic data — the two-level name of the synthetic dataset to evaluate against the real data (e.g. CASUSER.SYNTH).\\n3. Output library — the output library where all five result tables will be written (e.g. WORK or CASUSER). Defaults to WORK. \\n4. Summary table — Always written as similarity_scores in the output library (with any prefix applied). The output port lets you connect downstream flow nodes; the Table node itself is where you'd assign a custom flow name if needed.\\n5. Create detail tables (checkbox) — When ticked, four detail tables are written to the output library alongside the summary (per-variable and per-pair breakdowns for drill-through analysis). When unticked, only the summary table is kept.\\n6. Table prefix (optional) — Prefix prepended to all output table names (e.g. q4 produces q4_similarity_scores). Useful when running multiple comparisons in the same library without overwriting previous results.\\n7. Filter Condition — an optional WHERE expression to subset both tables before evaluation (e.g. bad=1). Leave blank to run against the full tables.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"References_id\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"References\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"References_text\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"The framework is mentioned in a presentation at SAS Innovate 2026 - watch here: https://www.youtube.com/watch?v=0waLptixaOk&list=PLVBcK_IpFVi-BXicJ5ZMcXuPNQTphJuhv&index=146&t=1s \",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"About\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"About\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"About_text\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"* Version: 1.1 (01JUL2026)\\n    - Implement review feedback\\n\\n* Version: 1.0 (11JUN2026)\\n    - Initial version\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"realTable\": {\n\t\t\t\"library\": \"\",\n\t\t\t\"table\": \"\"\n\t\t},\n\t\t\"synthTable\": {\n\t\t\t\"library\": \"\",\n\t\t\t\"table\": \"\"\n\t\t},\n\t\t\"outLib\": \"WORK\",\n\t\t\"summary\": {\n\t\t\t\"library\": \"\",\n\t\t\t\"table\": \"\"\n\t\t},\n\t\t\"extraTables\": true,\n\t\t\"tablePrefix\": \"\",\n\t\t\"filterCondition\": \"\"\n\t}\n}","localUi":"{\"pages\":[{\"children\":[{\"filter\":false,\"id\":\"realTable\",\"label\":\"Provide real data:\",\"placeholder\":\"\",\"required\":true,\"type\":\"inputtable\",\"visible\":\"\"},{\"filter\":false,\"id\":\"synthTable\",\"label\":\"Provide synthetic data:\",\"placeholder\":\"\",\"required\":true,\"type\":\"inputtable\",\"visible\":\"\"},{\"id\":\"outLib\",\"label\":\"Provide output library name:\",\"placeholder\":\"\",\"required\":false,\"type\":\"libraryselector\",\"visible\":\"\"},{\"id\":\"summary\",\"label\":\"Provide name for the summary table:\",\"placeholder\":\"summary table\",\"required\":true,\"type\":\"outputtable\",\"visible\":\"\"},{\"id\":\"extraTables\",\"label\":\"Create detail tables for the variables\",\"type\":\"checkbox\",\"visible\":\"\"},{\"id\":\"tablePrefix\",\"label\":\"Provide prefix for the output tables:\",\"placeholder\":\"\",\"required\":false,\"type\":\"textfield\",\"visible\":\"\"},{\"id\":\"filterCondition\",\"label\":\"Filter condition:\",\"placeholder\":\"e.g. BAD = 1\",\"required\":false,\"type\":\"textfield\",\"visible\":\"\"}],\"id\":\"page1\",\"label\":\"Controls\",\"type\":\"page\"},{\"children\":[{\"children\":[{\"id\":\"intro_text\",\"text\":\"This custom step compares a real dataset against a synthetic dataset to produce a composite similarity score. It evaluates data fidelity across four dimensions: numeric univariate similarity (mean, median, standard deviation), categorical univariate similarity (total variation distance and Jensen–Shannon divergence), categorical relationship fidelity (pairwise Cramér's V comparison), and numeric relationship fidelity (pairwise Spearman correlation comparison). Each dimension produces a detail table for drill-through analysis, and the results are combined into weighted statistical and relational similarity scores — proportional to the number of numeric and categorical variables — giving a single overall similarity percentage. An optional filter condition allows evaluation on specific subsets of the data.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"title1\",\"label\":\"Synthetic Data Fidelity \\u0026 Utility Audit\",\"open\":true,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"Parameters_text\",\"text\":\"1. Real data — the two-level name of the real (original) dataset to use as the baseline for comparison (e.g. CASUSER.REAL).\\n2. Synthetic data — the two-level name of the synthetic dataset to evaluate against the real data (e.g. CASUSER.SYNTH).\\n3. Output library — the output library where all five result tables will be written (e.g. WORK or CASUSER). Defaults to WORK. \\n4. Summary table — Always written as similarity_scores in the output library (with any prefix applied). The output port lets you connect downstream flow nodes; the Table node itself is where you'd assign a custom flow name if needed.\\n5. Create detail tables (checkbox) — When ticked, four detail tables are written to the output library alongside the summary (per-variable and per-pair breakdowns for drill-through analysis). When unticked, only the summary table is kept.\\n6. Table prefix (optional) — Prefix prepended to all output table names (e.g. q4 produces q4_similarity_scores). Useful when running multiple comparisons in the same library without overwriting previous results.\\n7. Filter Condition — an optional WHERE expression to subset both tables before evaluation (e.g. bad=1). Leave blank to run against the full tables.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"Parameters\",\"label\":\"Parameters\",\"open\":true,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"References_text\",\"text\":\"The framework is mentioned in a presentation at SAS Innovate 2026 - watch here: https://www.youtube.com/watch?v=0waLptixaOk\\u0026list=PLVBcK_IpFVi-BXicJ5ZMcXuPNQTphJuhv\\u0026index=146\\u0026t=1s \",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"References_id\",\"label\":\"References\",\"open\":false,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"About_text\",\"text\":\"* Version: 1.1 (01JUL2026)\\n    - Implement review feedback\\n\\n* Version: 1.0 (11JUN2026)\\n    - Initial version\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"About\",\"label\":\"About\",\"open\":true,\"type\":\"section\",\"visible\":\"\"}],\"id\":\"about\",\"label\":\"About\",\"type\":\"page\"}],\"showPageContentOnly\":true,\"syntaxversion\":\"1.3.0\",\"values\":{\"extraTables\":true,\"filterCondition\":\"\",\"outLib\":\"WORK\",\"realTable\":{\"library\":\"\",\"table\":\"\"},\"summary\":{\"library\":\"\",\"table\":\"\"},\"synthTable\":{\"library\":\"\",\"table\":\"\"},\"tablePrefix\":\"\"}}","templates":{"SAS":"/*============================================================\n  SYNTHETIC DATA COMPARISON — Custom Step Macro\n  ============================================================\n  PURPOSE\n    Compare a real table against a synthetic table across\n    four evaluation dimensions and produce a composite\n    similarity score.\n\n  VERSION\n    1.1 (01JUL2026)\n\n  DIMENSIONS\n    1. Numeric Univariate    — mean / median / std comparison\n    2. Categorical Univariate — TVD + JSD on category frequencies\n    3. Categorical Relationship — pairwise Cramér's V delta\n    4. Numeric Relationship    — pairwise Spearman ρ delta\n\n  PARAMETERS\n    realTable        Two-level name of real dataset\n    synthTable       Two-level name of synthetic dataset\n    filterCondition  Optional WHERE expression\n    outLib           Output library (default WORK)\n    summary          Summary output table name (default similarity_scores)\n    tablePrefix      Optional prefix prepended to output table names\n    extraTables      1/0 — also write the four detail tables (default 1)\n\n  OUTPUT TABLES (written to &outLib.)\n    <prefix_>similarity_scores               (always)\n    <prefix_>detail_num_univariate           (only if extraTables=1)\n    <prefix_>detail_cat_univariate           (only if extraTables=1)\n    <prefix_>detail_cat_relationship         (only if extraTables=1)\n    <prefix_>detail_num_relationship         (only if extraTables=1)\n============================================================*/\n\n/*********************************************\n  MACRO DEFINITION\n*********************************************/\n\n%macro syntheticDataComparison(\n    realTable       = ,\n    synthTable      = ,\n    filterCondition = ,\n    outLib          = WORK,\n    summary         = ,\n    tablePrefix     = ,\n    extraTables     = 1\n);\n\n    /* ============================================================\n       0.  SETUP\n       ============================================================ */\n    %local wc char_vars num_vars nChar nNum i var prefix\n           sc_numUni sc_catUni sc_catRel sc_numRel\n           tbl_summary tbl_numUni tbl_catUni tbl_catRel tbl_numRel\n           writeDetails _sumLib _sumName _sumVal;\n\n    options nosyntaxcheck;\n\n    /* --- reusable WHERE-clause dataset option --- */\n    %if %length(&filterCondition.) > 0 %then\n        %let wc = (where=(&filterCondition.));\n    %else\n        %let wc = ;\n\n    /* --- optional prefix --- */\n    %if %length(&tablePrefix.) > 0 %then\n        %let prefix = &tablePrefix._;\n    %else\n        %let prefix = ;\n\n    /* --- summary table: ignore SAS Studio's auto-generated placeholder\n           names (containing \"_FLW\") so the default applies --- */\n    %let _sumVal = &summary.;\n    %if %index(%upcase(&_sumVal.), _FLW) > 0 %then\n        %let _sumVal = ;\n\n    %if %length(&_sumVal.) = 0 %then %do;\n        %let _sumLib  = &outLib.;\n        %let _sumName = similarity_scores;\n    %end;\n    %else %if %index(&_sumVal., .) > 0 %then %do;\n        %let _sumLib  = %scan(&_sumVal., 1, .);\n        %let _sumName = %scan(&_sumVal., 2, .);\n    %end;\n    %else %do;\n        %let _sumLib  = &outLib.;\n        %let _sumName = &_sumVal.;\n    %end;\n    %let tbl_summary = &_sumLib..&prefix.&_sumName.;\n\n    /* --- detail tables always use the standard name in outLib + prefix --- */\n    %let tbl_numUni = &outLib..&prefix.detail_num_univariate;\n    %let tbl_catUni = &outLib..&prefix.detail_cat_univariate;\n    %let tbl_catRel = &outLib..&prefix.detail_cat_relationship;\n    %let tbl_numRel = &outLib..&prefix.detail_num_relationship;\n\n    /* --- decide whether to keep the detail tables after the run --- */\n    %let writeDetails = 0;\n    %if %symexist(extraTables) %then %do;\n        %if &extraTables. = 1 %then %let writeDetails = 1;\n    %end;\n    %else %do;\n        %let writeDetails = 1;\n    %end;\n\n    /* --- discover character variables --- */\n    proc sql noprint;\n        select name into :char_vars separated by ' '\n        from dictionary.columns\n        where libname = upcase(scan(\"&realTable.\", 1, '.'))\n          and memname = upcase(scan(\"&realTable.\", 2, '.'))\n          and type    = 'char';\n    quit;\n    %let nChar = %sysfunc(countw(&char_vars.));\n\n    /* --- discover numeric variables --- */\n    proc sql noprint;\n        select name into :num_vars separated by ' '\n        from dictionary.columns\n        where libname = upcase(scan(\"&realTable.\", 1, '.'))\n          and memname = upcase(scan(\"&realTable.\", 2, '.'))\n          and type    = 'num';\n    quit;\n    %let nNum = %sysfunc(countw(&num_vars.));\n\n    /* initialise component scores to missing */\n    %let sc_numUni = .;\n    %let sc_catUni = .;\n    %let sc_catRel = .;\n    %let sc_numRel = .;\n\n\n    /* ============================================================\n       1.  NUMERIC UNIVARIATE SIMILARITY\n       ============================================================ */\n    %if &nNum. > 0 %then %do;\n\n        proc means data=&realTable.&wc. noprint;\n            var &num_vars.;\n            output out=_nv_real mean= median= std= / autoname;\n        run;\n\n        proc means data=&synthTable.&wc. noprint;\n            var &num_vars.;\n            output out=_nv_fake mean= median= std= / autoname;\n        run;\n\n        proc transpose data=_nv_real(drop=_TYPE_ _FREQ_)\n             out=_nv_real_t(rename=(_NAME_=statistic col1=real_value));\n        run;\n        proc transpose data=_nv_fake(drop=_TYPE_ _FREQ_)\n             out=_nv_fake_t(rename=(_NAME_=statistic col1=fake_value));\n        run;\n\n        proc sort data=_nv_real_t; by statistic; run;\n        proc sort data=_nv_fake_t; by statistic; run;\n\n        data &tbl_numUni;\n            merge _nv_real_t _nv_fake_t;\n            by statistic;\n\n            length variable $32 stat_type $10;\n            stat_type = scan(statistic, -1, '_');\n            variable  = substr(statistic, 1,\n                          length(statistic) - length(stat_type) - 1);\n\n            denom          = max(abs(real_value), abs(fake_value), 1);\n            pct_similarity = 100 - 100 * abs(real_value - fake_value) / denom;\n\n            drop denom;\n        run;\n\n        proc means data=&tbl_numUni noprint;\n            var pct_similarity;\n            output out=_nv_agg mean=_mean;\n        run;\n\n        data _null_;\n            set _nv_agg;\n            call symputx('sc_numUni', _mean / 100);\n        run;\n\n    %end;\n\n\n    /* ============================================================\n       2.  CATEGORICAL UNIVARIATE SIMILARITY\n       ============================================================ */\n    %if &nChar. > 0 %then %do;\n\n        %do i = 1 %to &nChar.;\n            %let var = %scan(&char_vars., &i.);\n\n            proc freq data=&realTable.&wc. noprint;\n                tables &var. / out=_cf_r_&i.;\n            run;\n\n            data _cf_r_&i.(keep=varname category PERCENT);\n                length varname $32 category $256;\n                set _cf_r_&i.;\n                varname  = \"&var.\";\n                category = strip(&var.);\n            run;\n        %end;\n\n        data _cf_real;\n            set %do i = 1 %to &nChar.; _cf_r_&i. %end;;\n        run;\n\n        %do i = 1 %to &nChar.;\n            %let var = %scan(&char_vars., &i.);\n\n            proc freq data=&synthTable.&wc. noprint;\n                tables &var. / out=_cf_s_&i.;\n            run;\n\n            data _cf_s_&i.(keep=varname category PERCENT);\n                length varname $32 category $256;\n                set _cf_s_&i.;\n                varname  = \"&var.\";\n                category = strip(&var.);\n            run;\n        %end;\n\n        data _cf_fake;\n            set %do i = 1 %to &nChar.; _cf_s_&i. %end;;\n        run;\n\n        proc sort data=_cf_real; by varname category; run;\n        proc sort data=_cf_fake; by varname category; run;\n\n        data _cf_merged;\n            merge _cf_real(rename=(PERCENT=real_pct))\n                  _cf_fake(rename=(PERCENT=fake_pct));\n            by varname category;\n\n            real_p = coalesce(real_pct, 0) / 100;\n            fake_p = coalesce(fake_pct, 0) / 100;\n\n            tvd_i = abs(real_p - fake_p);\n\n            M = (real_p + fake_p) / 2;\n\n            if real_p > 0 and M > 0 then kl_r = real_p * log2(real_p / M);\n            else kl_r = 0;\n\n            if fake_p > 0 and M > 0 then kl_f = fake_p * log2(fake_p / M);\n            else kl_f = 0;\n        run;\n\n        proc means data=_cf_merged noprint;\n            by varname;\n            var tvd_i kl_r kl_f;\n            output out=_cf_summary\n                sum(tvd_i) = tvd_raw\n                sum(kl_r)  = kl_real\n                sum(kl_f)  = kl_fake;\n        run;\n\n        data &tbl_catUni(keep=varname TVD JSD);\n            set _cf_summary;\n            JSD = sqrt(0.5 * (kl_real + kl_fake));\n            TVD = 0.5 * tvd_raw;\n        run;\n\n        proc means data=&tbl_catUni mean max noprint;\n            var TVD JSD;\n            output out=_cf_agg\n                mean = Mean_TVD Mean_JSD\n                max  = Max_TVD  Max_JSD;\n        run;\n\n        data _null_;\n            set _cf_agg;\n            _tvd = mean((1 - Mean_TVD), (1 - Max_TVD));\n            _jsd = mean((1 - Mean_JSD), (1 - Max_JSD));\n            call symputx('sc_catUni', mean(_tvd, _jsd));\n        run;\n\n    %end;\n\n\n    /* ============================================================\n       3.  CATEGORICAL RELATIONSHIP FIDELITY (Cramér's V)\n       ============================================================ */\n    %if &nChar. >= 2 %then %do;\n\n        ods exclude all;\n        proc freq data=&realTable.&wc.;\n            tables (&char_vars.) * (&char_vars.) / chisq;\n            ods output ChiSq = _cv_real_chi;\n        run;\n        ods exclude none;\n\n        data _cv_real(keep=Var1 Var2 Real_V);\n            length Var1 Var2 $32;\n            set _cv_real_chi(where=(statistic = \"Cramer's V\"));\n            Var1   = scan(table, 2, ' ');\n            Var2   = scan(table, 4, ' ');\n            Real_V = value;\n            if Var1 < Var2;\n        run;\n\n        ods exclude all;\n        proc freq data=&synthTable.&wc.;\n            tables (&char_vars.) * (&char_vars.) / chisq;\n            ods output ChiSq = _cv_fake_chi;\n        run;\n        ods exclude none;\n\n        data _cv_fake(keep=Var1 Var2 Fake_V);\n            length Var1 Var2 $32;\n            set _cv_fake_chi(where=(statistic = \"Cramer's V\"));\n            Var1   = scan(table, 2, ' ');\n            Var2   = scan(table, 4, ' ');\n            Fake_V = value;\n            if Var1 < Var2;\n        run;\n\n        proc sort data=_cv_real; by Var1 Var2; run;\n        proc sort data=_cv_fake; by Var1 Var2; run;\n\n        data &tbl_catRel;\n            merge _cv_real _cv_fake;\n            by Var1 Var2;\n            if Real_V = . then Real_V = 0;\n            if Fake_V = . then Fake_V = 0;\n            Abs_Delta = abs(Real_V - Fake_V);\n        run;\n\n        proc means data=&tbl_catRel noprint;\n            var Abs_Delta;\n            output out=_cv_agg mean=_mean;\n        run;\n\n        data _null_;\n            set _cv_agg;\n            call symputx('sc_catRel', 1 - _mean);\n        run;\n\n    %end;\n\n\n    /* ============================================================\n       4.  NUMERIC RELATIONSHIP FIDELITY (Spearman)\n       ============================================================ */\n    %if &nNum. >= 2 %then %do;\n\n        proc corr data=&realTable.&wc. spearman noprint outp=_sp_real;\n            var &num_vars.;\n        run;\n        proc corr data=&synthTable.&wc. spearman noprint outp=_sp_fake;\n            var &num_vars.;\n        run;\n\n        data _sp_real_long(keep=Var1 Var2 Real_Corr);\n            set _sp_real(where=(_TYPE_ = 'CORR'));\n            array v {*} &num_vars.;\n            length Var1 Var2 $32;\n            Var1 = _NAME_;\n            do _j = 1 to dim(v);\n                Var2      = vname(v[_j]);\n                Real_Corr = v[_j];\n                if Var1 < Var2 then output;\n            end;\n        run;\n\n        data _sp_fake_long(keep=Var1 Var2 Fake_Corr);\n            set _sp_fake(where=(_TYPE_ = 'CORR'));\n            array v {*} &num_vars.;\n            length Var1 Var2 $32;\n            Var1 = _NAME_;\n            do _j = 1 to dim(v);\n                Var2      = vname(v[_j]);\n                Fake_Corr = v[_j];\n                if Var1 < Var2 then output;\n            end;\n        run;\n\n        proc sort data=_sp_real_long; by Var1 Var2; run;\n        proc sort data=_sp_fake_long; by Var1 Var2; run;\n\n        data &tbl_numRel;\n            merge _sp_real_long _sp_fake_long;\n            by Var1 Var2;\n            if Real_Corr = . then Real_Corr = 0;\n            if Fake_Corr = . then Fake_Corr = 0;\n            Abs_Delta = min(abs(Real_Corr - Fake_Corr), 1.0);\n        run;\n\n        proc means data=&tbl_numRel noprint;\n            var Abs_Delta;\n            output out=_sp_agg mean=_mean;\n        run;\n\n        data _null_;\n            set _sp_agg;\n            call symputx('sc_numRel', 1 - _mean);\n        run;\n\n    %end;\n\n\n    /* ============================================================\n       5.  FINAL SIMILARITY SCORES\n       ============================================================ */\n    data &tbl_summary;\n        format overall_similarity_pct\n               statistical_similarity_pct\n               relational_similarity_pct\n               num_similarity_pct\n               char_similarity_pct\n               char_corr_pct\n               num_corr_pct percent10.3;\n\n        num_similarity_pct  = &sc_numUni.;\n        char_similarity_pct = &sc_catUni.;\n        char_corr_pct       = &sc_catRel.;\n        num_corr_pct        = &sc_numRel.;\n\n        _nw = ifn(num_similarity_pct  = ., 0, &nNum.);\n        _cw = ifn(char_similarity_pct = ., 0, &nChar.);\n\n        if (_nw + _cw) > 0 then\n            statistical_similarity_pct =\n                (_nw * num_similarity_pct + _cw * char_similarity_pct)\n                / (_nw + _cw);\n        else\n            statistical_similarity_pct = .;\n\n        _nw_r = ifn(num_corr_pct  = ., 0, &nNum.);\n        _cw_r = ifn(char_corr_pct = ., 0, &nChar.);\n\n        if (_nw_r + _cw_r) > 0 then\n            relational_similarity_pct =\n                (_nw_r * num_corr_pct + _cw_r * char_corr_pct)\n                / (_nw_r + _cw_r);\n        else\n            relational_similarity_pct = .;\n\n        overall_similarity_pct = mean(\n            statistical_similarity_pct,\n            relational_similarity_pct\n        );\n\n        drop _nw _cw _nw_r _cw_r;\n    run;\n\n\n    /* ============================================================\n       CLEANUP\n       Always remove intermediate WORK tables.\n       If extraTables=0, also remove the four detail tables.\n       ============================================================ */\n    proc datasets lib=WORK nolist nowarn;\n        delete\n            _nv_real _nv_fake _nv_real_t _nv_fake_t _nv_agg\n            _cf_r_: _cf_s_: _cf_real _cf_fake _cf_merged\n            _cf_summary _cf_agg\n            _cv_real_chi _cv_fake_chi _cv_real _cv_fake _cv_agg\n            _sp_real _sp_fake _sp_real_long _sp_fake_long _sp_agg\n        ;\n    quit;\n\n    %if &writeDetails. = 0 %then %do;\n        proc datasets lib=&outLib. nolist nowarn;\n            delete &prefix.detail_num_univariate\n                   &prefix.detail_cat_univariate\n                   &prefix.detail_cat_relationship\n                   &prefix.detail_num_relationship;\n        quit;\n    %end;\n\n\n    %put NOTE: =====================================================;\n    %put NOTE: Synthetic Data Comparison Complete                    ;\n    %put NOTE: Num Univar   : &sc_numUni.                           ;\n    %put NOTE: Cat Univar   : &sc_catUni.                           ;\n    %put NOTE: Cat Relation : &sc_catRel.                           ;\n    %put NOTE: Num Relation : &sc_numRel.                           ;\n    %put NOTE: Output lib   : &outLib.                              ;\n    %put NOTE: Detail tables: %sysfunc(ifc(&writeDetails.=1, kept, removed));\n    %put NOTE: =====================================================;\n\n%mend syntheticDataComparison;\n\n\n/*********************************************\n  EXECUTION CODE\n*********************************************/\n\n%syntheticDataComparison(\n    realTable       = &realTable,\n    synthTable      = &synthTable,\n    filterCondition = &filterCondition,\n    outLib          = &outLib,\n    summary         = &summary,\n    tablePrefix     = &tablePrefix,\n    extraTables     = &extraTables\n);\n\n\n/*********************************************\n  CLEAN UP\n*********************************************/\n\n%sysmacdelete syntheticDataComparison / nowarn;\n\n%symdel\n    realTable\n    synthTable\n    filterCondition\n    outLib\n    summary\n    tablePrefix\n    extraTables\n    / nowarn\n;"}}
