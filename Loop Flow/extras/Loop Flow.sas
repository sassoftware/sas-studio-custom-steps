/* region: Generation of code */
%macro generateCodefromFlow(flowToCode=,outfileref=,errorabort=YES);
	/*
		Define fileref used to store generated code
	*/
	filename _gctemp temp;
	%put NOTE: Generating code from flow &flowToCode;

	/* Generate python code as this MUST be called using %inc when
	  python is called inside a macro
	*/

	/* Creating request file */
	/* Generate following code 
		{
		  "object": {
		    "value": "string",
		    "mediaType": "application/vnd.sas.dataflow"
		  },
		  "initCode": true,
		  "wrapperCode": true
		}
	*/
	filename _phycode temp;
	data _null_;
		file _phycode lrecl=5000;
		put 'submit;'
			/
			/ 'import json'
			/
			/ 'flowToCode=SAS.symget("flowToCode")'
			/ 'with open(flowToCode) as jsonFlowFile:'
			/ '   flow = jsonFlowFile.read()'
			/
			/ "sourceObject = {'value': flow, 'mediaType': 'application/vnd.sas.dataflow'}"
			/ "codeGenerationRequest = {'object': sourceObject, 'initCode': False, 'wrapperCode': False}"
			/
			/ 'reqFile=SAS.symget("jsonfile")'
			/ "with open(reqFile, 'w') as f:"
			/ '   json.dump(codeGenerationRequest, f)'
			/
			/ 'endsubmit;';
	run;

	/* 
	Generate JSON-file and store in temp fileref _req
	Useses Python-code as this have greate support for JSON
	*/
	filename _req temp;

	data _null_;
		call symput('jsonfile',strip(pathname('_req')));  /* file where the request is stored */
		call symput('flowToCode',strip("&flowToCode"));   /* The flow located on the file system */
	run;

	proc python RESTART timeout=90;
		%inc _phycode;
	run;
	filename _phycode clear;

	/* 
	Generate code using PROC HTTP to be able to reuse token and session.
	Input to the call (_req) is the JSON-file generated by the python call above

	The generated code will be temporary placed in filename _gctemp.

	if the call is succesfull (SYS_PROCHTTP_STATUS_CODE = 201) the code is copied
		to the destination folder given by filename _gencode.
	*/
	
	/* SDKTJJ 04AUG2023: Perform code gen with some resilience */
	%local codegenRetrySleeptime codegenTryCount codegenRetries;
	%let codegenRetries=3 /* 3 */;
	%let codegenRetrySleeptime=120; /* In seconds */
	%let codegenTryCount=1;
	%global SYS_PROCHTTP_STATUS_CODE;
	%do %until(
			(&SYS_PROCHTTP_STATUS_CODE=200 or &SYS_PROCHTTP_STATUS_CODE=201) or 
			(&codegenTryCount gt %eval(&codegenRetries+1))
		);
		proc http
			method=post FOLLOWLOC
			url = "https://sas-studio-development/studioDevelopment/code"
			out= _gctemp
			in=_req
			oauth_bearer = sas_services
			;	
			headers
		        'Accept'= 'application/vnd.sas.code.generation.request+json'
				'Content-Type' = 'application/json'
			;

			sslparms "SSLREQCERT"= "ALLOW";
			
			*debug level=2;
		run;

		%if (&SYS_PROCHTTP_STATUS_CODE>201) %then %do;
			/* We have a failure in code gen */
			%if &codegenTryCount lt %eval(&codegenRetries+1) %then %do;
				%put NOTE: Codegen attempt #&codegenTryCount failed. Retrying in &codegenRetrySleeptime seconds.;
				%let rc=%sysfunc(sleep(&codegenRetrySleeptime,1));
			%end;
			%else %if &codegenRetries gt 0 %then 
				%put ERROR%QUOTE(:) Final Codegen attempt, #&codegenTryCount, failed.;
			%let codegenTryCount=%eval(&codegenTryCount+1);
		%end;
	%end;

	/*
		Handle response in fileref _gctemp
	*/
	%if &SYS_PROCHTTP_STATUS_CODE<=201 %then %do;
		/* 	
			We use python code to store the content of the 'code' tag 
			as this handles newlines (\n), uft8 etc. nicely.
		*/
		filename _jreq temp; 		/* The python code used to extract the 'code' tag */
		filename _gencode temp;		/* The generated code */
		data _null_;
			file _jreq lrecl=5000;
			put 'submit;'
				/
				/ 'import json'
				/ 'gctempfile=SAS.symget("_gctempfile")'
				/ 'gencode=SAS.symget("_gencodefile")'
				/
				/ 'with open(gctempfile) as jsonFlowFile:'
				/ '  flow = json.load(jsonFlowFile)'
				/
				/ "with open(gencode, 'w') as the_file:"
		    	/ "  the_file.writelines(flow['code'])"
				/
				/ 'endsubmit;';		
		run;
		
		data _null_;
			/* The python code used to extract the 'code' tag */
			call symput('_jreqfile',strip(pathname('_jreq')));

			/* The JSON gererated from the call to /studioDevelopment/code */
			call symput('_gctempfile',strip(pathname('_gctemp')));

			/* The generated code must be stored in fileref _gencode  */
			call symput('_gencodefile',strip(pathname("_gencode")));
		run;
		proc python RESTART;
			%inc "&_jreqfile";
		run;
		filename _jreq clear;

		/* Copy from _gencode to target fileref */
		%let fcopyrc=%sysfunc(fcopy(_gencode,&outfileref));
		filename _gencode clear;
	%end;
	%else %do;
		/* Handle response if not 201 */
		data _null_;
			/* Print ERROR */
			if _n_=1 then do;
				put "ERROR: Code generation failed for &flowToCode";
			end;

			/* Print request */
			infile _gctemp;
			input;
			put _infile_;

			if "&errorabort"="YES" then do;
				put "ERROR: Failed Code Generation and errorabort=YES: Will abort.";
				abort return 2 NOLIST;
			end;
		run;
	%end;

	filename _req clear;
	filename _gctemp clear;
%mend;

