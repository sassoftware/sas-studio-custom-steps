/* region: Loop Macros */
%macro etls_tsLevel(macroName=, featureName=);

	data _null_;
		call symput("&macroName",tslvl("&featureName"));
	run;

%mend etls_tsLevel;

%macro etls_signon(handleName=etlsRemote,
			cmacvar=etls_signonStatus,
			gridRC=rc,
			useGrid=1,
			machineIdMacroVariable=etls_machineId,
			gridOptionSet=,
			workloadMacroVariable=,
			log=,
			output=,
			additionalSignonOptions=,
			signonRetries=3,
			gridJobName=&&etls_jobName&row);
	%let etls_gridInstalled =;

	%etls_tsLevel(macroName=etls_gridInstalled, featureName=uwugrdsv);

	%if (&useGrid = 1) %then %do;
		%if ("&etls_gridInstalled" ne "") %then %do;
			%if (&gridRC eq ) %then
				%let gridRC = &handleName.RC;
			%global &gridRC;
			%let workload =;

			%if ("&workloadMacroVariable" ne "") %then %do;

				data _null_;
					call symput('workload','; workload = '||symget("&workloadMacroVariable"));
				run;

			%end;

			%let gridoptset =;

			%if ("&gridOptionSet" ne "") %then %do;

				data _null_;
					call symput('gridoptset',"; gridoptset = '"||"&gridOptionSet"||"'");
				run;

			%end;

			%let gridJobOpts =;
			%let gridSuppOpts =;

			%if ("&etls_gridSuppJobOptions" ne "") %then %do;

				data _null_;
					call symput('gridJobOpts', "&etls_gridSuppJobOptions");
				run;

				data _null_;
					call symput('gridSuppOpts', '; JOBOPTS=gridJobOpts');
				run;

			%end;

			data _null_;
				call symput('gridJbName', "; jobname = gridJobName");
			run;

			%let &gridRC=2; /* Reports that one or all server sessions were disabled from grid execution */
			%if %str(&etls_sasConnectContext) ne %str() %then %do;
				%let &gridRC = %sysfunc(grdsvc_enable("&handleName", "server = &etls_sasConnectContext &gridoptset &workload &gridSuppOpts &gridJbName"));
			%end;
		%end;
		%else %put %str(NOTE: Grid service functions are not installed.);
	%end;

	%local sleeptime sleepIncreaseAmount tryCount;
	%let sleepIncreaseAmount=5;
	%let sleeptime=5;
	%let tryCount=1;
	%let &cmacvar=1;

	/* Store original return code values to reset them if a signon succeeds  */
	%local etls_sysrc;
	%local etls_syscc;
	%let etls_sysrc = &sysrc;
	%let etls_syscc = &syscc;
	%put NOTE: Condition codes before signon: &=syserr &=syscc &=etls_syscc  &=handleName;

	%do %until((&&&cmacvar ne 1) or (&tryCount gt %eval(&signonRetries+1)));

		data _null_;
			signon &handleName cmacvar=&cmacvar 
			%if ("&log" ne "") %then 
				log=&log;

			%if ("&output" ne "") %then
				output=&output;

			%if %str(&etls_sasConnectContext) ne %str() %then %do;
				inheritlib=(work=swork);
			%end;

			%if ("&additionalSignonOptions" ne "") %then
				&additionalSignonOptions;
			;
		
			
		run;

		%if "&&&cmacvar" eq "1" %then %do;
			%if &tryCount lt %eval(&signonRetries+1) %then %do;
				%put NOTE: Signon attempt #&tryCount failed. Retrying in &sleeptime seconds.;
				%let rc=%sysfunc(sleep(&sleeptime,1));
			%end;
			%else %if &signonRetries gt 0 %then %put ERROR%QUOTE(:) Final signon attempt, #&tryCount, failed.;
			%let sleeptime=%sysevalf(&sleeptime+&sleepIncreaseAmount,int); /* increase sleeptime by factor */
			%let tryCount=%eval(&tryCount+1);
		%end;
		%else %do;

			/* Signon succeeded make sure return codes are reset to original values  */
			%let sysrc = &etls_sysrc;
			%let syscc = &etls_syscc;

			/* Initialize syserr to 0 */
			data _null_;
			run;

			%put NOTE: Condition codes after succesful signon: &=syserr &=syscc &=etls_syscc  &=handleName;
		%end;
	%end;

	%put NOTE: Condition codes after all signon attempts: &=syserr &=syscc &=handleName;

	%rcSet(&syserr);

	/* On successful signon, fetch and report machine name if grid was requested. */
	%if ("&machineIdMacroVariable" ne "") %then
		%let &machineIdMacroVariable =;

	%if ("&&&cmacvar" ne "1" and "&machineIdMacroVariable" ne "" and 
		&useGrid = 1 and "&etls_gridInstalled" ne "") %then %do;
		%put;

		%if ("&&&gridRC" eq "0") %then %do;
			%let &machineIdmacroVariable = %sysfunc(grdsvc_getname(&handleName));
			%put %str(NOTE: Signed on to grid machine &&&machineIdmacroVariable..);
		%end;
		%else %put %str(NOTE: GRID SERVICES WERE NOT ENABLED.  Signed on to LOCAL machine.);
		%put;
	%end;
%mend etls_signon;

%macro etls_serverConnected(serverId=,macvarname=isConnected);
	%let &macvarname=0;
	%local search_str none_str savenotes;

	/* setup information for listtask output */
	/* listtask output on OS/390 differs */
	%if %bquote(&sysscp) eq OS %then %do;
		%let search_str=Remote submit for;
		%let token=5;
	%end;
	%else %do;
		%let search_str=--------------;
		%let token=1;
	%end;

	/* Issue listtask within PROC PRINTTO - send output to file */
	%let __old_printtolog=%trim(%left(&sysprinttolog));
	filename __tmptxt TEMP;
	%let savenotes=%sysfunc(getoption(notes));
	options nonotes;

	proc printto log=__tmptxt new;
	run;

	options notes;
	listtask;

	proc printto log=
		%if %str(&__old_printtolog) ne %str() %then %do;
			&__old_printtolog
		%end;
		%else %do;
			log
		%end;
		;
	run;

	options nonotes;

	/* read in the output from listtask */
	%let dsname=_null_;

	data _null_(keep=Session);
		length line $256 sessionId $60;
		infile __tmptxt length=len;
		input @1 line $varying. len;

		if line=:'There are no' then
			stop;

		/* look for the search string and scan for server name */
		if index(line,"&search_str") then do;
			sessionId=kscan(line,&token," ");
			sessionId=kupcase(ktrim(kleft(tranwrd(sessionId,'"',' '))));

			if sessionId=kupcase(symget("serverId")) then do;
				call symput("&macvarname","1");
				stop;
			end;
		end;
	run;

	filename __tmptxt clear;
	options &savenotes;
%mend etls_serverConnected;

%macro etls_signoff(handleName=rmt);
	%local savemprint;
	%let savemprint=%sysfunc(getoption(mprint));
	%put %str(NOTE: Testing connection with etls_serverConnected macro %(mprint off%).);
	options nomprint;
	%local isConnected;

	%etls_serverConnected(serverId=&handleName);
	options &savemprint;

	%if &isConnected %then
		signoff &handleName ;;
%mend etls_signoff;

%macro etls_getHandle(statusTable=, handleVariable=, row=);
	%let etls_dsid = %sysfunc(open(&statusTable));

	%if (&etls_dsid = 0) %then
		%put %sysfunc(sysmsg());
	%else %do;
		%let rc = %sysfunc(fetchobs(&etls_dsid, &row));

		%if (&rc ne 0) %then
			%put %sysfunc(sysmsg());
		%else %do;
			%let etls_varnum = %sysfunc(varnum(&etls_dsid,&handleVariable));

			%if (&etls_varnum > 0) %then
				%sysfunc(getvarc(&etls_dsid,&etls_varnum));
			%else %put %sysfunc(sysmsg());
		%end;

		%let rc = %sysfunc(close(&etls_dsid));
	%end;
%mend etls_getHandle;

%macro etls_freeHandle(statusTable=, statusVariable=, handleVariable=, 
			handleName=, statusSetting="Finished", 
			endTimeVariable=endTime, startTimeVariable=startTime, signoff=1, 
			returnCodeVariable=, returnCodeMacroVariable=, setMainJobRC=1, 
			statusUnknownReturnCode=., startTimeMacroVariable=, endTimeMacroVariable= );
	%if (&statusTable ne ) %then %do;
		%local etls_rcMacroVarExisted;
		%let etls_rcMacroVarExisted = 0;

		%if ("&returnCodeMacroVariable" ne "") %then %do;

			proc sql noprint;
				select '1' into: etls_rcMacroVarExisted from dictionary.macros 
					where name=kupcase("&returnCodeMacroVariable");
			quit;

			%rcSet(&sqlrc);

			%if (&etls_rcMacroVarExisted = 0) %then %do;
				%put WARNING%QUOTE(:) Return code from inner job not found.  Setting status to Unknown.;
				%let &returnCodeMacroVariable=&statusUnknownReturnCode;
			%end;

			%if (&setMainJobRC eq 1) %then
				%rcSet(&&&returnCodeMacroVariable);
		%end;
		%else %do;
			%let returnCodeMacroVariable=etls_rcmacvar;
			%let &returnCodeMacroVariable=&statusUnknownReturnCode;
		%end;

		%local etls_startTimeMacroVarExisted;
		%let etls_startTimeMacroVarExisted = 0;

		%if ("&startTimeMacroVariable" ne "") %then %do;

			proc sql noprint;
				select '1' into: etls_startTimeMacroVarExisted from dictionary.macros 
					where name=kupcase("&startTimeMacroVariable");
			quit;

			%rcSet(&sqlrc);

			%if (&etls_startTimeMacroVarExisted = 0) %then %do;
				%put WARNING%QUOTE(:) Start time from inner job not found.  No value will be set.;
				%let &startTimeMacroVariable=;
			%end;
		%end;

		%local etls_endTimeMacroVarExisted;
		%let etls_endTimeMacroVarExisted = 0;

		%if ("&endTimeMacroVariable" ne "") %then %do;

			proc sql noprint;
				select '1' into: etls_endTimeMacroVarExisted from dictionary.macros 
					where name=kupcase("&endTimeMacroVariable");
			quit;

			%rcSet(&sqlrc);

			%if (&etls_endTimeMacroVarExisted = 0) %then %do;
				%put WARNING%QUOTE(:) End time from inner job not found.  Setting end time to current
					time.;
				%let &endTimeMacroVariable=%sysfunc(datetime());
			%end;
		%end;

		data &statusTable;
			modify &statusTable(where=(&handleVariable = &handleName));

			%if ("&startTimeMacroVariable" ne "") %then %do;
				&startTimeVariable = input(symget("&startTimeMacroVariable"),32.);;
			%end;

			%if ("&endTimeVariable" ne "") %then %do;
				%if ("&endTimeMacroVariable" ne "") %then %do;
					&endTimeVariable = input(symget("&endTimeMacroVariable"),32.);;
				%end;
				%else &endTimeVariable = datetime();;
			%end;

			%if ("&returnCodeVariable" ne "") %then
				&returnCodeVariable = input(symget("&returnCodeMacroVariable"),32.);;

			%if ("&statusVariable" ne "") %then %do;
				if (symget("etls_rcMacroVarExisted") eq "0") then
					&statusVariable = "Unknown Status";
				else &statusVariable = &statusSetting;
			%end;

			call symput('handle',&handleVariable);
			replace;
			stop;
		run;

		%rcSet(&syserr);

		%if (&signoff eq 1) %then
			%etls_signoff(handleName=&handle);

		%if (&&&returnCodeMacroVariable > 4 or &&&returnCodeMacroVariable = .)  and &etls_AbortOnError=1  %then %do;
			%put ERROR: Error code returned from %trim(&handle) is &&&returnCodeMacroVariable. Will abort.;
			%abort return 2;
		%end;
		
	%end;
%mend etls_freeHandle;

%macro etls_createHandle(statusTable=,
			statusVariable=,
			handleVariable=,
			handlePrefix=rmt,
			gridOptionSet=,
			workloadMacroVariable=,
			row=,
			machineVariable=,
			statusSetting="Running", 
			startTimeVariable=startTime,
			signon=1,
			useGrid=1,
			log=,
			output=,
			gridRC=,
			cmacvar=etls_signonStatus,
			additionalSignonOptions=,
			signonRetries= );
	%local remoteSessionId;
	%let remoteSessionId = &handlePrefix.&row;
	%let &cmacvar = 1;
	%local etls_machineId;

	%if (&signon eq 1) %then
		%etls_signon(handleName=&remoteSessionId,
		useGrid=&useGrid,
		machineIdMacroVariable=etls_machineId,
		gridOptionSet=&etls_gridOptionSet,
		workloadMacroVariable=&workloadMacroVariable,
		log=&log,
		output=&output,
		cmacvar=&cmacvar,
		gridRC=&gridRC,
		additionalSignonOptions=&additionalSignonOptions,
		signonRetries=&signonRetries,
		gridJobName=DIS_&etls_jobName._&row);
	%else %let &cmacvar=0;

	data &statusTable;
		retain ptr &row;
		modify &statusTable point = ptr;
		&handleVariable = "&remoteSessionId";

		%if (&signon eq 1) %then
			&machineVariable = "&etls_machineId";;

		%if (&&&cmacvar ne 0) %then %do;
			&statusVariable = "Failed Signon";
		%end;
		%else &statusVariable = &statusSetting;;

		%if (&startTimeVariable ne ) %then
			&startTimeVariable = datetime();;
		replace;
		stop;
	run;

	%rcSet(&syserr);
%mend etls_createHandle;

%macro etls_waitfor(statusTable=, statusVariable=, runningStatusSetting="Running", handleVariable=, 
			completeStatusSetting="Finished", endTimeVariable=endTime, 
			startTimeVariable=startTime, waitType=_ANY_, signoff=1, 
			returnCodeVariable=, returnCodeMacroVariable=, statusUnknownReturnCode=.);

	proc sql noprint;
		select count(*) into :etls_rows 
			from &statusTable where &statusVariable = &runningStatusSetting;
		%let etls_rows = &etls_rows;

		%if (&etls_rows gt 0) %then %do;
			select &handleVariable into :etlsHandles1 - :etlsHandles&etls_rows 
				from &statusTable where &statusVariable = &runningStatusSetting;
		%end;
	quit;

	%rcSet(&sqlrc);

	%if (&etls_rows gt 0) %then %do;
		waitfor &waitType 
			%do i=1 %to &etls_rows;
				&&etlsHandles&i
			%end;
		;
	%end;

	%local useDefaultRCMacVar;

	%if ("&returnCodeMacroVariable" eq "") %then
		%let useDefaultRCMacVar=Y;

	%do i=1 %to &etls_rows;
		%if ("&useDefaultRCMacVar"="Y") %then
			%let returnCodeMacroVariable=job_rc&&etlsHandles&i;
		waitfor &&etlsHandles&i timeout=1;

		%if (&SYSRC eq 0) or (&SYSRC eq -2) %then /* process complete  */

			%do;
				%etls_freeHandle(statusTable=&statusTable, statusVariable=&statusVariable,
					handleVariable=&handleVariable, handleName="&&etlsHandles&i", 
					statusSetting=&completeStatusSetting, endTimeVariable=&endTimeVariable, 
					startTimeVariable=&startTimeVariable, signoff=&signoff, 
					returnCodeVariable=&returnCodeVariable, returnCodeMacroVariable=&returnCodeMacroVariable, 
					statusUnknownReturnCode=&statusUnknownReturnCode, 
					startTimeMacroVariable=etls_startTime_&&etlsHandles&i., 
					endTimeMacroVariable=etls_endTime_&&etlsHandles&i. );
				%put NOTE: Process &&etlsHandles&i. has completed.;
			%end;
			%else %if (&SYSRC ne -1) %then /* process status unknown  */
				%do;
					%etls_freeHandle(statusTable=&statusTable, statusVariable=&statusVariable,
						handleVariable=&handleVariable, handleName="&&etlsHandles&i", 
						statusSetting="Unknown Status", endTimeVariable=&endTimeVariable, 
						startTimeVariable=&startTimeVariable, signoff=&signoff, 
						returnCodeVariable=&returnCodeVariable, returnCodeMacroVariable=&returnCodeMacroVariable, 
						statusUnknownReturnCode=&statusUnknownReturnCode, startTimeMacroVariable=etls_startTime_&&etlsHandles&i );
					%put NOTE: Cannot retrieve status from process &&etlsHandles&i..;
				%end;
	%end;
%mend etls_waitfor;

%macro etls_getProcessesRunning(statusTable=, statusVariable=, processCountMacro=, 
			statusSetting="Running");

	proc sql noprint;
		select count(*) into: &processCountMacro 
			from &statusTable where &statusVariable = &statusSetting;
	quit;

	%rcSet(&sqlrc);
%mend etls_getProcessesRunning;

%macro etls_getParameterNames(parameterTable=, parameterVariableMacro=, startingColumnNumber=1);
	%let &parameterVariableMacro =;
	%let dsid = %sysfunc(open(&parameterTable));

	%if (&dsid gt 0) %then %do;

		%do i=&startingColumnNumber %to %sysfunc(attrn(&dsid,nvars));
			%let &parameterVariableMacro = &&&parameterVariableMacro %sysfunc(varname(&dsid,&i));
		%end;

		%let dsid = %sysfunc(close(&dsid));
	%end;
	%else %put %sysfunc(sysmsg());
	%rcSet(&syserr);
%mend etls_getParameterNames;

%macro etls_getParameters(parameterTable=, row=, startingColumnNumber=1 , handleName=);

	data _null_;
		length vname $256 vtype $1 value $32767;
		dsid = open("&parameterTable");

		if (dsid > 0) then do;

			do _i = 1 to &row;
				fetchrc = fetch(dsid);
			end;

			do _i=&startingColumnNumber to attrn(dsid,'nvars');
				vname = varname(dsid,_i);
				vtype = vartype(dsid,_i);

				if (fetchrc = 0) then do;
					if (vtype = 'C') then do;
						value = getvarc(dsid,_i);
						value = tranwrd(value,"%","%%");
						value = tranwrd(value,"(","%(");
						value = tranwrd(value,")","%)");
						value = tranwrd(value,'"','%"');
						value = tranwrd(value,"'","%'");
					end;
					else value = left(put(getvarn(dsid,_i),best32.));
				end; /* fetchrc = 0 */

				put;

				if kindexc(trimn(value),"+-*/<>=^~;, '()&%",'"')>0 then do;
					value='%nrstr('||ktrim(value)||')';
					put "ETLS_DIAG%QUOTE(:) Special characters encountered; References may require: %nrbquote(%)UNQUOTE(&" vname+(-1)').';
					put "NOTE: Special characters encountered; References may require: %nrbquote(%)UNQUOTE(&" vname+(-1)').';
				end;

				%if %str(&handlename) ne %str() %then %do;
					value = '%syslput '||ktrim(vname)||'= '||ktrim(value)||" / remote = &handleName;";
				%end;
				%else %do;
					value = '%let '||ktrim(vname)||'= '||ktrim(value)||';';
				%end;

				put "NOTE: Setting macro variable " vname "with statement:" value;
				call execute(value);
			end; /* do i= */

			dsid = close(dsid);
		end; /* dsid > 0 */
		else do;
			put "ERROR%QUOTE(:) Parameter table, &parameterTable., could not be"
				" opened.";
			abort;
		end;

		stop;
	run;

	%rcSet(&syserr);
%mend etls_getParameters;


/* endregion */

/*==========================================================================* 
 * Step:            Main 				                                    * 
 *==========================================================================*/
%macro etls_mainloop;
	%local etls_filePrefix;
	%let etls_filePrefix =;

	/* Compability change introduced by 2023.10 */
	options set=SAS_LOCAL_MPCONNECT=true;

	/* 	Local Connect and UseOptimalProcesses=1: we will select an optimal Maximum number of sub-process 
		that is defined in parall_loop_local_numsubprocs defined in autoexec.
	*/
	%if %str(&etls_sasConnectContext) = %str() and &etls_UseOptimalProcesses=1 and %symexist(PARALL_LOOP_LOCAL_NUMSUBPROCS) %then %do;
		%put NOTE: Local Signon configured and use environment maximum is checked. Will use value &parall_loop_local_numsubprocs defined in macrovar: parall_loop_local_numsubprocs;
		%let etls_maxProcesses=&parall_loop_local_numsubprocs;
	%end;

	/* 
	  Generate Flow Code and store in catalog work.codegen.code.source.
	  This will later be uploaded to session and executed
	*/
	filename rmtcode catalog 'work.codegen.code.source' lrecl=32767;
	%generateCodefromFlow(
		flowToCode=&etls_FlowSourcePath,
		outfileref=rmtcode);
	filename rmtcode clear;

	%macro etls_processToLoop(parameterTable=, row=, handleName=rmt);
		%etls_getParameters(parameterTable=&parameterTable, row=&row, 
			startingColumnNumber=1, handleName=&handleName);
		%let etls_previousFilePrefix = &etls_filePrefix;
		%local etls_filePrefix;
		%let etls_filePrefix = &etls_previousFilePrefix.&handleName;
		%let __workdir=%sysfunc(pathname(work));

		%syslput &etls_controlName = &row / remote = &handleName;
		%syslput handleName = &handleName / remote = &handleName;

		%if %symexist(jobID) %then %do;
			%syslput jobID = &jobID / remote = &handlename;
		%end;
		
		%if %symexist(etls_userID) %then %do;
			%syslput etls_userID = &etls_userID / remote = &handlename;
		%end;
		%if %symexist(AUTOEXEC_FILE) %then %do;
			%syslput AUTOEXEC_FILE = &AUTOEXEC_FILE / remote = &handlename;
		%end;
		
		%syslput etls_jobName = &etls_jobName / remote = &handlename;
		%syslput __workdir = &__workdir / remote = &handlename;
		%syslput etls_sasConnectContext = &etls_sasConnectContext / remote = &handlename;

		/* Setup to pass macros to remote session  */
		data _null_;
			rmtname = "/ remote = &handleName";
			call execute('%syslput etls_filePrefix = &etls_filePrefix '||rmtname||';');
			call execute('run;');
		run;

		rsubmit &handleName wait = no sysrputsync = yes persist = no
				%if %str(&etls_logOutputPath) ne %str() %then %do;
					log = "&etls_logOutputPath./&etls_filePrefix..log" 
					output = "&etls_logOutputPath./&etls_filePrefix..lst"
				%end; 
			;
			
			/* Define CASHOST as this is wrongly configured in SAS Connect Sessions */
			options CASHOST='sas-cas-server-default-client';

			/* Upload generated code to this session in catalog work.codegen.code.source */
			proc upload incat=work.codegen outcat=work.codegen;
			run;

			/* Execute an alternative autoexec if specified in &AUTOEXEC_FILE */
			%macro execUserDefinedAutoexec;
				%if %str(%quote(&AUTOEXEC_FILE)) ne %str() %then %do;
					%put NOTE: Will execute user specified autoexec specified in macro variable AUTOEXEC_FILE;
					%inc "&AUTOEXEC_FILE";		
				%end;
				%else %do;
					
				%end;
			%mend execUserDefinedAutoexec;
			%if %symexist(AUTOEXEC_FILE) %then %do;
				%execUserDefinedAutoexec;
			%end;
			

			/* Allocate SWORK: SASWORK of calling SAS-process */
			%if %str(%quote(&etls_sasConnectContext)) = %str() %then %do;
				libname swork "&__workdir";  
			%end;
			
			/* Setup to capture return codes  */
			%macro etls_setClientSideStatus;
				%sysrput job_rc&handleName = &syscc;
				%sysrput etls_endTime_&handleName = %sysfunc(datetime());
			%mend etls_setClientSideStatus;
			%nrstr(%sysrput etls_startTime_&handleName = %sysfunc(datetime()));
			
			/* Submit code */
			filename execcode catalog 'work.codegen.code.source';
			%inc execcode;

			%etls_setClientSideStatus;
			
		endrsubmit;
		
	%mend etls_processToLoop;

	%local    
		etls_processesRunning  
		etls_additionalSignonOptions etls_signonRetries;
	%let etls_gridOptionSet = %nrstr();
	%let etls_workload =;
	%let etls_additionalSignonOptions =;
	%let etls_signonRetries = 3;
	%let etls_gridSuppJobOptions = %nrstr();
	%let &etls_controlName = 0;
	%put %str(NOTE: Creating status table...);

	data &etls_statusTable;
		attrib etls_handleName length = $32
			label = 'Name of handle to remote session';
		attrib etls_machineId length = $32
			label = 'Name of machine executing the task';
		attrib etls_startTime length = 8
			format = nldatmap.
			label = 'Start time of task';
		attrib etls_endTime length = 8
			format = nldatmap.
			label = 'End time of task';
		attrib etls_status length = $32
			label = 'Current status of task';
		attrib etls_jobRC length = 8
			label = 'Return code of task';
		set &etls_controlTable;
	run;

	%rcSet(&syserr);
	%put %str(NOTE: Creating parameter table...);

	proc sql;
		create table &etls_parameterTable as 
			select *
				from &etls_controlTable;
	quit;

	%rcSet(&sqlrc);

	/* Get the number of times to iterate from the number of rows in the source  */
	/*  table                                                                    */
	proc sql noprint;
		select count(*) into :&etls_controlName._max from &etls_statusTable;
		%let &etls_controlName._max = &&&etls_controlName._max;
	quit;

	%rcSet(&sqlrc);

	%if (&etls_maxProcesses > 0) %then %do;

		%do %until (&&&etls_controlName ge &&&etls_controlName._max);
			%let etls_lastLoopPtr = &&&etls_controlName;

			%etls_getProcessesRunning(statusTable=&etls_statusTable, statusVariable=etls_status, 
				processCountMacro=etls_processesRunning, statusSetting="Running");

			%do %while(&etls_processesRunning lt &&&etls_controlName._max 
				and &etls_processesRunning lt &etls_maxProcesses 
				and &&&etls_controlName lt &&&etls_controlName._max);
				%let &etls_controlName = %eval(&&&etls_controlName+1);
				%let etls_signonMacVar = etls_signonStatus&&&etls_controlName;
				%global &etls_signonMacVar;

				%etls_createHandle(statusTable=&etls_statusTable,
					statusVariable=etls_status,
					handleVariable=etls_handleName,
					handlePrefix=&etls_controlName,
					statusSetting="Running",
					row=&&&etls_controlName,
					machineVariable=etls_machineId,
					startTimeVariable=etls_startTime,
					cmacvar=&etls_signonMacVar,
					signon=1,
					useGrid=1,
					additionalSignonOptions=&etls_additionalSignonOptions,
					signonRetries=&etls_signonRetries);
				%etls_getProcessesRunning(statusTable=&etls_statusTable, statusVariable=etls_status, 
					processCountMacro=etls_processesRunning, statusSetting="Running");

				%if &etls_processesRunning > 0 and &&&etls_signonMacVar ne 1 %then
					%etls_processToLoop(parameterTable=&etls_parameterTable, row=&&&etls_controlName,
					handleName=%etls_getHandle(statusTable=&etls_statusTable,
					handleVariable=etls_handleName, row=&&&etls_controlName));
				%else %do;

					/* if signon error, set iterator to max to force loop to stop. */
					%let &etls_controlName = &&&etls_controlName._max;
					%put %str(ERROR%QUOTE(:) A parallel process did not start.  Exiting loop.);
				%end;
			%end;

			%etls_waitFor(statusTable=&etls_statusTable, statusVariable=etls_status, 
				runningStatusSetting="Running", handleVariable=etls_handleName, 
				completeStatusSetting="Finished", endTimeVariable=etls_endTime, 
				startTimeVariable=etls_startTime, waitType=_ANY_, signoff=1, 
				returnCodeVariable=etls_jobRC, 
				statusUnknownReturnCode=.);
		%end;

		%etls_waitFor(statusTable=&etls_statusTable, statusVariable=etls_status, 
			runningStatusSetting="Running", handleVariable=etls_handleName, 
			completeStatusSetting="Finished", endTimeVariable=etls_endTime, 
			startTimeVariable=etls_startTime, waitType=_ALL_, signoff=1, 
			returnCodeVariable=etls_jobRC, 
			statusUnknownReturnCode=.);
	%end;

	/* Delete parameter table */
	proc datasets lib = %scan(&etls_parameterTable,1,.) nolist nowarn memtype = (data view);
		delete %scan(&etls_parameterTable,2,.);
	quit;

	/* Delete generated code */
	proc catalog cat=work.codegen kill;
	quit;

%mend etls_mainloop;

%etls_mainloop;

/* region: Generation of code */
%symdel ETLS_ABORTONERROR /NOWARN;
%symdel ETLS_CONTROLTABLE /NOWARN;
%symdel ETLS_FLOWSOURCEPATH /NOWARN;
%symdel ETLS_JOBNAME /NOWARN;
%symdel ETLS_LOGOUTPUTPATH /NOWARN;
%symdel ETLS_MAXPROCESSES /NOWARN;
%symdel ETLS_PARAMETERTABLE /NOWARN;
%symdel ETLS_SASCONNECTCONTEXT /NOWARN;
%symdel ETLS_STATUSTABLE /NOWARN;
%symdel ETLS_USEOPTIMALPROCESSES /NOWARN;
%symdel ETLS_CONTROLNAME /NOWARN;
%symdel ETLS_STEPSTARTTIME /NOWARN;
%symdel transformID /NOWARN;
%symdel trans_rc /NOWARN;
%symdel job_rc /NOWARN;
%symdel etls_stepStartTime /NOWARN;
/* endregion */
