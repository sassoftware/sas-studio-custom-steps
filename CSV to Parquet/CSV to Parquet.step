{"name": "CSV to Parquet.step", "creationTimeStamp": "2026-11-23T20:10:32.790693Z", "modifiedTimeStamp": "2026-11-23T20:10:32.790693Z", "createdBy": "Sundaresh.Sankaran@sas.com", "modifiedBy": "Sundaresh.Sankaran@sas.com", "displayName": "CSV to Parquet.step", "localDisplayName": "CSV to Parquet.step", "properties": null, "links": [{"method": "GET", "rel": "self", "href": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "uri": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "type": "application/vnd.sas.data.flow.step"}, {"method": "GET", "rel": "alternate", "href": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "uri": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "type": "application/vnd.sas.data.flow.step.summary"}, {"method": "GET", "rel": "up", "href": "/dataFlows/steps", "uri": "/dataFlows/steps", "type": "application/vnd.sas.collection", "itemType": "application/vnd.sas.data.flow.step.summary"}, {"method": "PUT", "rel": "update", "href": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "uri": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "type": "application/vnd.sas.data.flow.step", "responseType": "application/vnd.sas.data.flow.step"}, {"method": "DELETE", "rel": "delete", "href": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "uri": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b"}, {"method": "POST", "rel": "copy", "href": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b/copy", "uri": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b/copy", "responseType": "application/vnd.sas.data.flow.step"}, {"method": "GET", "rel": "transferExport", "href": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "uri": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "responseType": "application/vnd.sas.transfer.object"}, {"method": "PUT", "rel": "transferImportUpdate", "href": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "uri": "/dataFlows/steps/8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "type": "application/vnd.sas.transfer.object", "responseType": "application/vnd.sas.summary"}], "metadataVersion": 1, "version": 2, "type": "code", "flowMetadata": {}, "ui": "{\"showPageContentOnly\": true, \"pages\": [{\"id\": \"params\", \"type\": \"page\", \"label\": \"CSV to Parquet (powered by DuckDB)\", \"children\": [{\"id\": \"section_input\", \"type\": \"section\", \"label\": \"Input Parameters\", \"open\": true, \"visible\": \"\", \"children\": [{\"id\": \"input_file_location\", \"type\": \"radiogroup\", \"label\": \"Select location of input file(s):\", \"items\": [{\"value\": \"folder\", \"label\": \"A folder on the SAS Server file system.\"}, {\"value\": \"s3\", \"label\": \"An AWS S3 bucket\"}, {\"value\": \"web\", \"label\": \"A publicly accessible website\"}], \"visible\": \"\"}, {\"id\": \"section_input_folder\", \"type\": \"section\", \"label\": \"SAS Server Folder\", \"open\": true, \"visible\": [\"$input_file_location\", \"=\", \"folder\"], \"enabled\": [\"$input_file_location\", \"=\", \"folder\"], \"children\": [{\"id\": \"csv_folder_path\", \"type\": \"path\", \"label\": \"Source folder containing CSVs (please select folder on SAS Server and not SAS Content):\", \"pathtype\": \"folder\", \"required\": false, \"placeholder\": \"/path/to/source.csv\"}]}, {\"id\": \"section_input_s3\", \"type\": \"section\", \"label\": \"S3 Bucket\", \"open\": true, \"visible\": [\"$input_file_location\", \"=\", \"s3\"], \"enabled\": [\"$input_file_location\", \"=\", \"s3\"], \"children\": [{\"id\": \"s3_text_keys\", \"type\": \"text\", \"text\": \"If you're selecting an S3 folder, please ensure the following credentials (at a minimum) to the S3 bucket are set upstream as environmental variables in advance:\\n\\n- AWS_ACCESS_KEY_ID\\n- AWS_SECRET_ACCESS_KEY\\n\\n\", \"visible\": \"\"}, {\"id\": \"s3_path\", \"type\": \"textfield\", \"label\": \"S3 bucket folder URI (for multiple files,include the full s3:// path until the folder level and specify the file pattern below):\", \"required\": false, \"placeholder\": \"s3://some_random_bucket\", \"visible\": \"\"}, {\"id\": \"s3_aws_region\", \"type\": \"textfield\", \"label\": \"AWS region (e.g. us-east-1):\", \"required\": false, \"placeholder\": \"us-east-1\", \"visible\": \"\"}]}, {\"id\": \"section_website\", \"type\": \"section\", \"label\": \"Website\", \"open\": true, \"visible\": [\"$input_file_location\", \"=\", \"web\"], \"enabled\": [\"$input_file_location\", \"=\", \"web\"], \"children\": [{\"id\": \"url_path\", \"type\": \"textfield\", \"label\": \"URL of website (include full path to a single (wildcard patterns not supported)CSV):\", \"required\": false, \"placeholder\": \"https://some_path_to/a.csv\", \"visible\": \"\"}]}, {\"id\": \"csv_file_pattern\", \"type\": \"textfield\", \"label\": \"Input csv pattern (use wildcards if needed)\", \"placeholder\": \"*.csv\", \"required\": false, \"visible\": [\"$url_path\", \"=\", \"\"], \"enabled\": [\"$url_path\", \"=\", \"\"]}]}, {\"id\": \"has_headers\", \"type\": \"checkbox\", \"label\": \"CSV first line has headers\", \"visible\": \"\"}, {\"id\": \"section_output\", \"type\": \"section\", \"label\": \"Output Specification\", \"open\": true, \"children\": [{\"id\": \"parquet_output_path\", \"type\": \"path\", \"label\": \"Output folder path (please select file on SAS Server and not SAS Content):\", \"pathtype\": \"folder\", \"required\": true, \"placeholder\": \"/path/to/output/directory/\"}, {\"id\": \"parquet_file_name\", \"type\": \"textfield\", \"label\": \"Output Parquet file name (No need to provide the .parquet extension):\", \"required\": true, \"placeholder\": \"output_data\"}, {\"id\": \"ignore_errors\", \"type\": \"checkbox\", \"label\": \"Ignore errors\", \"visible\": \"\"}, {\"id\": \"union_by_name\", \"type\": \"checkbox\", \"label\": \"Combine multiple schemas by column name (union_by_name)\", \"visible\": \"\"}, {\"id\": \"section_rejects\", \"type\": \"section\", \"label\": \"Rejects\", \"open\": true, \"visible\": \"!$union_by_name\", \"enabled\": \"!$union_by_name\", \"children\": [{\"id\": \"save_rejects\", \"type\": \"checkbox\", \"label\": \"Save rejects (rejects are saved to Parquet files in the same output directory)\", \"visible\": \"!$union_by_name\", \"enabled\": \"!$union_by_name\"}, {\"id\": \"rejects_data_table\", \"type\": \"textfield\", \"label\": \"Specify rejects data file name:\", \"placeholder\": \"_rejects\", \"required\": false, \"visible\": \"$save_rejects\", \"enabled\": \"$save_rejects\"}, {\"id\": \"rejects_scan_table\", \"type\": \"textfield\", \"label\": \"Specify rejects scan file name:\", \"placeholder\": \"_rejects_scan\", \"required\": false, \"visible\": \"$save_rejects\", \"enabled\": \"$save_rejects\"}]}]}]}, {\"id\": \"about\", \"type\": \"page\", \"label\": \"About\", \"children\": [{\"id\": \"section_about_intro\", \"type\": \"section\", \"label\": \"CSV to Parquet\", \"open\": true, \"visible\": \"\", \"children\": [{\"id\": \"section_about_intro_text\", \"type\": \"text\", \"text\": \"\\u201cCSV to Parquet\\u201d is one of the most common conversion paths in modern data engineering pipelines.\\n\\nThis custom step utilizes SAS/ACCESS Interface to DuckDB to ingest a source CSV file and convert it into an optimized Parquet file. \\n\\nOpen file formats such as Parquet offer benefits of reduced data footprint and columnar structure. DuckDB is a popular and performant query processing engine that efficiently handles data ingestion and format conversion.\", \"visible\": \"\"}, {\"id\": \"section_features\", \"type\": \"section\", \"label\": \"Features\", \"open\": true, \"visible\": \"\", \"children\": [{\"id\": \"text_features\", \"type\": \"text\", \"text\": \"1. Ingest CSV with or without headers.\\n2. Ingest CSV from 3 source areas: SAS Server, S3 buckets and URLs\\n3. Save to Parquet on file system.\\n4. Save rejected records for downstream exception code if needed.\\n5. Unify multiple schemas if required\", \"visible\": \"\"}]}, {\"id\": \"section_about_parameters\", \"type\": \"section\", \"label\": \"Parameters\", \"open\": false, \"visible\": \"\", \"children\": [{\"id\": \"section_about_parameters_input\", \"type\": \"section\", \"label\": \"Input Parameters\", \"open\": true, \"children\": [{\"id\": \"section_about_parameters_input_text\", \"type\": \"text\", \"text\": \"1. Location of input files (radio button group, default folder): Select where your source input files are located.\\n\\nFolder options:\\n===========\\n\\n2. Source CSV file path (folder selector, required): select the folder containing source CSV files located on the SAS server (filesystem). Note: please select a folder on the SAS Server and not SAS Content.\\n\\nS3 Bucket Options:\\n===============\\n\\n3. S3 Bucket folder path (text field): Specify the S3 bucket where your CSV files are located.  If ingesting multiple files, specify only till the folder level, i.e. excluding the filename pattern and extension.  If you choose to include the filename pattern, ensure that the CSV filename pattern field is blank.\\n\\n4. S3 region (text field, default us-east-1): Specify the AWS region.\\n\\nImportant - check the following prerequisites for S3\\n\\n\\n- Ensure you have set the following environmental variables to hold S3 bucket credentials.  These are identified by \\n  the credential_chain provider in DuckDB automatically.  At a minimum,\\n  - AWS_ACCESS_KEY_ID\\n  - AWS_SECRET_ACCESS_KEY\\n  and if you're using short-term tokens for the session, \\n  - AWS_SESSION_TOKEN\\n\\n  (A standard way is to set options through option set=VAR=VALUE; SAS statements)\\n\\nURL (file hosted on the web) options:\\n============================\\n\\n5. URL path (text field): Provide the full path to a single CSV file on the web.  Do not include a glob (*) pattern. The CSV file pattern field is automatically hidden when you use this option.\\n\\n----\\n\\n6. File pattern (text field, default *.csv): A glob pattern which may include wildcards describing source CSV files\\n\\n7. CSV first line has headers (checkbox, optional): indicate whether the first row of the CSV file contains column headers. Enabled by default.\\n\\n\\n\\n\", \"visible\": \"\"}]}, {\"id\": \"section_about_parameters_output\", \"type\": \"section\", \"label\": \"Output specification\", \"open\": true, \"visible\": \"\", \"children\": [{\"id\": \"section_about_parameters_output_text\", \"type\": \"text\", \"text\": \"1. Output folder path (folder selector, required): select the destination folder location on the SAS server (filesystem) where the output Parquet file will be stored. Note: please select folders on the SAS Server and not SAS Content.\\n\\n2. Output Parquet file name (text field, required): specify the name or prefix for the output Parquet file (no need to provide the .parquet extension).\\n\\n3. Save Rejects (checkbox, default checked): Whether to save rejected records to a Parquet file in the same output directory or not.\\n\\n4. Rejects table name (visible if Save Rejects selected): Specify name for the reject records table.\\n\\n5. Rejects scan table name (visible if Save Rejects selected): Specify name for reject scan table holding metadata about rejects.\\n\\n6. Ignore Errors (checkbox, default false): skip rows that cause parsing or casting errors\\n\\n7. Combine multiple file schemas (checkbox, default false): whether to combine multiple schemas based on column names - this corresponds to union_by_name in the DuckDB read_csv() function.\", \"visible\": \"\"}]}]}, {\"id\": \"section_references\", \"type\": \"section\", \"label\": \"References\", \"open\": false, \"children\": [{\"id\": \"references_text\", \"type\": \"text\", \"text\": \"1. Writing Parquet files using DuckDB: https://duckdb.org/docs/2.0/data/parquet/overview\\n\\n2. Reading CSV using DuckDB: https://duckdb.org/docs/2.0/guides/file_formats/csv_import\\n\\n3. SAS/Access Interface to DuckDB: https://go.documentation.sas.com/doc/en/pgmsascdc/v_080/acreldb/p1fekl0cwbnzcmn1026kzjequme4.htm\\n\"}]}, {\"id\": \"section_about_version\", \"type\": \"section\", \"label\": \"About this step\", \"open\": true, \"children\": [{\"id\": \"version_text\", \"type\": \"text\", \"text\": \"Version: 1.0.0 (23NOV2026)\\nContact: Sundaresh Sankaran (Sundaresh.Sankaran@sas.com)\"}]}]}]}], \"syntaxversion\": \"1.3.0\", \"values\": {\"input_file_location\": {\"value\": \"folder\", \"label\": \"It's located in a folder on the SAS Server file system.\"}, \"csv_folder_path\": \"\", \"csv_file_pattern\": \"*.csv\", \"has_headers\": true, \"parquet_output_path\": \"\", \"parquet_file_name\": \"\", \"ignore_errors\": false, \"union_by_name\": false, \"save_rejects\": true, \"rejects_data_table\": \"_rejects\", \"rejects_scan_table\": \"_rejects_scan\"}}", "templates": {"SAS": "/************************************************************************\nDuckDB - CSV to Parquet Conversion\n\nPurpose: This SAS program utilizes SAS/ACCESS Interface to DuckDB to ingest a CSV file \n         and convert it into a Parquet file.\nInput Parameters:\n- input_file_location: Option (folder,s3,web) indicating where the input CSV file(s) are located (macro variable)\n- csv_folder_path: if input_file_location is \"folder\", full path to the folder containing source CSV files (macro variable)\n- csv_file_pattern: A glob pattern which may include wildcards describing source CSV files (macro variable)\n- s3_path: If input_file_location is \"s3\", full path to the S3 bucket containing source CSV files (macro variable)\n- url_path: If input_file_location is \"web\", full URL path to the source CSV file (macro variable)\n- has_headers: Boolean (TRUE/FALSE) indicating if the CSV has a header row (macro variable)\n\nPrerequisites for S3 ingestion:\n- Ensure you have set the following environmental variables to hold S3 bucket credentials.  These are identified by \n  the credential_chain provider in DuckDB automatically.  At a minimum,\n  - AWS_ACCESS_KEY_ID\n  - AWS_SECRET_ACCESS_KEY\n  and if you're using short-term tokens for the session, \n  - AWS_SESSION_TOKEN\n\n  (A standard way is to set options through option set=VAR=VALUE; SAS statements)\n\nOutput specification:\n- parquet_output_path: Folder location for the output Parquet file (macro variable)\n- parquet_file_name: Name/prefix for the output Parquet file (macro variable)\n- save_rejects: Whether to save rejects or not (macro variable)\n- ignore_errors: Whether to skip rows that cause parsing or casting errors (macro variable)\n- union_by_name: Whether to combine multiple schemas based on column names (default false) (macro variable)\nIf you do choose to save rejects,\n- rejects_data_table: Table containing rejected record details at a line and scan level\n- rejects_scan_table: Table containing metadata about the rejected records.\n\nCreated: Sundaresh Sankaran\nVersion: 1.0.0 (23NOV2026)\n************************************************************************/;\n\n/* -----------------------------------------------------------------------------------------*\n   Set parameter values (edit below block only if testing)\n\n   to test the program, edit the macro variables below to point to your specfied values.\n   For example, if you wish to specify a folder on the SAS Server, set input_file_location to folder\n   and provide the csv_folder_path and csv_file_pattern accordingly.\n\n   %let input_file_location = folder;  \n\n   and in the dependent_macrovars_setting macro, \n   %let csv_folder_path=sasserver:/your_foldder_path \n   %let csv_file_pattern=an_example.csv;\n*------------------------------------------------------------------------------------------*/\n\n\n/* Define macro variables (including nested in macros wherre necessary) for input parameters */\n\n%let input_file_location = &input_file_location.;  /* e.g., 'folder', 's3', 'web' */\n\n%macro dependent_macrovars_setting;\n    %if \"&input_file_location.\"=\"folder\" %then %do;\n        %let csv_folder_path = &csv_folder_path.;                /* e.g., '/data/' */\n        %let csv_file_pattern = &csv_file_pattern.;              /* e.g., 'input.csv' / '*.csv' */\n    %end;\n    %else %if \"&input_file_location.\"=\"s3\" %then %do;\n        %let s3_path = &s3_path.;      \n        %let csv_file_pattern = &csv_file_pattern.;               /* e.g., 's3://bucket-name/path/' */\n    %end;\n    %else %if \"&input_file_location.\"=\"web\" %then %do;\n        %let url_path = &url_path.;                              /* e.g., 'https://example.com/data/input.csv' */\n    %end;\n    %else %do;\n        %put ERROR: Invalid input_file_location specified. Please choose 'folder', 's3', or 'web'.;\n    %end;\n%mend dependent_macrovars_setting;\n\n%dependent_macrovars_setting;\n\n%let has_headers = &has_headers.;                    /* TRUE or FALSE */\n%let parquet_output_path = &parquet_output_path.;    /* e.g., '/data/output/' */\n%let parquet_file_name = &parquet_file_name. ;       /* e.g., 'output_data WITHOUT the .parquet' */\n%let ignore_errors = &ignore_errors.;                  /* TRUE or FALSE */;\n%let union_by_name = &union_by_name.;                  /* TRUE or FALSE */;\n\n%macro set_union_rejects_relationship;\n    %if \"&union_by_name.\"=\"0\" %then %do;\n        %let save_rejects = &save_rejects.;                  /* TRUE or FALSE */;\n        %if \"&save_rejects.\"=\"1\" %then %do;\n            %let rejects_data_table=&rejects_data_table.;\n            %let rejects_scan_table=&rejects_scan_table.;\n            %put NOTE: The Rejects table is &rejects_data_table.;\n            %put NOTE: The Rejects table is &rejects_scan_table.;\n        %end;\n    %end;\n%mend set_union_rejects_relationship;\n\n%set_union_rejects_relationship;\n\n\n\n/* -----------------------------------------------------------------------------------------*\n   Macros\n\n   The macros below follow the structural conventions used in prior custom steps by author:\n\n   - small utility macros for runtime triggers and error flags\n   - a focused macro to build SQL strings and one to execute the Duck DB query\n*------------------------------------------------------------------------------------------*/\n\n/* -------------------------------------------------------------------------------------------* \n   Macro to initialize a run-time trigger global macro variable to run SAS Studio Custom Steps. \n   A value of 1 (the default) enables this custom step to run.  A value of 0 (provided by \n   upstream code) sets this to disabled.\n\n   Input:\n   1. triggerName: The name of the runtime trigger you wish to create. Ensure you provide a \n      unique value to this parameter since it will be declared as a global variable.\n\n   Output:\n   2. &triggerName : A global variable which takes the name provided to triggerName.\n*-------------------------------------------------------------------------------------------- */\n\n%macro _create_runtime_trigger(triggerName);\n   %global &triggerName.;\n   %if %sysevalf(%superq(&triggerName.)=, boolean)  %then %do;\n      %put NOTE: Trigger macro variable &triggerName. does not exist. Creating it now.;\n      %let &triggerName.=1;\n   %end;\n%mend _create_runtime_trigger;\n\n\n/* -----------------------------------------------------------------------------------------* \n   Macro to create an error flag for capture during code execution.\n\n   Input:\n      1. errorFlagName: The name of the error flag you wish to create. Ensure you provide a \n         unique value to this parameter since it will be declared as a global variable.\n      2. errorFlagDesc: A description to add to the error flag.\n\n    Output:\n      1. &errorFlagName : A global variable which takes the name provided to errorFlagName.\n      2. &errorFlagDesc : A global variable which takes the name provided to errorFlagDesc.\n*------------------------------------------------------------------------------------------ */\n\n%macro _create_error_flag(errorFlagName, errorFlagDesc);\n\n   %global &errorFlagName.;\n   %let &errorFlagName.=0;\n   %global &errorFlagDesc.;\n\n%mend _create_error_flag;\n\n\n/* -----------------------------------------------------------------------------------------* \n   Macro to identify whether a given folder location provided from a \n   SAS Studio Custom Step folder selector happens to be a SAS Content folder\n   or a folder on the filesystem (SAS Server).\n\n   Input:\n   1. pathReference: A path reference provided by the file or folder selector control in \n      a SAS Studio Custom step.\n\n   Output:\n   1. _path_identifier: Set inside macro, a global variable indicating the prefix of the \n      path provided.\n\n   Also available at: https://raw.githubusercontent.com/SundareshSankaran/sas_utility_programs/main/code/Identify%20SAS%20Content%20or%20Server/macro_identify_sas_content_server.sas\n\n*------------------------------------------------------------------------------------------ */\n\n%macro _identify_content_or_server(pathReference);\n   %global _path_identifier;\n   data _null_;\n      call symput(\"_path_identifier\", scan(%str(&pathReference.),1,\":\",\"MO\"));\n   run;\n   %put NOTE: _path_identifier is &_path_identifier. ;\n%mend _identify_content_or_server;\n\n/* -----------------------------------------------------------------------------------------* \n   Macro to extract the path provided from a SAS Studio Custom Step file or folder selector.\n\n   Input:\n   1. pathReference: A path reference provided by the file or folder selector control in \n      a SAS Studio Custom step.\n\n   Output:\n   1. _sas_folder_path: Set inside macro, a global variable containing the path.\n\n   Also available at: https://raw.githubusercontent.com/SundareshSankaran/sas_utility_programs/main/code/Extract%20SAS%20Folder%20Path/macro_extract_sas_folder_path.sas\n\n*------------------------------------------------------------------------------------------ */\n\n%macro _extract_sas_folder_path(pathReference);\n\n   %global _sas_folder_path;\n\n   data _null_;\n      call symput(\"_sas_folder_path\", scan(%str(&pathReference.),2,\":\",\"MO\"));\n   run;\n\n%mend _extract_sas_folder_path;\n\n/* -----------------------------------------------------------------------------------------* \n  EXECUTION Macro: _dcp_execution_macro\n  Purpose: Extract metadata and write to output table.\n   Behavior: Connects to DuckDB, extracts metadata, creates output table.\n*------------------------------------------------------------------------------------------ */\n\n%macro _dcp_execution_macro;\n    \n\n    %if \"&save_rejects.\"=\"1\" %then %do;\n\n        %let rejects_data_table=&rejects_data_table.;\n        %let rejects_scan_table=&rejects_scan_table.;\n        %put NOTE: The Rejects table is &rejects_data_table.;\n        %put NOTE: The Rejects table is &rejects_scan_table.;\n        \n    %end;\n\n\n   %put NOTE: Step 1 - Assign in-memory DuckDB libname.;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n      libname dukonce duckdb database=\":memory::mydb\";;\n   %end;\n\n   %put NOTE: Step 2 - Additional settings based on input file location.;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n   \n      %if \"&input_file_location.\"=\"folder\" %then %do;\n         %put NOTE: Input file location is a folder on the SAS Server.;\n         %put NOTE: Step 2.1.1 - Identify if input folder reference is on Server or Content.;\n         %_identify_content_or_server(\"&csv_folder_path.\");\n\n         %if \"&_path_identifier.\"=\"sasserver\" %then %do;\n            %put NOTE: Folder location prefixed with &_path_identifier. is on the SAS Server.;\n         %end;\n\n         %else %do;\n\n            %let _duckdb_error_flag=1;\n            %put ERROR: Please select a valid folder on the SAS Server (filesystem). ;\n            data _null_;\n               call symputx(\"_duckdb_error_desc\", \"&_duckdb_error_desc. <-> Please select a valid file on the SAS Server (filesystem).\");\n            run;\n         \n         %end;\n         \n         %put NOTE: Step 2.1.2 - Extract the path from the csv_folder_path macro variable.;\n         %if &_duckdb_error_flag. = 0 %then %do;\n\n            %_extract_sas_folder_path(\"&csv_folder_path.\");\n\n            %if \"&_sas_folder_path.\" = \"\" %then %do;\n\n               %let _duckdb_error_flag = 1;\n               %let _duckdb_error_desc = &_duckdb_error_desc. <-> The field is empty, please select a valid path  ;\n               %put ERROR: &_duckdb_error_desc. ;\n\n            %end;\n            %else %do;\n               %let file_path=&_sas_folder_path.;\n               %put NOTE: Extracted file path is &file_path.;\n            %end;\n\n         %end;\n      %end;\n\n      %else %if \"&input_file_location.\"=\"s3\" %then %do;\n         %put NOTE: Input file location is an S3 bucket.;\n         %put NOTE: Step 2.2.1 - Load credentials  FOR S3 environment.;\n         %put NOTE: AWS region is &s3_aws_region.;\n         proc sql;\n            connect using dukonce;\n            execute(\n               INSTALL httpfs;\n               LOAD httpfs;\n               INSTALL aws;\n               LOAD aws;\n\n\n               CREATE OR REPLACE SECRET s3_read (\n                  TYPE s3,\n                  PROVIDER credential_chain,\n                  CHAIN 'env;config',\n                  REGION \"&s3_aws_region.\"\n               );\n\n            ) by dukonce;\n            disconnect from dukonce;\n         quit;\n         %let file_path=&s3_path.;\n         %put NOTE: Extracted file path is &file_path.;\n\n      %end;\n\n      %else %if \"&input_file_location.\"=\"web\" %then %do;\n         %put NOTE: Input file location is a web URL.;\n         %put NOTE: Step 2.3.1 - Load extensions to readd from http file systems.;\n         proc sql;\n            connect using dukonce;\n            execute(\n               INSTALL httpfs;\n               LOAD httpfs;\n            ) by dukonce;\n            disconnect from dukonce;\n         quit;\n      %end;\n\n      %else %do;\n         %let _duckdb_error_flag=1;\n         %put ERROR: Please select a valid input file location (folder, s3, or web). ;\n         data _null_;\n            call symputx(\"_duckdb_error_desc\", \"&_duckdb_error_desc. <-> Please select a valid input file location (folder, s3, or web).\");\n         run;\n      \n      %end;\n   %end;\n\n\n\n\n   %put NOTE: Step 3 -  Check if parquet_output_path is on Server or Content;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n      %_identify_content_or_server(\"&parquet_output_path.\");\n\n      %if \"&_path_identifier.\"=\"sasserver\" %then %do;\n         %put NOTE: Folder location prefixed with &_path_identifier. is on the SAS Server.;\n      %end;\n\n      %else %do;\n\n         %let _duckdb_error_flag=1;\n         %put ERROR: Please select a valid location on the SAS Server (filesystem). ;\n         data _null_;\n            call symputx(\"_duckdb_error_desc\", \"&_duckdb_error_desc. <-> Please select a valid file on the SAS Server (filesystem).\");\n         run;\n      \n      %end;\n\n   %end;\n\n   %put NOTE: Step 4 - Extract the path from the parquet_output_path macro variable.;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n\n      %_extract_sas_folder_path(\"&parquet_output_path.\");\n\n      %if \"&_sas_folder_path.\" = \"\" %then %do;\n\n         %let _duckdb_error_flag = 1;\n         %let _duckdb_error_desc = &_duckdb_error_desc. <-> The field is empty, please select a valid path  ;\n         %put ERROR: &_duckdb_error_desc. ;\n\n      %end;\n      %else %do;\n         %let parquet_file_path=&_sas_folder_path.;\n         %put NOTE: Extracted file path is &parquet_file_path.;\n      %end;\n   %end;\n\n   %put NOTE: Step 5 - Construct input file path based on parameters provided;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n      %let slash=%str(/);\n      %if \"&input_file_location.\"=\"folder\" %then %do;\n         %if \"&csv_file_pattern.\" = \"\" %then %do;\n            %let csv_file_pattern = %str(*.csv);\n         %end;\n      %end;\n      %if \"&input_file_location.\"=\"s3\" %then %do;\n         %if \"&csv_file_pattern.\" = \"\" %then %do;\n            %let csv_file_pattern = %str(*.csv);\n         %end;\n         %let htap = %sysfunc(reverse(&s3_path.));\n         /* Adjust the S3 path to remove a trailing slash */;\n         %if \"%substr(&htap.,1,1)\"=\"/\" %then %do;\n            %let s3_path=%substr(&s3_path.,1,%length(&s3_path.)-1);\n            %let htap=%sysfunc(reverse(&s3_path.));\n            %put NOTE: The trailing slash in the S3 path has been removed to facilitate proper path formation.;\n         %end;\n         %let possible_extension = %sysfunc(scan(\"&htap.\",1,\".\"));\n         %put %length(&possible_extension.);\n         %put %length(&htap.);\n         %if %length(&possible_extension.) = %length(&htap.) %then %do;\n            /* kept blank for a do-nothing, but can change later*/;\n         %end;\n         %else %do;\n         /* This condition is a strong (but not comprehensive) indication of an extension used in the file path */;\n            %let slash=;\n            %let csv_file_pattern=;\n            %put NOTE: The CSV file pattern and artificial trailing forward slash have been removed due to a strong indication of an extension used in the file path.;\n         %end;\n\n         %let file_path=&s3_path.;\n      %end;\n      \n      %if \"&input_file_location.\"=\"web\" %then %do;\n         %let slash=;\n         %let csv_file_pattern=;\n         %let file_path=&url_path.;\n      %end;\n\n   %end;\n\n\n   %put NOTE: Step 6 - Extract and Load.;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n        %put NOTE: Executing DuckDB-based ELT...;\n        /* Connect to DuckDB */\n        proc sql;\n            connect using dukonce;\n            \n            execute(\n                /* \n                Using DuckDB's read_csv_auto and COPY command to export to Parquet.\n                header=&has_headers handles the column detection.\n                */\n                COPY (\n                    SELECT * FROM read_csv_auto(\"&file_path.&slash.&csv_file_pattern.\", \n                                                %if \"&ignore_errors.\"=\"1\" %then %do;\n                                                    ignore_errors=&ignore_errors.::BOOLEAN,\n                                                %end;\n                                                header=&has_headers.::BOOLEAN, \n                                                union_by_name=&union_by_name.::BOOLEAN\n                                                %if \"&union_by_name.\"=\"0\" %then %do;\n                                                    , store_rejects=&save_rejects.::BOOLEAN \n                                                %end;\n                                                )\n                ) TO \"&parquet_file_path./&parquet_file_name..parquet\" \n                (FORMAT PARQUET, OVERWRITE TRUE);\n\n                %if \"&union_by_name.\"=\"0\" %then %do;    \n                    %if \"&save_rejects.\"=\"1\" %then %do;\n                        COPY reject_errors TO \"&parquet_file_path./&rejects_data_table..parquet\"  (FORMAT PARQUET, OVERWRITE TRUE);\n                        COPY reject_scans TO \"&parquet_file_path./&rejects_scan_table..parquet\"  (FORMAT PARQUET, OVERWRITE TRUE);\n                    %end;\n                %end;\n\n            ) by dukonce;\n\n            disconnect from dukonce;\n        quit;\n   %end;\n   %else %do;\n        %let _duckdb_error_desc = &_duckdb_error_desc. <-> Cannot execute DuckDB ELT query; \n        %put ERROR: &_duckdb_error_desc.;\n        %put NOTE: &_duckdb_error_flag.;\n   %end;\n\n   \n\n%mend _dcp_execution_macro;\n\n\n/************************************************************************\nEXECUTION CODE\n************************************************************************/;\n\n\n%put NOTE: Starting DuckDB-controlled ELT ...;\n%_create_error_flag(_duckdb_error_flag, _duckdb_error_desc);\n\n%put NOTE: Step 0 - 0.1 - Error Flag & Desc variable created.;\n\n%_create_runtime_trigger(_duckdb_run_trigger);\n\n%put NOTE: Step 0 - 0.2 - Runtime trigger value is &_duckdb_run_trigger.;\n\n%if &_duckdb_run_trigger. = 1 %then %do;\n   %_dcp_execution_macro;\n%end;\n\n%if &_duckdb_run_trigger. = 0 %then %do;\n   %put NOTE: This step has been disabled. Nothing to do.;\n%end;\n\n%if &_duckdb_error_flag. = 1 %then %do;\n   %put ERROR: DuckDB ELT program ended with errors. Description: &_duckdb_error_desc.;\n%end;\n\n/* ----------------------------------------------------------------------------------* \n    Cleanup \n*------------------------------------------------------------------------------------------ */\n%put NOTE: Step CLEANUP - CLEANUP.1 - Clean up global macro variables created during execution;\n\n%if %symexist(_SAS_FOLDER_PATH) %then %do;\n   %symdel _SAS_FOLDER_PATH;\n%end;\n\n%if %symexist(_PATH_IDENTIFIER) %then %do;\n   %symdel _PATH_IDENTIFIER;\n%end;\n\n\n%if %symexist(_duckdb_run_trigger) %then %do;\n   %symdel _duckdb_run_trigger;\n%end;\n\n%if %symexist(_duckdb_run_trigger) %then %do;\n   %symdel _duckdb_run_trigger;\n%end;\n\n%if %symexist(_duckdb_run_trigger) %then %do;\n   %symdel _duckdb_run_trigger;\n%end;\n\n%if %symexist(_duckdb_error_flag) %then %do;\n   %symdel _duckdb_error_flag;\n%end;\n\n%if %symexist(_duckdb_error_desc) %then %do;\n   %symdel _duckdb_error_desc;\n%end;\n\n\n/* Remove helper macros from global symbol table */\n%put NOTE: Step CLEANUP - CLEANUP.2 - Delete helper macros from global symbol table.;\n\n%sysmacdelete _create_runtime_trigger;\n%sysmacdelete _create_error_flag;\n%sysmacdelete _identify_content_or_server;\n%sysmacdelete _dcp_execution_macro;\n%sysmacdelete _extract_sas_folder_path;\n\n%put NOTE: CSV to Parquet step completed.;\n"}, "id": "8cf39ddb-4701-4c91-bd87-b0ad983ba75b", "localUi": "{\"pages\":[{\"children\":[{\"children\":[{\"id\":\"input_file_location\",\"items\":[{\"label\":\"A folder on the SAS Server file system.\",\"value\":\"folder\"},{\"label\":\"An AWS S3 bucket\",\"value\":\"s3\"},{\"label\":\"A publicly accessible website\",\"value\":\"web\"}],\"label\":\"Select location of input file(s):\",\"type\":\"radiogroup\",\"visible\":\"\"},{\"children\":[{\"id\":\"csv_folder_path\",\"label\":\"Source folder containing CSVs (please select folder on SAS Server and not SAS Content):\",\"pathtype\":\"folder\",\"placeholder\":\"/path/to/source.csv\",\"required\":false,\"type\":\"path\"}],\"enabled\":[\"$input_file_location\",\"=\",\"folder\"],\"id\":\"section_input_folder\",\"label\":\"SAS Server Folder\",\"open\":true,\"type\":\"section\",\"visible\":[\"$input_file_location\",\"=\",\"folder\"]},{\"children\":[{\"id\":\"s3_text_keys\",\"text\":\"If you're selecting an S3 folder, please ensure the following credentials (at a minimum) to the S3 bucket are set upstream as environmental variables in advance:\\n\\n- AWS_ACCESS_KEY_ID\\n- AWS_SECRET_ACCESS_KEY\\n\\n\",\"type\":\"text\",\"visible\":\"\"},{\"id\":\"s3_path\",\"label\":\"S3 bucket folder URI (for multiple files,include the full s3:// path until the folder level and specify the file pattern below):\",\"placeholder\":\"s3://some_random_bucket\",\"required\":false,\"type\":\"textfield\",\"visible\":\"\"},{\"id\":\"s3_aws_region\",\"label\":\"AWS region (e.g. us-east-1):\",\"placeholder\":\"us-east-1\",\"required\":false,\"type\":\"textfield\",\"visible\":\"\"}],\"enabled\":[\"$input_file_location\",\"=\",\"s3\"],\"id\":\"section_input_s3\",\"label\":\"S3 Bucket\",\"open\":true,\"type\":\"section\",\"visible\":[\"$input_file_location\",\"=\",\"s3\"]},{\"children\":[{\"id\":\"url_path\",\"label\":\"URL of website (include full path to a single (wildcard patterns not supported)CSV):\",\"placeholder\":\"https://some_path_to/a.csv\",\"required\":false,\"type\":\"textfield\",\"visible\":\"\"}],\"enabled\":[\"$input_file_location\",\"=\",\"web\"],\"id\":\"section_website\",\"label\":\"Website\",\"open\":true,\"type\":\"section\",\"visible\":[\"$input_file_location\",\"=\",\"web\"]},{\"enabled\":[\"$url_path\",\"=\",\"\"],\"id\":\"csv_file_pattern\",\"label\":\"Input csv pattern (use wildcards if needed)\",\"placeholder\":\"*.csv\",\"required\":false,\"type\":\"textfield\",\"visible\":[\"$url_path\",\"=\",\"\"]}],\"id\":\"section_input\",\"label\":\"Input Parameters\",\"open\":true,\"type\":\"section\",\"visible\":\"\"},{\"id\":\"has_headers\",\"label\":\"CSV first line has headers\",\"type\":\"checkbox\",\"visible\":\"\"},{\"children\":[{\"id\":\"parquet_output_path\",\"label\":\"Output folder path (please select file on SAS Server and not SAS Content):\",\"pathtype\":\"folder\",\"placeholder\":\"/path/to/output/directory/\",\"required\":true,\"type\":\"path\"},{\"id\":\"parquet_file_name\",\"label\":\"Output Parquet file name (No need to provide the .parquet extension):\",\"placeholder\":\"output_data\",\"required\":true,\"type\":\"textfield\"},{\"id\":\"ignore_errors\",\"label\":\"Ignore errors\",\"type\":\"checkbox\",\"visible\":\"\"},{\"id\":\"union_by_name\",\"label\":\"Combine multiple schemas by column name (union_by_name)\",\"type\":\"checkbox\",\"visible\":\"\"},{\"children\":[{\"enabled\":\"!$union_by_name\",\"id\":\"save_rejects\",\"label\":\"Save rejects (rejects are saved to Parquet files in the same output directory)\",\"type\":\"checkbox\",\"visible\":\"!$union_by_name\"},{\"enabled\":\"$save_rejects\",\"id\":\"rejects_data_table\",\"label\":\"Specify rejects data file name:\",\"placeholder\":\"_rejects\",\"required\":false,\"type\":\"textfield\",\"visible\":\"$save_rejects\"},{\"enabled\":\"$save_rejects\",\"id\":\"rejects_scan_table\",\"label\":\"Specify rejects scan file name:\",\"placeholder\":\"_rejects_scan\",\"required\":false,\"type\":\"textfield\",\"visible\":\"$save_rejects\"}],\"enabled\":\"!$union_by_name\",\"id\":\"section_rejects\",\"label\":\"Rejects\",\"open\":true,\"type\":\"section\",\"visible\":\"!$union_by_name\"}],\"id\":\"section_output\",\"label\":\"Output Specification\",\"open\":true,\"type\":\"section\"}],\"id\":\"params\",\"label\":\"CSV to Parquet (powered by DuckDB)\",\"type\":\"page\"},{\"children\":[{\"children\":[{\"id\":\"section_about_intro_text\",\"text\":\"\u201cCSV to Parquet\u201d is one of the most common conversion paths in modern data engineering pipelines.\\n\\nThis custom step utilizes SAS/ACCESS Interface to DuckDB to ingest a source CSV file and convert it into an optimized Parquet file. \\n\\nOpen file formats such as Parquet offer benefits of reduced data footprint and columnar structure. DuckDB is a popular and performant query processing engine that efficiently handles data ingestion and format conversion.\",\"type\":\"text\",\"visible\":\"\"},{\"children\":[{\"id\":\"text_features\",\"text\":\"1. Ingest CSV with or without headers.\\n2. Save to Parquet on file system.\\n3. Save rejected records for downstream exception code if needed.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"section_features\",\"label\":\"Features\",\"open\":true,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"children\":[{\"id\":\"section_about_parameters_input_text\",\"text\":\"1. Location of input files (radio button group, default folder): Select where your source input files are located.\\n\\nFolder options:\\n===========\\n\\n2. Source CSV file path (folder selector, required): select the folder containing source CSV files located on the SAS server (filesystem). Note: please select a folder on the SAS Server and not SAS Content.\\n\\nS3 Bucket Options:\\n===============\\n\\n3. S3 Bucket folder path (text field): Specify the S3 bucket where your CSV files are located.  If ingesting multiple files, specify only till the folder level, i.e. excluding the filename pattern and extension.  If you choose to include the filename pattern, ensure that the CSV filename pattern field is blank.\\n\\n4. S3 region (text field, default us-east-1): Specify the AWS region.\\n\\nImportant - check the following prerequisites for S3\\n\\n\\n- Ensure you have set the following environmental variables to hold S3 bucket credentials.  These are identified by \\n  the credential_chain provider in DuckDB automatically.  At a minimum,\\n  - AWS_ACCESS_KEY_ID\\n  - AWS_SECRET_ACCESS_KEY\\n  and if you're using short-term tokens for the session, \\n  - AWS_SESSION_TOKEN\\n\\n  (A standard way is to set options through option set=VAR=VALUE; SAS statements)\\n\\nURL (file hosted on the web) options:\\n============================\\n\\n5. URL path (text field): Provide the full path to a single CSV file on the web.  Do not include a glob (*) pattern. The CSV file pattern field is automatically hidden when you use this option.\\n\\n----\\n\\n6. File pattern (text field, default *.csv): A glob pattern which may include wildcards describing source CSV files\\n\\n7. CSV first line has headers (checkbox, optional): indicate whether the first row of the CSV file contains column headers. Enabled by default.\\n\\n\\n\\n\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"section_about_parameters_input\",\"label\":\"Input Parameters\",\"open\":true,\"type\":\"section\"},{\"children\":[{\"id\":\"section_about_parameters_output_text\",\"text\":\"1. Output folder path (folder selector, required): select the destination folder location on the SAS server (filesystem) where the output Parquet file will be stored. Note: please select folders on the SAS Server and not SAS Content.\\n\\n2. Output Parquet file name (text field, required): specify the name or prefix for the output Parquet file (no need to provide the .parquet extension).\\n\\n3. Save Rejects (checkbox, default checked): Whether to save rejected records to a Parquet file in the same output directory or not.\\n\\n4. Rejects table name (visible if Save Rejects selected): Specify name for the reject records table.\\n\\n5. Rejects scan table name (visible if Save Rejects selected): Specify name for reject scan table holding metadata about rejects.\\n\\n6. Ignore Errors (checkbox, default false): skip rows that cause parsing or casting errors\\n\\n7. Combine multiple file schemas (checkbox, default false): whether to combine multiple schemas based on column names - this corresponds to union_by_name in the DuckDB read_csv() function.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"section_about_parameters_output\",\"label\":\"Output specification\",\"open\":true,\"type\":\"section\",\"visible\":\"\"}],\"id\":\"section_about_parameters\",\"label\":\"Parameters\",\"open\":false,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"references_text\",\"text\":\"1. Writing Parquet files using DuckDB: https://duckdb.org/docs/2.0/data/parquet/overview\\n\\n2. Reading CSV using DuckDB: https://duckdb.org/docs/2.0/guides/file_formats/csv_import\\n\\n3. SAS/Access Interface to DuckDB: https://go.documentation.sas.com/doc/en/pgmsascdc/v_080/acreldb/p1fekl0cwbnzcmn1026kzjequme4.htm\\n\",\"type\":\"text\"}],\"id\":\"section_references\",\"label\":\"References\",\"open\":false,\"type\":\"section\"},{\"children\":[{\"id\":\"version_text\",\"text\":\"Version: 1.0.0 (23NOV2026)\\nContact: Sundaresh Sankaran (Sundaresh.Sankaran@sas.com)\",\"type\":\"text\"}],\"id\":\"section_about_version\",\"label\":\"About this step\",\"open\":true,\"type\":\"section\"}],\"id\":\"section_about_intro\",\"label\":\"CSV to Parquet\",\"open\":true,\"type\":\"section\",\"visible\":\"\"}],\"id\":\"about\",\"label\":\"About\",\"type\":\"page\"}],\"showPageContentOnly\":true,\"syntaxversion\":\"1.3.0\",\"values\":{\"csv_file_pattern\":\"*.csv\",\"csv_folder_path\":\"\",\"has_headers\":true,\"ignore_errors\":false,\"input_file_location\":{\"label\":\"It's located in a folder on the SAS Server file system.\",\"value\":\"folder\"},\"parquet_file_name\":\"\",\"parquet_output_path\":\"\",\"rejects_data_table\":\"_rejects\",\"rejects_scan_table\":\"_rejects_scan\",\"save_rejects\":true,\"union_by_name\":false}}"}