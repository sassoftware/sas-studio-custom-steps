{"creationTimeStamp":"2026-10-21T16:06:33.9025Z","createdBy":"Sundaresh.Sankaran@sas.com","modifiedTimeStamp":"2026-10-21T16:06:33.9025Z","modifiedBy":"Sundaresh.Sankaran@sas.com","id":"ca9e672b-94ff-4ab6-9271-36a53715c730","name":"DuckDB - CSV to Parquet.step","displayName":"DuckDB - CSV to Parquet.step","localDisplayName":"DuckDB - CSV to Parquet.step","links":[{"method":"GET","rel":"self","href":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","uri":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","type":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"alternate","href":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","uri":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","type":"application/vnd.sas.data.flow.step.summary"},{"method":"GET","rel":"up","href":"/dataFlows/steps","uri":"/dataFlows/steps","type":"application/vnd.sas.collection","itemType":"application/vnd.sas.data.flow.step.summary"},{"method":"PUT","rel":"update","href":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","uri":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","type":"application/vnd.sas.data.flow.step","responseType":"application/vnd.sas.data.flow.step"},{"method":"DELETE","rel":"delete","href":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","uri":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730"},{"method":"POST","rel":"copy","href":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730/copy","uri":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730/copy","responseType":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"transferExport","href":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","uri":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","responseType":"application/vnd.sas.transfer.object"},{"method":"PUT","rel":"transferImportUpdate","href":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","uri":"/dataFlows/steps/ca9e672b-94ff-4ab6-9271-36a53715c730","type":"application/vnd.sas.transfer.object","responseType":"application/vnd.sas.summary"}],"metadataVersion":1,"version":2,"type":"code","flowMetadata":{},"ui":"{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"page1\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"DuckDB CSV to Parquet\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"csv_file_path\",\n\t\t\t\t\t\"type\": \"path\",\n\t\t\t\t\t\"label\": \"Source CSV file path (please select file on SAS Server and not SAS Content):\",\n\t\t\t\t\t\"pathtype\": \"file\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"/path/to/source.csv\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"has_headers\",\n\t\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\t\"label\": \"CSV first line has headers\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"parquet_output_path\",\n\t\t\t\t\t\"type\": \"path\",\n\t\t\t\t\t\"label\": \"Output folder path (please select file on SAS Server and not SAS Content):\",\n\t\t\t\t\t\"pathtype\": \"folder\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"/path/to/output/directory/\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"parquet_file_name\",\n\t\t\t\t\t\"type\": \"textfield\",\n\t\t\t\t\t\"label\": \"Output Parquet file name (No need to provide the .parquet extension):\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"output_data\"\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"about\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"section_about_intro\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"DuckDB - CSV to Parquet\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"section_about_intro_text\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"This custom step utilizes SAS/ACCESS Interface to DuckDB to ingest a source CSV file and convert it into an optimized Parquet file. Open file formats such as Parquet are popular due to the benefits they offer in reduced data footprint and columnar structure. DuckDB provides a popular and performant query processing engine that efficiently handles data ingestion and format conversion.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"section_about_parameters\",\n\t\t\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\t\t\"label\": \"Parameters\",\n\t\t\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"id\": \"section_about_parameters_input\",\n\t\t\t\t\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Input Parameters\",\n\t\t\t\t\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\"id\": \"section_about_parameters_input_text\",\n\t\t\t\t\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\t\t\t\t\"text\": \"1. Source CSV file path (file selector, required): select the source CSV file located on the SAS server (filesystem). Note: please select files on the SAS Server and not SAS Content.\\n\\n2. CSV first line has headers (checkbox, optional): indicate whether the first row of the CSV file contains column headers. Enabled by default.\\n\",\n\t\t\t\t\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t]\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"id\": \"section_about_parameters_output\",\n\t\t\t\t\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Output specification\",\n\t\t\t\t\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\"id\": \"section_about_parameters_output_text\",\n\t\t\t\t\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\t\t\t\t\"text\": \"1. Output folder path (folder selector, required): select the destination folder location on the SAS server (filesystem) where the output Parquet file will be stored. Note: please select folders on the SAS Server and not SAS Content.\\n\\n2. Output Parquet file name (text field, required): specify the name or prefix for the output Parquet file (no need to provide the .parquet extension).\",\n\t\t\t\t\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t]\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t]\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"section_references\",\n\t\t\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\t\t\"label\": \"References\",\n\t\t\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"id\": \"references_text\",\n\t\t\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\t\t\"text\": \"1. Writing Parquet files using DuckDB: https://duckdb.org/docs/2.0/data/parquet/overview\\n\\n2. Reading CSV using DuckDB: https://duckdb.org/docs/2.0/guides/file_formats/csv_import\\n\\n3. SAS/Access Interface to DuckDB: https://go.documentation.sas.com/doc/en/pgmsascdc/v_080/acreldb/p1fekl0cwbnzcmn1026kzjequme4.htm\\n\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t]\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"section_about_version\",\n\t\t\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\t\t\"label\": \"About this step\",\n\t\t\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"id\": \"version_text\",\n\t\t\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\t\t\"text\": \"Version: 0.1.0 (21OCT2026)\\nContact: Sundaresh Sankaran (Sundaresh.Sankaran@sas.com)\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t]\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"csv_file_path\": \"\",\n\t\t\"has_headers\": true,\n\t\t\"parquet_output_path\": \"\",\n\t\t\"parquet_file_name\": \"\"\n\t}\n}","localUi":"{\"pages\":[{\"children\":[{\"id\":\"csv_file_path\",\"label\":\"Source CSV file path (please select file on SAS Server and not SAS Content):\",\"pathtype\":\"file\",\"placeholder\":\"/path/to/source.csv\",\"required\":true,\"type\":\"path\"},{\"id\":\"has_headers\",\"label\":\"CSV first line has headers\",\"type\":\"checkbox\",\"visible\":\"\"},{\"id\":\"parquet_output_path\",\"label\":\"Output folder path (please select file on SAS Server and not SAS Content):\",\"pathtype\":\"folder\",\"placeholder\":\"/path/to/output/directory/\",\"required\":true,\"type\":\"path\"},{\"id\":\"parquet_file_name\",\"label\":\"Output Parquet file name (No need to provide the .parquet extension):\",\"placeholder\":\"output_data\",\"required\":true,\"type\":\"textfield\"}],\"id\":\"page1\",\"label\":\"DuckDB CSV to Parquet\",\"type\":\"page\"},{\"children\":[{\"children\":[{\"id\":\"section_about_intro_text\",\"text\":\"This custom step utilizes SAS/ACCESS Interface to DuckDB to ingest a source CSV file and convert it into an optimized Parquet file. Open file formats such as Parquet are popular due to the benefits they offer in reduced data footprint and columnar structure. DuckDB provides a popular and performant query processing engine that efficiently handles data ingestion and format conversion.\",\"type\":\"text\",\"visible\":\"\"},{\"children\":[{\"children\":[{\"id\":\"section_about_parameters_input_text\",\"text\":\"1. Source CSV file path (file selector, required): select the source CSV file located on the SAS server (filesystem). Note: please select files on the SAS Server and not SAS Content.\\n\\n2. CSV first line has headers (checkbox, optional): indicate whether the first row of the CSV file contains column headers. Enabled by default.\\n\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"section_about_parameters_input\",\"label\":\"Input Parameters\",\"open\":true,\"type\":\"section\"},{\"children\":[{\"id\":\"section_about_parameters_output_text\",\"text\":\"1. Output folder path (folder selector, required): select the destination folder location on the SAS server (filesystem) where the output Parquet file will be stored. Note: please select folders on the SAS Server and not SAS Content.\\n\\n2. Output Parquet file name (text field, required): specify the name or prefix for the output Parquet file (no need to provide the .parquet extension).\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"section_about_parameters_output\",\"label\":\"Output specification\",\"open\":true,\"type\":\"section\",\"visible\":\"\"}],\"id\":\"section_about_parameters\",\"label\":\"Parameters\",\"open\":false,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"references_text\",\"text\":\"1. Writing Parquet files using DuckDB: https://duckdb.org/docs/2.0/data/parquet/overview\\n\\n2. Reading CSV using DuckDB: https://duckdb.org/docs/2.0/guides/file_formats/csv_import\\n\\n3. SAS/Access Interface to DuckDB: https://go.documentation.sas.com/doc/en/pgmsascdc/v_080/acreldb/p1fekl0cwbnzcmn1026kzjequme4.htm\\n\",\"type\":\"text\"}],\"id\":\"section_references\",\"label\":\"References\",\"open\":false,\"type\":\"section\"},{\"children\":[{\"id\":\"version_text\",\"text\":\"Version: 0.1.0 (21OCT2026)\\nContact: Sundaresh Sankaran (Sundaresh.Sankaran@sas.com)\",\"type\":\"text\"}],\"id\":\"section_about_version\",\"label\":\"About this step\",\"open\":true,\"type\":\"section\"}],\"id\":\"section_about_intro\",\"label\":\"DuckDB - CSV to Parquet\",\"open\":true,\"type\":\"section\",\"visible\":\"\"}],\"id\":\"about\",\"label\":\"About\",\"type\":\"page\"}],\"showPageContentOnly\":true,\"syntaxversion\":\"1.3.0\",\"values\":{\"csv_file_path\":\"\",\"has_headers\":true,\"parquet_file_name\":\"\",\"parquet_output_path\":\"\"}}","templates":{"SAS":"/************************************************************************\nDuckDB - CSV to Parquet Conversion\n\nPurpose: This SAS program utilizes SAS/ACCESS to DuckDB to ingest a CSV file \n         and convert it into a Parquet file.\nInput Parameters:\n- csv_file_path: Full path to the source CSV file (macro variable)\n- has_headers: Boolean (TRUE/FALSE) indicating if the CSV has a header row (macro variable)\n- parquet_output_path: Folder location for the output Parquet file (macro variable)\n- parquet_file_name: Name/prefix for the output Parquet file (macro variable)\n\nCreated: Sundaresh Sankaran\nVersion: 0.1.0 (21OCT2026)\n************************************************************************/;\n\n/* Define macro variables for input parameters */\n%let csv_file_path = &csv_file_path.;                /* e.g., '/data/input.csv' */\n%let has_headers = &has_headers.;                    /* TRUE or FALSE */\n%let parquet_output_path = &parquet_output_path.;    /* e.g., '/data/output/' */\n%let parquet_file_name = &parquet_file_name. ;       /* e.g., 'output_data WITHOUT the .parquet' */\n\n\n/* -----------------------------------------------------------------------------------------*\n   Macros\n\n   The macros below follow the structural conventions used in prior custom steps by author:\n\n   - small utility macros for runtime triggers and error flags\n   - a focused macro to build SQL strings and one to execute the Duck DB query\n*------------------------------------------------------------------------------------------*/\n\n/* -------------------------------------------------------------------------------------------* \n   Macro to initialize a run-time trigger global macro variable to run SAS Studio Custom Steps. \n   A value of 1 (the default) enables this custom step to run.  A value of 0 (provided by \n   upstream code) sets this to disabled.\n\n   Input:\n   1. triggerName: The name of the runtime trigger you wish to create. Ensure you provide a \n      unique value to this parameter since it will be declared as a global variable.\n\n   Output:\n   2. &triggerName : A global variable which takes the name provided to triggerName.\n*-------------------------------------------------------------------------------------------- */\n\n%macro _create_runtime_trigger(triggerName);\n   %global &triggerName.;\n   %if %sysevalf(%superq(&triggerName.)=, boolean)  %then %do;\n      %put NOTE: Trigger macro variable &triggerName. does not exist. Creating it now.;\n      %let &triggerName.=1;\n   %end;\n%mend _create_runtime_trigger;\n\n\n/* -----------------------------------------------------------------------------------------* \n   Macro to create an error flag for capture during code execution.\n\n   Input:\n      1. errorFlagName: The name of the error flag you wish to create. Ensure you provide a \n         unique value to this parameter since it will be declared as a global variable.\n      2. errorFlagDesc: A description to add to the error flag.\n\n    Output:\n      1. &errorFlagName : A global variable which takes the name provided to errorFlagName.\n      2. &errorFlagDesc : A global variable which takes the name provided to errorFlagDesc.\n*------------------------------------------------------------------------------------------ */\n\n%macro _create_error_flag(errorFlagName, errorFlagDesc);\n\n   %global &errorFlagName.;\n   %let &errorFlagName.=0;\n   %global &errorFlagDesc.;\n\n%mend _create_error_flag;\n\n\n/* -----------------------------------------------------------------------------------------* \n   Macro to identify whether a given folder location provided from a \n   SAS Studio Custom Step folder selector happens to be a SAS Content folder\n   or a folder on the filesystem (SAS Server).\n\n   Input:\n   1. pathReference: A path reference provided by the file or folder selector control in \n      a SAS Studio Custom step.\n\n   Output:\n   1. _path_identifier: Set inside macro, a global variable indicating the prefix of the \n      path provided.\n\n   Also available at: https://raw.githubusercontent.com/SundareshSankaran/sas_utility_programs/main/code/Identify%20SAS%20Content%20or%20Server/macro_identify_sas_content_server.sas\n\n*------------------------------------------------------------------------------------------ */\n\n%macro _identify_content_or_server(pathReference);\n   %global _path_identifier;\n   data _null_;\n      call symput(\"_path_identifier\", scan(%str(&pathReference.),1,\":\",\"MO\"));\n   run;\n   %put NOTE: _path_identifier is &_path_identifier. ;\n%mend _identify_content_or_server;\n\n/* -----------------------------------------------------------------------------------------* \n   Macro to extract the path provided from a SAS Studio Custom Step file or folder selector.\n\n   Input:\n   1. pathReference: A path reference provided by the file or folder selector control in \n      a SAS Studio Custom step.\n\n   Output:\n   1. _sas_folder_path: Set inside macro, a global variable containing the path.\n\n   Also available at: https://raw.githubusercontent.com/SundareshSankaran/sas_utility_programs/main/code/Extract%20SAS%20Folder%20Path/macro_extract_sas_folder_path.sas\n\n*------------------------------------------------------------------------------------------ */\n\n%macro _extract_sas_folder_path(pathReference);\n\n   %global _sas_folder_path;\n\n   data _null_;\n      call symput(\"_sas_folder_path\", scan(%str(&pathReference.),2,\":\",\"MO\"));\n   run;\n\n%mend _extract_sas_folder_path;\n\n/* -----------------------------------------------------------------------------------------* \n  EXECUTION Macro: _dcp_execution_macro\n  Purpose: Extract metadata and write to output table.\n   Behavior: Connects to DuckDB, extracts metadata, creates output table.\n*------------------------------------------------------------------------------------------ */\n\n%macro _dcp_execution_macro;\n    \n   %put NOTE: Step 1 - Assign in-memory DuckDB libname.;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n      libname dukonce duckdb database=\":memory::mydb\";;\n   %end;\n   \n   %put NOTE: Step 2 - Identify if input file reference is on Server or Content.;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n      %_identify_content_or_server(\"&csv_file_path.\");\n\n      %if \"&_path_identifier.\"=\"sasserver\" %then %do;\n         %put NOTE: Folder location prefixed with &_path_identifier. is on the SAS Server.;\n      %end;\n\n      %else %do;\n\n         %let _duckdb_error_flag=1;\n         %put ERROR: Please select a valid file on the SAS Server (filesystem). ;\n         data _null_;\n            call symputx(\"_duckdb_error_desc\", \"&_duckdb_error_desc. <-> Please select a valid file on the SAS Server (filesystem).\");\n         run;\n      \n      %end;\n\n   %end;\n\n   %put NOTE: Step 3 - Extract the path from the csv_file_path macro variable.;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n\n      %_extract_sas_folder_path(\"&csv_file_path.\");\n\n      %if \"&_sas_folder_path.\" = \"\" %then %do;\n\n         %let _duckdb_error_flag = 1;\n         %let _duckdb_error_desc = &_duckdb_error_desc. <-> The field is empty, please select a valid path  ;\n         %put ERROR: &_duckdb_error_desc. ;\n\n      %end;\n      %else %do;\n         %let file_path=&_sas_folder_path.;\n         %put NOTE: Extracted file path is &file_path.;\n      %end;\n   %end;\n\n   %put NOTE: Step 4 -  Check if parquet_output_path is on Server or Content;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n      %_identify_content_or_server(\"&parquet_output_path.\");\n\n      %if \"&_path_identifier.\"=\"sasserver\" %then %do;\n         %put NOTE: Folder location prefixed with &_path_identifier. is on the SAS Server.;\n      %end;\n\n      %else %do;\n\n         %let _duckdb_error_flag=1;\n         %put ERROR: Please select a valid location on the SAS Server (filesystem). ;\n         data _null_;\n            call symputx(\"_duckdb_error_desc\", \"&_duckdb_error_desc. <-> Please select a valid file on the SAS Server (filesystem).\");\n         run;\n      \n      %end;\n\n   %end;\n\n   %put NOTE: Step 5 - Extract the path from the parquet_output_path macro variable.;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n\n      %_extract_sas_folder_path(\"&parquet_output_path.\");\n\n      %if \"&_sas_folder_path.\" = \"\" %then %do;\n\n         %let _duckdb_error_flag = 1;\n         %let _duckdb_error_desc = &_duckdb_error_desc. <-> The field is empty, please select a valid path  ;\n         %put ERROR: &_duckdb_error_desc. ;\n\n      %end;\n      %else %do;\n         %let parquet_file_path=&_sas_folder_path.;\n         %put NOTE: Extracted file path is &parquet_file_path.;\n      %end;\n   %end;\n\n   %put NOTE: Step 6 - Extract and Load.;\n\n   %if &_duckdb_error_flag. = 0 %then %do;\n        %put NOTE: Executing DuckDB-based ELT...;\n        /* Connect to DuckDB */\n        proc sql;\n            connect using dukonce;\n            \n            execute(\n                /* \n                Using DuckDB's read_csv_auto and COPY command to export to Parquet.\n                header=&has_headers handles the column detection.\n                */\n                COPY (\n                    SELECT * FROM read_csv_auto(\"&file_path.\", \n                                                header=&has_headers, \n                                                union_by_name=true)\n                ) TO \"&parquet_file_path./&parquet_file_name..parquet\" \n                (FORMAT PARQUET, OVERWRITE TRUE);\n            ) by dukonce;\n\n            disconnect from dukonce;\n        quit;\n   %end;\n   %else %do;\n        %let _duckdb_error_desc = &_duckdb_error_desc. <-> Cannot execute DuckDB ELT query; \n        %put ERROR: &_duckdb_error_desc.;\n        %put NOTE: &_duckdb_error_flag.;\n   %end;\n\n   \n\n%mend _dcp_execution_macro;\n\n\n/************************************************************************\nEXECUTION CODE\n************************************************************************/;\n\n\n%put NOTE: Starting DuckDB-controlled ELT ...;\n%_create_error_flag(_duckdb_error_flag, _duckdb_error_desc);\n\n%put NOTE: Step 0 - 0.1 - Error Flag & Desc variable created.;\n\n%_create_runtime_trigger(_duckdb_run_trigger);\n\n%put NOTE: Step 0 - 0.2 - Runtime trigger value is &_duckdb_run_trigger.;\n\n%if &_duckdb_run_trigger. = 1 %then %do;\n   %_dcp_execution_macro;\n%end;\n\n%if &_duckdb_run_trigger. = 0 %then %do;\n   %put NOTE: This step has been disabled. Nothing to do.;\n%end;\n\n%if &_duckdb_error_flag. = 1 %then %do;\n   %put ERROR: DuckDB ELT program ended with errors. Description: &_duckdb_error_desc.;\n%end;\n\n/* ----------------------------------------------------------------------------------* \n    Cleanup \n*------------------------------------------------------------------------------------------ */\n%put NOTE: Step CLEANUP - CLEANUP.1 - Clean up global macro variables created during execution;\n\n%if %symexist(_SAS_FOLDER_PATH) %then %do;\n   %symdel _SAS_FOLDER_PATH;\n%end;\n\n%if %symexist(_PATH_IDENTIFIER) %then %do;\n   %symdel _PATH_IDENTIFIER;\n%end;\n\n\n%if %symexist(_duckdb_run_trigger) %then %do;\n   %symdel _duckdb_run_trigger;\n%end;\n\n%if %symexist(_duckdb_run_trigger) %then %do;\n   %symdel _duckdb_run_trigger;\n%end;\n\n%if %symexist(_duckdb_run_trigger) %then %do;\n   %symdel _duckdb_run_trigger;\n%end;\n\n%if %symexist(_duckdb_error_flag) %then %do;\n   %symdel _duckdb_error_flag;\n%end;\n\n%if %symexist(_duckdb_error_desc) %then %do;\n   %symdel _duckdb_error_desc;\n%end;\n\n\n/* Remove helper macros from global symbol table */\n%put NOTE: Step CLEANUP - CLEANUP.2 - Delete helper macros from global symbol table.;\n\n%sysmacdelete _create_runtime_trigger;\n%sysmacdelete _create_error_flag;\n%sysmacdelete _identify_content_or_server;\n%sysmacdelete _dcp_execution_macro;\n%sysmacdelete _extract_sas_folder_path;\n\n%put NOTE: CSV to Parquet step completed.;\n"}}
