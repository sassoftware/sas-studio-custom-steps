{"creationTimeStamp":"2026-09-06T07:43:29.765735Z","createdBy":"gerdaw","modifiedTimeStamp":"2026-09-06T12:46:31.293333Z","modifiedBy":"gerdaw","id":"f4472284-edfb-4dce-b0aa-8bf56264a573","name":"TAI - Explain Predictions with Shapley.step","displayName":"TAI - Explain Predictions with Shapley.step","localDisplayName":"TAI - Explain Predictions with Shapley.step","links":[{"method":"GET","rel":"self","href":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","uri":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","type":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"alternate","href":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","uri":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","type":"application/vnd.sas.data.flow.step.summary"},{"method":"GET","rel":"up","href":"/dataFlows/steps","uri":"/dataFlows/steps","type":"application/vnd.sas.collection","itemType":"application/vnd.sas.data.flow.step.summary"},{"method":"PUT","rel":"update","href":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","uri":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","type":"application/vnd.sas.data.flow.step","responseType":"application/vnd.sas.data.flow.step"},{"method":"DELETE","rel":"delete","href":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","uri":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573"},{"method":"POST","rel":"copy","href":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573/copy","uri":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573/copy","responseType":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"transferExport","href":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","uri":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","responseType":"application/vnd.sas.transfer.object"},{"method":"PUT","rel":"transferImportUpdate","href":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","uri":"/dataFlows/steps/f4472284-edfb-4dce-b0aa-8bf56264a573","type":"application/vnd.sas.transfer.object","responseType":"application/vnd.sas.summary"}],"metadataVersion":1,"version":2,"type":"code","flowMetadata":{"inputPorts":[{"name":"refData","displayName":"refData","localDisplayName":"refData","minEntries":1,"maxEntries":1,"defaultEntries":0,"type":"table"},{"name":"astoreTable","displayName":"astoreTable","localDisplayName":"astoreTable","minEntries":0,"maxEntries":1,"defaultEntries":0,"type":"table"}]},"ui":"{\n\t\"showPageContentOnly\": true,\n\t\"pages\": [\n\t\t{\n\t\t\t\"id\": \"designPage\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Design\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"text1\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"Compute Shapley values for explaining machine learning model predictions. Note that currently only the first row of the reference data table is getting evaluated.\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"refData\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Select reference data table (background dataset):\",\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"Select background dataset for reference\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"targetVar\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"Specify predicted target column:\",\n\t\t\t\t\t\"table\": \"refData\",\n\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"columntype\": \"n\",\n\t\t\t\t\t\"include\": null\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"intervalVars\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"Specify interval inputs:\",\n\t\t\t\t\t\"table\": \"refData\",\n\t\t\t\t\t\"multiple\": true,\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"columntype\": \"n\",\n\t\t\t\t\t\"include\": null\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"nominalVars\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"Specify nominal inputs:\",\n\t\t\t\t\t\"table\": \"refData\",\n\t\t\t\t\t\"multiple\": true,\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"include\": null\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"configPage\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"Configuration\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"astoreTable\",\n\t\t\t\t\t\"type\": \"inputtable\",\n\t\t\t\t\t\"label\": \"Analytic store model table:\",\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"placeholder\": \"Select an ASTORE model table\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"weightVar\",\n\t\t\t\t\t\"type\": \"columnselector\",\n\t\t\t\t\t\"label\": \"Select a weight column:\",\n\t\t\t\t\t\"table\": \"refData\",\n\t\t\t\t\t\"max\": 1,\n\t\t\t\t\t\"min\": 0,\n\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\"columntype\": \"n\",\n\t\t\t\t\t\"include\": null\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"impute\",\n\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\"label\": \"Select method to impute missing observations:\",\n\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"NONE\",\n\t\t\t\t\t\t\t\"label\": \"None\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"MEAN\",\n\t\t\t\t\t\t\t\"label\": \"Mean\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"WEIGHTEDMEAN\",\n\t\t\t\t\t\t\t\"label\": \"Weighted mean\"\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"methodType\",\n\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\"label\": \"Explanation method:\",\n\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"HYPERSHAP\",\n\t\t\t\t\t\t\t\"label\": \"HyperSHAP\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"KERNELSHAP\",\n\t\t\t\t\t\t\t\"label\": \"KernelSHAP\"\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\t\"required\": true\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"hyperOptionsSec\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"HyperSHAP method options\",\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$methodType\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"HYPERSHAP\"\n\t\t\t\t\t],\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"text2\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"Using the HyperSHAP method requires an ASTORE model table to be provided.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"hyperDepth\",\n\t\t\t\t\t\t\t\"type\": \"numstepper\",\n\t\t\t\t\t\t\t\"label\": \"Maximum depth of coalitional approximation:\",\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\t\t\"min\": 1,\n\t\t\t\t\t\t\t\"max\": 2\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"kernelOptionsSec\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"KernelSHAP method options\",\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$methodType\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"KERNELSHAP\"\n\t\t\t\t\t],\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"kernelBinWidth\",\n\t\t\t\t\t\t\t\"type\": \"numstepper\",\n\t\t\t\t\t\t\t\"label\": \"Bin width for interval variables:\",\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"decimalPlaces\": 4,\n\t\t\t\t\t\t\t\"min\": 0\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"kernelIncMissing\",\n\t\t\t\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\t\t\t\"label\": \"Include missing values in calculations\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"kernelSampleSize\",\n\t\t\t\t\t\t\t\"type\": \"numstepper\",\n\t\t\t\t\t\t\t\"label\": \"Sample size (number of coalition samples):\",\n\t\t\t\t\t\t\t\"required\": true,\n\t\t\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\t\t\"min\": 1\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"kernelSeed\",\n\t\t\t\t\t\t\t\"type\": \"numstepper\",\n\t\t\t\t\t\t\t\"label\": \"Random seed:\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\t\t\"min\": 0\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"text3\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"If you select to use raw data for calculation then you do not have to provide an ASTORE model table.\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"kernelUseRaw\",\n\t\t\t\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\t\t\t\"label\": \"Use raw data for calculation\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"pageAbout\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"About\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"textAbout\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"TAI - Explain Predictions with Shapley\\n==========\\n\\nThe \\\"TAI - Explain Predictions with Shapley\\\" custom steps executes PROC SHAPLEY in SAS to compute Shapley values for explaining machine learning model predictions. the step examines your predictive model and shows how each input variable contributed to the model's predictions. This can help you understand which factors were most important and build confidence in the model's results.\\n\\nMethods Supported:\\n-     HyperSHAP: Fast approximation method optimized for tree-based models.\\n-     KernelSHAP: Model-agnostic kernel-based approximation method for general models.\\n\\nThe step can help you:\\n-     See which variables have the biggest impact on predictions.\\n-     Understand the factors driving model decisions.\\n-     Explain model results to business users, managers, auditors, or other stakeholders.\\n-     Improve transparency when working with machine learning models.\\n\\nBy making model predictions easier to understand, this step helps users move beyond what the model predicted and better understand why it made that prediction.\\n\\nUse the Design tab to supply input datasets and configure model roles. Adjust algorithm-specific hyperparameters under the Configuration tab.\\n\",\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionPrereqs\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Pre-requisites\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textPrereqs\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"Pre-requisites:  Tested on Viya version Stable 2026.08\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionDocumentation\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Documentation\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textDocumentation\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"* SHAPLEY\\nhttps://go.documentation.sas.com/doc/en/pgmsascdc/default/casml/casml_shapley_toc.htm\\n\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"sectionChangelog\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Changelog\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"textChangelog\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"* Version 1.0.4 (06SEP2026)\\n      - Implement reviewer feedback\\n\\n* Version 1.0.3 (28JUL2026)\\n      - Creation of Understanding Shapley Values section in README to explain what Shapley is\\n\\n* Version 1.0.2 (27JUL2026)\\n      - SAS Code formatting changes (Properly Located Macro and Execution Code comments and Corrected Version Date)\\n      - Added version and contact info into step UI\\n\\n* Version 1.0.1 (24JUL2026)\\n      - Feedback implementation\\n\\n* Version: 1.0.0 (06JUL2026)\\n      - Initial version\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t}\n\t],\n\t\"syntaxversion\": \"1.3.0\",\n\t\"values\": {\n\t\t\"refData\": {\n\t\t\t\"library\": \"\",\n\t\t\t\"table\": \"\"\n\t\t},\n\t\t\"targetVar\": [],\n\t\t\"intervalVars\": [],\n\t\t\"nominalVars\": [],\n\t\t\"astoreTable\": {\n\t\t\t\"library\": \"\",\n\t\t\t\"table\": \"\"\n\t\t},\n\t\t\"weightVar\": [],\n\t\t\"impute\": {\n\t\t\t\"value\": \"NONE\",\n\t\t\t\"label\": \"None\"\n\t\t},\n\t\t\"methodType\": {\n\t\t\t\"value\": \"HYPERSHAP\",\n\t\t\t\"label\": \"HyperSHAP\"\n\t\t},\n\t\t\"hyperDepth\": 1,\n\t\t\"kernelBinWidth\": 0.1,\n\t\t\"kernelIncMissing\": false,\n\t\t\"kernelSampleSize\": 500,\n\t\t\"kernelSeed\": 37,\n\t\t\"kernelUseRaw\": false\n\t},\n\t\"columnExclusions\": [\n\t\t[\n\t\t\t\"targetVar\",\n\t\t\t\"weightVar\"\n\t\t],\n\t\t[\n\t\t\t\"intervalVars\",\n\t\t\t\"targetVar\"\n\t\t],\n\t\t[\n\t\t\t\"intervalVars\",\n\t\t\t\"weightVar\"\n\t\t],\n\t\t[\n\t\t\t\"nominalVars\",\n\t\t\t\"targetVar\"\n\t\t],\n\t\t[\n\t\t\t\"nominalVars\",\n\t\t\t\"intervalVars\"\n\t\t],\n\t\t[\n\t\t\t\"nominalVars\",\n\t\t\t\"weightVar\"\n\t\t]\n\t]\n}","localUi":"{\"columnExclusions\":[[\"targetVar\",\"weightVar\"],[\"intervalVars\",\"targetVar\"],[\"intervalVars\",\"weightVar\"],[\"nominalVars\",\"targetVar\"],[\"nominalVars\",\"intervalVars\"],[\"nominalVars\",\"weightVar\"]],\"pages\":[{\"children\":[{\"id\":\"text1\",\"text\":\"Compute Shapley values for explaining machine learning model predictions. Note that currently only the first row of the reference data table is getting evaluated.\",\"type\":\"text\",\"visible\":\"\"},{\"id\":\"refData\",\"label\":\"Select reference data table (background dataset):\",\"placeholder\":\"Select background dataset for reference\",\"required\":true,\"type\":\"inputtable\"},{\"columntype\":\"n\",\"id\":\"targetVar\",\"include\":null,\"label\":\"Specify predicted target column:\",\"max\":1,\"min\":1,\"required\":true,\"table\":\"refData\",\"type\":\"columnselector\"},{\"columntype\":\"n\",\"id\":\"intervalVars\",\"include\":null,\"label\":\"Specify interval inputs:\",\"multiple\":true,\"required\":false,\"table\":\"refData\",\"type\":\"columnselector\"},{\"id\":\"nominalVars\",\"include\":null,\"label\":\"Specify nominal inputs:\",\"multiple\":true,\"required\":false,\"table\":\"refData\",\"type\":\"columnselector\"}],\"id\":\"designPage\",\"label\":\"Design\",\"type\":\"page\"},{\"children\":[{\"id\":\"astoreTable\",\"label\":\"Analytic store model table:\",\"placeholder\":\"Select an ASTORE model table\",\"required\":false,\"type\":\"inputtable\"},{\"columntype\":\"n\",\"id\":\"weightVar\",\"include\":null,\"label\":\"Select a weight column:\",\"max\":1,\"min\":0,\"required\":false,\"table\":\"refData\",\"type\":\"columnselector\"},{\"id\":\"impute\",\"items\":[{\"label\":\"None\",\"value\":\"NONE\"},{\"label\":\"Mean\",\"value\":\"MEAN\"},{\"label\":\"Weighted mean\",\"value\":\"WEIGHTEDMEAN\"}],\"label\":\"Select method to impute missing observations:\",\"placeholder\":\"\",\"required\":true,\"type\":\"dropdown\",\"visible\":\"\"},{\"id\":\"methodType\",\"items\":[{\"label\":\"HyperSHAP\",\"value\":\"HYPERSHAP\"},{\"label\":\"KernelSHAP\",\"value\":\"KERNELSHAP\"}],\"label\":\"Explanation method:\",\"required\":true,\"type\":\"dropdown\"},{\"children\":[{\"id\":\"text2\",\"text\":\"Using the HyperSHAP method requires an ASTORE model table to be provided.\",\"type\":\"text\",\"visible\":\"\"},{\"id\":\"hyperDepth\",\"integer\":true,\"label\":\"Maximum depth of coalitional approximation:\",\"max\":2,\"min\":1,\"required\":true,\"type\":\"numstepper\"}],\"id\":\"hyperOptionsSec\",\"label\":\"HyperSHAP method options\",\"open\":true,\"type\":\"section\",\"visible\":[\"$methodType\",\"=\",\"HYPERSHAP\"]},{\"children\":[{\"decimalPlaces\":4,\"id\":\"kernelBinWidth\",\"label\":\"Bin width for interval variables:\",\"min\":0,\"required\":true,\"type\":\"numstepper\"},{\"id\":\"kernelIncMissing\",\"label\":\"Include missing values in calculations\",\"type\":\"checkbox\"},{\"id\":\"kernelSampleSize\",\"integer\":true,\"label\":\"Sample size (number of coalition samples):\",\"min\":1,\"required\":true,\"type\":\"numstepper\"},{\"id\":\"kernelSeed\",\"integer\":true,\"label\":\"Random seed:\",\"min\":0,\"required\":false,\"type\":\"numstepper\"},{\"id\":\"text3\",\"text\":\"If you select to use raw data for calculation then you do not have to provide an ASTORE model table.\",\"type\":\"text\",\"visible\":\"\"},{\"id\":\"kernelUseRaw\",\"label\":\"Use raw data for calculation\",\"type\":\"checkbox\"}],\"id\":\"kernelOptionsSec\",\"label\":\"KernelSHAP method options\",\"open\":true,\"type\":\"section\",\"visible\":[\"$methodType\",\"=\",\"KERNELSHAP\"]}],\"id\":\"configPage\",\"label\":\"Configuration\",\"type\":\"page\"},{\"children\":[{\"id\":\"textAbout\",\"text\":\"TAI - Explain Predictions with Shapley\\n==========\\n\\nThe \\\"TAI - Explain Predictions with Shapley\\\" custom steps executes PROC SHAPLEY in SAS to compute Shapley values for explaining machine learning model predictions. the step examines your predictive model and shows how each input variable contributed to the model's predictions. This can help you understand which factors were most important and build confidence in the model's results.\\n\\nMethods Supported:\\n-     HyperSHAP: Fast approximation method optimized for tree-based models.\\n-     KernelSHAP: Model-agnostic kernel-based approximation method for general models.\\n\\nThe step can help you:\\n-     See which variables have the biggest impact on predictions.\\n-     Understand the factors driving model decisions.\\n-     Explain model results to business users, managers, auditors, or other stakeholders.\\n-     Improve transparency when working with machine learning models.\\n\\nBy making model predictions easier to understand, this step helps users move beyond what the model predicted and better understand why it made that prediction.\\n\\nUse the Design tab to supply input datasets and configure model roles. Adjust algorithm-specific hyperparameters under the Configuration tab.\\n\",\"type\":\"text\",\"visible\":\"\"},{\"children\":[{\"id\":\"textPrereqs\",\"text\":\"Pre-requisites:  Tested on Viya version Stable 2026.08\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"sectionPrereqs\",\"label\":\"Pre-requisites\",\"open\":false,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"textDocumentation\",\"text\":\"* SHAPLEY\\nhttps://go.documentation.sas.com/doc/en/pgmsascdc/default/casml/casml_shapley_toc.htm\\n\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"sectionDocumentation\",\"label\":\"Documentation\",\"open\":false,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"textChangelog\",\"text\":\"* Version 1.0.4 (06SEP2026)\\n      - Implement reviewer feedback\\n\\n* Version 1.0.3 (28JUL2026)\\n      - Creation of Understanding Shapley Values section in README to explain what Shapley is\\n\\n* Version 1.0.2 (27JUL2026)\\n      - SAS Code formatting changes (Properly Located Macro and Execution Code comments and Corrected Version Date)\\n      - Added version and contact info into step UI\\n\\n* Version 1.0.1 (24JUL2026)\\n      - Feedback implementation\\n\\n* Version: 1.0.0 (06JUL2026)\\n      - Initial version\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"sectionChangelog\",\"label\":\"Changelog\",\"open\":true,\"type\":\"section\",\"visible\":\"\"}],\"id\":\"pageAbout\",\"label\":\"About\",\"type\":\"page\"}],\"showPageContentOnly\":true,\"syntaxversion\":\"1.3.0\",\"values\":{\"astoreTable\":{\"library\":\"\",\"table\":\"\"},\"hyperDepth\":1,\"impute\":{\"label\":\"None\",\"value\":\"NONE\"},\"intervalVars\":[],\"kernelBinWidth\":0.1,\"kernelIncMissing\":false,\"kernelSampleSize\":500,\"kernelSeed\":37,\"kernelUseRaw\":false,\"methodType\":{\"label\":\"HyperSHAP\",\"value\":\"HYPERSHAP\"},\"nominalVars\":[],\"refData\":{\"library\":\"\",\"table\":\"\"},\"targetVar\":[],\"weightVar\":[]}}","templates":{"SAS":"/************************************************************************\nTrustworthy AI (TAI) - Explain Predictions with Shapley\n\nPurpose: This SAS program executes PROC SHAPLEY to compute Shapley values \nfor explaining machine learning model predictions. It supports both \nHyperSHAP and KernelSHAP methods with method-specific parameter controls.\n\nInput Parameters:\n- refData: Reference data table containing background observations (macro variable)\n- intervalVars: List of interval input variables (macro variable)\n- nominalVars: List of nominal input variables (macro variable)\n- targetVar: Predicted target variable containing model predictions (macro variable)\n- weightVar: Optional weight variable (macro variable)\n- astoreTable: Optional Analytic Store (ASTORE) table (macro variable)\n- methodType: Explainer method, HYPERSHAP or KERNELSHAP (macro variable)\n\nMethod - HyperSHAP Options:\n- hyperDepth: Maximum depth of coalitional approximation (Default: 1)\n\nMethod - KernelSHAP Options:\n- kernelBinWidth: Bin width for interval variables (Default: 0.1)\n- kernelIncMissing: Flag to include missing values (1=Yes, 0=No)\n- kernelSampleSize: Number of coalition samples to generate (Default: 500)\n- kernelSeed: Random seed value for KernelSHAP method (macro variable)\n- kernelUseRaw: Flag to specify whether to use raw data (1=Yes, 0=No)\n\n\nTested in SAS Viya 2026.08\nVersion: 1.0.4 (06SEP2026)\n************************************************************************/;\n\n\n/************************************************************************\nMACRO DEFINITION\n************************************************************************/;\n\n\n/* -----------------------------------------------------------------------------------------* \n   Macro to set up the error flagging and determine how Proc Shapley should run assuming all required fields\n   Have been filled out\n   If there's a major component missing (specified in the if statement) then the if block will execute and throw an error\n   Otherwise, the else block containing the proc shapley will execute\n*------------------------------------------------------------------------------------------ */\n%macro _shapley;\n    %local _eps_Query_Data;\n\n    /* Ensure required parameters are provided before executing */\n    %if %sysevalf(%superq(refData)=, boolean) or \n        %sysevalf(%superq(targetVar)=, boolean) or\n        (\n            %sysevalf(%superq(intervalVars)=, boolean) and\n            %sysevalf(%superq(nominalVars)=, boolean)\n        ) %then %do;\n        %put ERROR: Missing required parameters. Please check the input variable and target variable selection.;\n    %end;\n    %else %do;\n        \n        /* If astoreTable has no value in the UI then make sure it's set equal to nothing so that it doesn't throw a warning */\n        %if not %symexist(astoreTable) %then %let astoreTable=;\n        \n        /* Move the data to the same engine as the reference data */\n        %if %upcase(&refData_engine.) = CAS %then %do;\n            %let _eps_Query_Data = &refData_lib.._query;\n        %end;\n        %else %do;\n            %let _eps_Query_Data = work._query;\n        %end;\n\n        %put &=_eps_Query_Data;\n\n        /* Create the data for Proc Shapley that only needs one row of the reference data */\n        data &_eps_Query_Data.;\n            set &refData.(obs=1);\n        run; \n        \n        proc shapley data=&_eps_Query_Data. referenceData=&refData. impute=&impute.;\n            \n            /* Reference an Analytic Store (ASTORE) model if provided */\n            %if %sysevalf(%superq(astoreTable)=, boolean) = 0 %then %do;\n                astoreModel rstore=&astoreTable.;\n            %end;\n\n            /* Define Interval input variables if specified */\n            %if %sysevalf(%superq(intervalVars)=, boolean) = 0 %then %do;\n                input &intervalVars. / level=interval;\n            %end;\n\n            /* Define Nominal input variables if specified */\n            %if %sysevalf(%superq(nominalVars)=, boolean) = 0 %then %do;\n                input &nominalVars. / level=nominal;\n            %end;\n\n            /* Specify the Predicted Target Column */\n            predictedtarget &targetVar.;\n\n            /* Set observational weight if specified */\n            %if %sysevalf(%superq(weightVar)=, boolean) = 0 %then %do;\n                weight &weightVar.;\n            %end;\n\n            /* Construct dynamic METHOD statement based on selection */\n            %if %upcase(&methodType.) = HYPERSHAP %then %do;\n                method hyperSHAP (\n                    %if %sysevalf(%superq(hyperDepth)=, boolean) = 0 %then depth=&hyperDepth. ;\n                );\n            %end;\n            %else %if %upcase(&methodType.) = KERNELSHAP %then %do;\n                method kernelSHAP (\n                    %if %sysevalf(%superq(kernelBinWidth)=, boolean) = 0 %then binwidth=&kernelBinWidth. ;\n                    %if &kernelIncMissing. = 1 %then includeMissing ;\n                    %if %sysevalf(%superq(kernelSampleSize)=, boolean) = 0 %then sampleSize=&kernelSampleSize. ;\n                    %if %sysevalf(%superq(kernelSeed)=, boolean) = 0 %then seed=&kernelSeed. ;\n                    %if &kernelUseRaw. = 1 %then useRawData ;\n                );\n            %end;\n        run;\n\n        * Clean up;\n        proc sql noPrint;\n            drop table &_eps_Query_Data.;\n        quit;\n    %end;\n%mend _shapley;\n\n/************************************************************************\nEXECUTION CODE\n************************************************************************/;\n\ntitle \"Shapley\";\n\n%_shapley\n\ntitle;\n\n%sysmacdelete _shapley;"}}
