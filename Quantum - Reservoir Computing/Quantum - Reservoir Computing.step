{"creationTimeStamp":"2026-10-09T17:22:47.81257Z","createdBy":"josgri","modifiedTimeStamp":"2026-11-17T19:27:23.007Z","modifiedBy":"sasebb","id":"92d432a0-227c-4d1e-a9a9-c8cd97347a99","name":"Quantum - Reservoir Computing.step","displayName":"Quantum - Reservoir Computing.step","localDisplayName":"Quantum - Reservoir Computing.step","description":"Quantum Reservoir Computing custom step using SAS PROC QRUN and PROC HYPERTUNE for Hypertune optimization with y/target target-column support and 105 Hypertune tuning fixes. Uses a SAS directory fileref for generated output files to avoid long filename limits.","localDescription":"Quantum Reservoir Computing custom step using SAS PROC QRUN and PROC HYPERTUNE for Hypertune optimization with y/target target-column support and 105 Hypertune tuning fixes. Uses a SAS directory fileref for generated output files to avoid long filename limits.","links":[{"method":"GET","rel":"self","href":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","uri":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","type":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"alternate","href":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","uri":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","type":"application/vnd.sas.data.flow.step.summary"},{"method":"GET","rel":"up","href":"/dataFlows/steps","uri":"/dataFlows/steps","type":"application/vnd.sas.collection","itemType":"application/vnd.sas.data.flow.step.summary"},{"method":"PUT","rel":"update","href":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","uri":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","type":"application/vnd.sas.data.flow.step","responseType":"application/vnd.sas.data.flow.step"},{"method":"DELETE","rel":"delete","href":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","uri":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa"},{"method":"POST","rel":"copy","href":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa/copy","uri":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa/copy","responseType":"application/vnd.sas.data.flow.step"},{"method":"GET","rel":"transferExport","href":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","uri":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","responseType":"application/vnd.sas.transfer.object"},{"method":"PUT","rel":"transferImportUpdate","href":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","uri":"/dataFlows/steps/d350c9c4-0680-4214-a256-a5130adf8aaa","type":"application/vnd.sas.transfer.object","responseType":"application/vnd.sas.summary"}],"metadataVersion":1,"version":2,"type":"code","flowMetadata":{"inputPorts":[{"name":"inputtable1","displayName":"Input Data","localDisplayName":"Input Data","minEntries":1,"maxEntries":1,"defaultEntries":0,"type":"table"}],"outputPorts":[{"name":"outputtable1","displayName":"QRC Output","localDisplayName":"QRC Output","minEntries":0,"maxEntries":1,"defaultEntries":0,"type":"table"}]},"ui":"{\"showPageContentOnly\":true,\"pages\":[{\"id\":\"pageData\",\"type\":\"page\",\"label\":\"Data\",\"children\":[{\"id\":\"inputtable1\",\"type\":\"inputtable\",\"label\":\"Input data:\",\"required\":true,\"placeholder\":\"\",\"visible\":\"\"},{\"id\":\"SampleRate\",\"type\":\"numberfield\",\"label\":\"Downsample (percent of rows to use):\",\"min\":1,\"max\":100,\"integer\":true,\"visible\":\"\"},{\"id\":\"Mode\",\"type\":\"radiogroup\",\"label\":\"Mode:\",\"items\":[{\"value\":\"quantumlab\",\"label\":\"Manual (specify quantum circuit parameters)\"},{\"value\":\"autotune\",\"label\":\"Hypertune (optimize quantum circuit parameters)\"}],\"visible\":\"\"},{\"id\":\"section1\",\"type\":\"section\",\"label\":\"Output\",\"open\":true,\"visible\":\"\",\"children\":[{\"id\":\"outputDS\",\"type\":\"checkbox\",\"label\":\"Save output data\",\"visible\":\"\"},{\"id\":\"outputtable1\",\"type\":\"outputtable\",\"label\":\"Output table (QRC-transformed data):\",\"required\":false,\"placeholder\":\"\",\"visible\":\"$outputDS\",\"indent\":1},{\"id\":\"text5\",\"type\":\"text\",\"text\":\"Note: When running this step in a flow, you must add an output port for this optional table on the step node.\",\"visible\":\"$outputDS\",\"indent\":1},{\"id\":\"replaceOutput\",\"type\":\"checkbox\",\"label\":\"Replace existing output table\",\"visible\":\"$outputDS\",\"indent\":1}]}]},{\"id\":\"pageQRC\",\"type\":\"page\",\"label\":\"QRC Options\",\"children\":[{\"id\":\"CircuitType\",\"type\":\"radiogroup\",\"label\":\"Circuit type:\",\"items\":[{\"value\":\"LINEAR\",\"label\":\"Linear\"},{\"value\":\"ENTANGLED\",\"label\":\"Entangled\"},{\"value\":\"NONLINEAR\",\"label\":\"Nonlinear\"},{\"value\":\"RECURRENTFEEDBACK\",\"label\":\"Recurrent feedback\"},{\"value\":\"PARAMETRIC\",\"label\":\"Parametric\"},{\"value\":\"SPARSECONNECTIVITY\",\"label\":\"Sparse connectivity\"}],\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"list1\",\"type\":\"list\",\"label\":\"Circuit types:\",\"items\":[{\"value\":\"Linear\"},{\"value\":\"Entangled\"},{\"value\":\"Nonlinear\"},{\"value\":\"Recurrent feedback\"},{\"value\":\"Parametric\"},{\"value\":\"Sparse connectivity\"}],\"max\":null,\"min\":1,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"txtCircuitAutoQX\",\"type\":\"text\",\"text\":\"Hypertune mode uses PROC HYPERTUNE to search the selected circuit types, the qubit range, and SVM parameters on a log scale, uses the cache when enabled, and renders the champion PROC QRUN reservoir.\",\"visible\":[\"$Mode\",\"=\",\"autotune\"],\"indent\":1},{\"id\":\"NumQubits\",\"type\":\"numberfield\",\"label\":\"Number of qubits:\",\"min\":4,\"max\":30,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"txtQubitsManual\",\"type\":\"text\",\"text\":\"Note: Runtime grows exponentially with qubit count, and the number of quantum features grows quadratically. The log warns about large settings.\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"],\"indent\":1},{\"id\":\"MinQubits\",\"type\":\"numberfield\",\"label\":\"Minimum qubits:\",\"min\":4,\"max\":30,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"MaxQubits\",\"type\":\"numberfield\",\"label\":\"Maximum qubits:\",\"min\":4,\"max\":30,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"txtQubitsAutoQX\",\"type\":\"text\",\"text\":\"PROC HYPERTUNE searches this inclusive qubit range, and the final graphs use the champion circuit type and qubit count. Each circuit and qubit combination builds a reservoir before the search, so wide ranges take longer.\",\"visible\":[\"$Mode\",\"=\",\"autotune\"],\"indent\":1},{\"id\":\"ml_algorithm\",\"type\":\"radiogroup\",\"label\":\"Machine learning algorithm:\",\"items\":[{\"value\":\"none\",\"label\":\"None (skip ML comparison)\"},{\"value\":\"svm\",\"label\":\"Support Vector Machine (SVM)\"},{\"value\":\"logistic regression\",\"label\":\"Logistic regression\"},{\"value\":\"log select\",\"label\":\"Log select\"},{\"value\":\"grad boost\",\"label\":\"Gradient boosting\"},{\"value\":\"random forest\",\"label\":\"Random forest\"}],\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"ml_algorithm_ht\",\"type\":\"radiogroup\",\"label\":\"Machine learning algorithm:\",\"enabled\":false,\"items\":[{\"value\":\"none\",\"label\":\"None (skip ML comparison)\"},{\"value\":\"svm\",\"label\":\"Support Vector Machine (SVM)\"},{\"value\":\"logistic regression\",\"label\":\"Logistic regression\"},{\"value\":\"log select\",\"label\":\"Log select\"},{\"value\":\"grad boost\",\"label\":\"Gradient boosting\"},{\"value\":\"random forest\",\"label\":\"Random forest\"}],\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"secSVMParams\",\"type\":\"section\",\"label\":\"Support Vector Machine (SVM) parameters\",\"open\":true,\"visible\":[[\"$ml_algorithm\",\"=\",\"svm\"],\"|\",[\"$Mode\",\"=\",\"autotune\"]],\"indent\":1,\"children\":[{\"id\":\"C_param\",\"type\":\"numberfield\",\"label\":\"C (regularization strength):\",\"min\":0.0001,\"max\":1000000,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"K_par\",\"type\":\"numberfield\",\"label\":\"Gamma (kernel bandwidth):\",\"min\":0.0001,\"max\":1000000,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"CMin\",\"type\":\"numberfield\",\"label\":\"C minimum:\",\"min\":0.0001,\"max\":1000000,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"CMax\",\"type\":\"numberfield\",\"label\":\"C maximum:\",\"min\":0.0001,\"max\":1000000,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GammaMin\",\"type\":\"numberfield\",\"label\":\"Gamma minimum:\",\"min\":0.0001,\"max\":1000000,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GammaMax\",\"type\":\"numberfield\",\"label\":\"Gamma maximum:\",\"min\":0.0001,\"max\":1000000,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"autotune\"]}]},{\"id\":\"secLogSelectParams\",\"type\":\"section\",\"label\":\"Logistic model parameters\",\"open\":true,\"visible\":[[[\"$ml_algorithm\",\"=\",\"log select\"],\"|\",[\"$ml_algorithm\",\"=\",\"logistic regression\"]],\"&\",[\"$Mode\",\"=\",\"quantumlab\"]],\"indent\":1,\"children\":[{\"id\":\"cutoff_param\",\"type\":\"numberfield\",\"label\":\"Classification threshold:\",\"min\":0,\"max\":1,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"log_select_method\",\"type\":\"radiogroup\",\"label\":\"Variable selection method:\",\"items\":[{\"value\":\"forward\",\"label\":\"Forward\"},{\"value\":\"backward\",\"label\":\"Backward\"},{\"value\":\"stepwise\",\"label\":\"Stepwise\"}],\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"txtLogSelectNote\",\"type\":\"text\",\"text\":\"The variable selection method is not applied. Logistic regression and Log select both fit all predictors; only the classification threshold applies.\",\"visible\":\"\"},{\"id\":\"cutoff_min\",\"type\":\"numberfield\",\"label\":\"Classification threshold minimum:\",\"min\":0,\"max\":1,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"cutoff_max\",\"type\":\"numberfield\",\"label\":\"Classification threshold maximum:\",\"min\":0,\"max\":1,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"autotune\"]}]},{\"id\":\"secGradBoostParams\",\"type\":\"section\",\"label\":\"Gradient boosting parameters\",\"open\":true,\"visible\":[[\"$ml_algorithm\",\"=\",\"grad boost\"],\"&\",[\"$Mode\",\"=\",\"quantumlab\"]],\"indent\":1,\"children\":[{\"id\":\"txtGradBoostNote\",\"type\":\"text\",\"text\":\"These settings are not applied. Gradient boosting runs with procedure defaults.\",\"visible\":\"\"},{\"id\":\"GB_NTrees\",\"type\":\"numberfield\",\"label\":\"Number of trees:\",\"min\":1,\"max\":1000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"GB_LearnRate\",\"type\":\"numberfield\",\"label\":\"Learning rate:\",\"min\":0.0001,\"max\":1,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"GB_MaxDepth\",\"type\":\"numberfield\",\"label\":\"Maximum depth:\",\"min\":1,\"max\":50,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"GB_MinLeaf\",\"type\":\"numberfield\",\"label\":\"Minimum leaf size:\",\"min\":1,\"max\":10000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"GB_NTreesMin\",\"type\":\"numberfield\",\"label\":\"Minimum number of trees:\",\"min\":1,\"max\":1000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_NTreesMax\",\"type\":\"numberfield\",\"label\":\"Maximum number of trees:\",\"min\":1,\"max\":1000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_LearnRateMin\",\"type\":\"numberfield\",\"label\":\"Minimum learning rate:\",\"min\":0.0001,\"max\":1,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_LearnRateMax\",\"type\":\"numberfield\",\"label\":\"Maximum learning rate:\",\"min\":0.0001,\"max\":1,\"integer\":false,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_MaxDepthMin\",\"type\":\"numberfield\",\"label\":\"Minimum for maximum depth:\",\"min\":1,\"max\":50,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_MaxDepthMax\",\"type\":\"numberfield\",\"label\":\"Maximum for maximum depth:\",\"min\":1,\"max\":50,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_MinLeafMin\",\"type\":\"numberfield\",\"label\":\"Minimum for minimum leaf size:\",\"min\":1,\"max\":10000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_MinLeafMax\",\"type\":\"numberfield\",\"label\":\"Maximum for minimum leaf size:\",\"min\":1,\"max\":10000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]}]},{\"id\":\"secForestParams\",\"type\":\"section\",\"label\":\"Random forest parameters\",\"open\":true,\"visible\":[[\"$ml_algorithm\",\"=\",\"random forest\"],\"&\",[\"$Mode\",\"=\",\"quantumlab\"]],\"indent\":1,\"children\":[{\"id\":\"txtForestNote\",\"type\":\"text\",\"text\":\"These settings are not applied. Random forest runs with procedure defaults.\",\"visible\":\"\"},{\"id\":\"RF_NTrees\",\"type\":\"numberfield\",\"label\":\"Number of trees:\",\"min\":1,\"max\":2000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"RF_IntervalBins\",\"type\":\"numberfield\",\"label\":\"Interval bins:\",\"min\":2,\"max\":200,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"RF_MinLeaf\",\"type\":\"numberfield\",\"label\":\"Minimum leaf size:\",\"min\":1,\"max\":10000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"RF_NTreesMin\",\"type\":\"numberfield\",\"label\":\"Minimum number of trees:\",\"min\":1,\"max\":2000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"RF_NTreesMax\",\"type\":\"numberfield\",\"label\":\"Maximum number of trees:\",\"min\":1,\"max\":2000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"RF_IntervalBinsMin\",\"type\":\"numberfield\",\"label\":\"Minimum interval bins:\",\"min\":2,\"max\":200,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"RF_IntervalBinsMax\",\"type\":\"numberfield\",\"label\":\"Maximum interval bins:\",\"min\":2,\"max\":200,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"RF_MinLeafMin\",\"type\":\"numberfield\",\"label\":\"Minimum for minimum leaf size:\",\"min\":1,\"max\":10000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"RF_MinLeafMax\",\"type\":\"numberfield\",\"label\":\"Maximum for minimum leaf size:\",\"min\":1,\"max\":10000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]}]}]},{\"id\":\"pageAdvanced\",\"type\":\"page\",\"label\":\"Advanced Simulation\",\"children\":[{\"id\":\"NumTrials\",\"type\":\"numberfield\",\"label\":\"Number of PROC HYPERTUNE trials:\",\"min\":1,\"max\":5000,\"integer\":true,\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"secCache\",\"type\":\"section\",\"label\":\"Cache\",\"open\":true,\"visible\":\"\",\"children\":[{\"id\":\"UseCache\",\"type\":\"checkbox\",\"label\":\"Use cache\",\"visible\":\"\"},{\"id\":\"txtCache\",\"type\":\"text\",\"text\":\"Reuses the PROC HYPERTUNE CACHEOUT table from the current SAS Data and AI Studio session when available. Off by default, so each run starts a fresh search. The cache resets automatically when the circuit types, input table, Downsample, label noise, or simulation method changes.\",\"visible\":\"\",\"indent\":1}]},{\"id\":\"secParallel\",\"type\":\"section\",\"label\":\"Parallelism\",\"open\":true,\"visible\":\"\",\"children\":[{\"id\":\"NumParallel\",\"type\":\"numberfield\",\"label\":\"Number of parallel cores:\",\"min\":1,\"max\":64,\"integer\":true,\"visible\":\"\"}]},{\"id\":\"secSimMethod\",\"type\":\"section\",\"label\":\"Simulation method\",\"open\":true,\"visible\":\"\",\"children\":[{\"id\":\"SimMethod\",\"type\":\"radiogroup\",\"label\":\"Method:\",\"items\":[{\"value\":\"automatic\",\"label\":\"Automatic (recommended; selects best based on qubit count)\"},{\"value\":\"statevector\",\"label\":\"Statevector (exact; memory-intensive; good for up to ~20 qubits)\"},{\"value\":\"mps\",\"label\":\"MPS/tensor-network (handles larger circuits approximately)\"}],\"visible\":\"\"}]},{\"id\":\"LabelNoiseRate\",\"type\":\"numberfield\",\"label\":\"Binary label noise rate:\",\"min\":0,\"max\":1,\"integer\":false,\"visible\":\"\"},{\"id\":\"txtLabelNoiseRate\",\"type\":\"text\",\"text\":\"Applies SAS-side label noise only when Y is binary 0/1. Default is 0; increase only for stress testing.\",\"visible\":\"\",\"indent\":1},{\"id\":\"HeatMap\",\"type\":\"checkbox\",\"label\":\"Show classical, QRC, and combined correlation heatmaps\",\"visible\":\"\"},{\"id\":\"txtHeatMap\",\"type\":\"text\",\"text\":\"Produces preview output plus Classical, QRC, and Combined feature-correlation heatmaps using SAS procedures.\",\"visible\":\"\",\"indent\":1}]},{\"id\":\"pageAbout\",\"type\":\"page\",\"label\":\"About\",\"children\":[{\"id\":\"txtAbout\",\"type\":\"text\",\"visible\":\"\",\"text\":\"Quantum - Reservoir Computing\\n==========================\\n\\nTransforms tabular data into quantum reservoir features, then compares how well Classical, Quantum (QRC), and Combined features predict a target.\\n\\nPipeline\\n---------\\n1. Optionally downsample the input.\\n2. Standardize numeric predictors and project them onto one angle per qubit.\\n3. Build an OpenQASM 3 reservoir circuit and simulate it with PROC QRUN.\\n4. Measure single-qubit and neighboring two-qubit Z expectation values.\\n5. Add pairwise products of those expectation values.\\n6. Write three feature sets: Classical, Quantum (QRC), and Combined.\\n7. Optionally train a model on each feature set and report accuracy.\\n\\nModes\\n-------\\n* Manual: Runs one reservoir with the circuit type, qubit count, and simulation method you choose.\\n* Hypertune: Uses PROC HYPERTUNE to search the selected Circuit types, the qubit range, and SVM C and gamma (log10 scale). The machine learning algorithm is fixed to SVM. The final circuit display, accuracy comparison, output data, and context JSON are regenerated from the winning reservoir.\\n* Hypertune implementation: Uses SAS SUBMIT objectives with CACHEIN, CACHEOUT, and PRIMALOUT datasets, and Number of parallel cores (NumParallel) for parallel evaluations. It does not use the original Python AutoQX optimizer or external Python cache.\\n\\nInput data\\n-----------\\n* Use numeric predictors and a target named y or target (case-insensitive). If both exist, y is used.\\n* If neither exists, a placeholder y of 0 is created, so the ML comparison is not meaningful.\\n* Missing numeric target values are set to 0.\\n\\nOutput\\n--------\\n* Output port: Select Save output data and specify an output table to write the Combined feature table. Select Replace existing output table to overwrite an existing table; otherwise the step stops with an error before running if the table exists. Columns are x0, x1, and so on (classical projections followed by quantum features), plus y.\\n* Results window: Champion circuit display, runtime summary, and, when a machine learning algorithm is selected, an accuracy table and bar chart for Classical, Quantum, and Quantum+Classical features. Correlation heatmaps appear when selected.\\n* Files in the SAS session working directory, each with a unique run identifier: classical_*.csv, qrc_*.csv, combined_*.csv, accuracy_*.csv, circuit_*.qasm3, and agent_context_*.json (run settings and file names).\\n* Cleanup: The step deletes its temporary _qrc_ tables, global macro variables, and macros, and restores MLOGIC, MPRINT, and SYMBOLGEN. With Use cache selected, the PROC HYPERTUNE cache table is kept.\\n\\nSimulation methods\\n----------------------\\n* Automatic: Uses the PROC QRUN default method.\\n* Statevector: Sets SIMMETHOD=STATEVECTOR.\\n* MPS: Sets SIMMETHOD=MPS.\\n\\nQuantum simulation has no simulated gate or hardware noise. Optional binary label noise affects only classification targets, not the quantum circuit.\\n\\nMachine learning algorithms\\n-------------------------------\\n* Manual mode offers None (skip ML comparison), Support Vector Machine (SVM), Logistic regression, Log select, Gradient boosting, and Random forest.\\n* Hypertune mode is fixed to SVM.\\n* See Limitations for how accuracy is measured and which model settings are applied.\\n\"},{\"id\":\"secLimitations\",\"type\":\"section\",\"label\":\"Limitations\",\"open\":false,\"visible\":\"\",\"children\":[{\"id\":\"txtLimitations\",\"type\":\"text\",\"visible\":\"\",\"text\":\"* Reported accuracy is training accuracy, not held-out accuracy. For a binary target, the SVM result is the better of the SVM and a nearest-centroid classifier.\\n* Simulation method: Statevector and MPS set SIMMETHOD= on PROC QRUN. Automatic uses the default method.\\n* Hypertune: Hypertune always tunes SVM. Classification threshold, gradient boosting, and random forest bounds are not searched.\\n* Gradient boosting, random forest, and logistic selection: These models run with procedure defaults. Tree and forest parameters and the variable selection method on QRC Options are not applied. Logistic regression and Log select run the same model; only the threshold applies.\\n* Hypertune circuits: Hypertune searches the circuits selected in Circuit types. If none is selected, it uses Entangled.\\n* Hypertune cache: With Use cache selected, the cache resets when the circuit list, input table name or row count, Downsample, label noise, or simulation method changes. It cannot detect changed values in a table with the same name and row count.\\n* Noiseless simulation: Quantum simulation has no simulated gate or hardware noise. Expectation values are computed from the simulated state without measurement-shot sampling. Optional binary label noise affects only classification targets, not the quantum circuit.\\n* Binary label noise: Applies only when y contains both 0 and 1. Each label is flipped with the specified probability, using seed 42. Default 0 leaves labels unchanged. Modified labels are used by all three feature sets and Hypertune. The SAS log reports whether label noise was applied or skipped.\\n* Qubit count: The number of projected predictors is the smaller of the qubit count and the number of numeric predictors. Extra qubits receive an angle of 0.\\n* Large settings: The step does not limit the qubit count. It writes a warning to the log for more than 20 qubits without MPS, more than 500 quantum features per row, or more than 12 Hypertune candidate reservoirs. The feature count grows quadratically with the qubit count.\"}]},{\"id\":\"secPrereqs\",\"type\":\"section\",\"label\":\"Pre-requisites\",\"open\":false,\"visible\":\"\",\"children\":[{\"id\":\"txtPrereqs\",\"type\":\"text\",\"text\":\"* SAS Viya with SAS Data and AI Studio Flows.\\n* A release that includes PROC QRUN (SAS Quantum Lab) and PROC HYPERTUNE.\\n* An active CAS session. The step assigns a qrun CAS library, starting a qrun_session if needed.\\n* Numeric predictor columns and a y or target column.\\n* A Python environment configured for PROC HYPERTUNE.\\n\\nTested on Viya version 2026.11.\",\"visible\":\"\"}]},{\"id\":\"secDocumentation\",\"type\":\"section\",\"label\":\"Documentation\",\"open\":false,\"visible\":\"\",\"children\":[{\"id\":\"txtDocumentation\",\"type\":\"text\",\"text\":\"* Step README with usage, options and limitations:\\nhttps://github.com/sassoftware/sas-studio-custom-steps/tree/main/Quantum%20-%20Reservoir%20Computing\\n\\n* PROC QRUN and PROC HYPERTUNE: see the SAS Viya Platform Programming documentation for your release.\",\"visible\":\"\"}]},{\"id\":\"secChangelog\",\"type\":\"section\",\"label\":\"Changelog\",\"open\":true,\"visible\":\"\",\"children\":[{\"id\":\"txtChangelog\",\"type\":\"text\",\"text\":\"* Version 1.0 (17NOV2026)\\n   - Initial version.\",\"visible\":\"\"}]}]}],\"syntaxversion\":\"1.3.0\",\"values\":{\"inputtable1\":{\"library\":\"\",\"table\":\"\"},\"SampleRate\":100,\"Mode\":{\"value\":\"quantumlab\",\"label\":\"Manual (specify quantum circuit parameters)\"},\"outputDS\":false,\"outputtable1\":{\"library\":\"\",\"table\":\"\"},\"replaceOutput\":true,\"CircuitType\":{\"value\":\"ENTANGLED\",\"label\":\"Entangled\"},\"list1\":[{\"value\":\"Entangled\"}],\"NumQubits\":6,\"MinQubits\":6,\"MaxQubits\":6,\"ml_algorithm\":{\"value\":\"none\",\"label\":\"None (skip ML comparison)\"},\"ml_algorithm_ht\":{\"value\":\"svm\",\"label\":\"Support Vector Machine (SVM)\"},\"C_param\":0.07,\"K_par\":0.2,\"CMin\":0.0001,\"CMax\":2,\"GammaMin\":0.1,\"GammaMax\":0.3,\"cutoff_param\":0.5,\"log_select_method\":{\"value\":\"stepwise\",\"label\":\"Stepwise\"},\"cutoff_min\":0.3,\"cutoff_max\":0.7,\"GB_NTrees\":100,\"GB_LearnRate\":0.1,\"GB_MaxDepth\":3,\"GB_MinLeaf\":1,\"GB_NTreesMin\":50,\"GB_NTreesMax\":300,\"GB_LearnRateMin\":0.01,\"GB_LearnRateMax\":0.3,\"GB_MaxDepthMin\":2,\"GB_MaxDepthMax\":10,\"GB_MinLeafMin\":1,\"GB_MinLeafMax\":20,\"RF_NTrees\":50,\"RF_IntervalBins\":20,\"RF_MinLeaf\":5,\"RF_NTreesMin\":20,\"RF_NTreesMax\":300,\"RF_IntervalBinsMin\":5,\"RF_IntervalBinsMax\":100,\"RF_MinLeafMin\":1,\"RF_MinLeafMax\":50,\"NumTrials\":5,\"UseCache\":false,\"NumParallel\":4,\"SimMethod\":{\"value\":\"automatic\",\"label\":\"Automatic (recommended; selects best based on qubit count)\"},\"LabelNoiseRate\":0,\"HeatMap\":true}}","localUi":"{\"pages\":[{\"children\":[{\"id\":\"inputtable1\",\"label\":\"Input data:\",\"placeholder\":\"\",\"required\":true,\"type\":\"inputtable\",\"visible\":\"\"},{\"id\":\"SampleRate\",\"integer\":true,\"label\":\"Downsample (percent of rows to use):\",\"max\":100,\"min\":1,\"type\":\"numberfield\",\"visible\":\"\"},{\"id\":\"Mode\",\"items\":[{\"label\":\"Manual (specify quantum circuit parameters)\",\"value\":\"quantumlab\"},{\"label\":\"Hypertune (optimize quantum circuit parameters)\",\"value\":\"autotune\"}],\"label\":\"Mode:\",\"type\":\"radiogroup\",\"visible\":\"\"},{\"children\":[{\"id\":\"outputDS\",\"label\":\"Save output data\",\"type\":\"checkbox\",\"visible\":\"\"},{\"id\":\"outputtable1\",\"indent\":1,\"label\":\"Output table (QRC-transformed data):\",\"placeholder\":\"\",\"required\":false,\"type\":\"outputtable\",\"visible\":\"$outputDS\"},{\"id\":\"text5\",\"indent\":1,\"text\":\"Note: When running this step in a flow, you must add an output port for this optional table on the step node.\",\"type\":\"text\",\"visible\":\"$outputDS\"},{\"id\":\"replaceOutput\",\"indent\":1,\"label\":\"Replace existing output table\",\"type\":\"checkbox\",\"visible\":\"$outputDS\"}],\"id\":\"section1\",\"label\":\"Output\",\"open\":true,\"type\":\"section\",\"visible\":\"\"}],\"id\":\"pageData\",\"label\":\"Data\",\"type\":\"page\"},{\"children\":[{\"id\":\"CircuitType\",\"items\":[{\"label\":\"Linear\",\"value\":\"LINEAR\"},{\"label\":\"Entangled\",\"value\":\"ENTANGLED\"},{\"label\":\"Nonlinear\",\"value\":\"NONLINEAR\"},{\"label\":\"Recurrent feedback\",\"value\":\"RECURRENTFEEDBACK\"},{\"label\":\"Parametric\",\"value\":\"PARAMETRIC\"},{\"label\":\"Sparse connectivity\",\"value\":\"SPARSECONNECTIVITY\"}],\"label\":\"Circuit type:\",\"type\":\"radiogroup\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"list1\",\"items\":[{\"value\":\"Linear\"},{\"value\":\"Entangled\"},{\"value\":\"Nonlinear\"},{\"value\":\"Recurrent feedback\"},{\"value\":\"Parametric\"},{\"value\":\"Sparse connectivity\"}],\"label\":\"Circuit types:\",\"max\":null,\"min\":1,\"type\":\"list\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"txtCircuitAutoQX\",\"indent\":1,\"text\":\"Hypertune mode uses PROC HYPERTUNE to search the selected circuit types, the qubit range, and SVM parameters on a log scale, uses the cache when enabled, and renders the champion PROC QRUN reservoir.\",\"type\":\"text\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"NumQubits\",\"integer\":true,\"label\":\"Number of qubits:\",\"max\":30,\"min\":4,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"txtQubitsManual\",\"indent\":1,\"text\":\"Note: Runtime grows exponentially with qubit count, and the number of quantum features grows quadratically. The log warns about large settings.\",\"type\":\"text\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"MinQubits\",\"integer\":true,\"label\":\"Minimum qubits:\",\"max\":30,\"min\":4,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"MaxQubits\",\"integer\":true,\"label\":\"Maximum qubits:\",\"max\":30,\"min\":4,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"txtQubitsAutoQX\",\"indent\":1,\"text\":\"PROC HYPERTUNE searches this inclusive qubit range, and the final graphs use the champion circuit type and qubit count. Each circuit and qubit combination builds a reservoir before the search, so wide ranges take longer.\",\"type\":\"text\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"ml_algorithm\",\"items\":[{\"label\":\"None (skip ML comparison)\",\"value\":\"none\"},{\"label\":\"Support Vector Machine (SVM)\",\"value\":\"svm\"},{\"label\":\"Logistic regression\",\"value\":\"logistic regression\"},{\"label\":\"Log select\",\"value\":\"log select\"},{\"label\":\"Gradient boosting\",\"value\":\"grad boost\"},{\"label\":\"Random forest\",\"value\":\"random forest\"}],\"label\":\"Machine learning algorithm:\",\"type\":\"radiogroup\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"enabled\":false,\"id\":\"ml_algorithm_ht\",\"items\":[{\"label\":\"None (skip ML comparison)\",\"value\":\"none\"},{\"label\":\"Support Vector Machine (SVM)\",\"value\":\"svm\"},{\"label\":\"Logistic regression\",\"value\":\"logistic regression\"},{\"label\":\"Log select\",\"value\":\"log select\"},{\"label\":\"Gradient boosting\",\"value\":\"grad boost\"},{\"label\":\"Random forest\",\"value\":\"random forest\"}],\"label\":\"Machine learning algorithm:\",\"type\":\"radiogroup\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"children\":[{\"id\":\"C_param\",\"integer\":false,\"label\":\"C (regularization strength):\",\"max\":1000000,\"min\":0.0001,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"K_par\",\"integer\":false,\"label\":\"Gamma (kernel bandwidth):\",\"max\":1000000,\"min\":0.0001,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"CMin\",\"integer\":false,\"label\":\"C minimum:\",\"max\":1000000,\"min\":0.0001,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"CMax\",\"integer\":false,\"label\":\"C maximum:\",\"max\":1000000,\"min\":0.0001,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GammaMin\",\"integer\":false,\"label\":\"Gamma minimum:\",\"max\":1000000,\"min\":0.0001,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GammaMax\",\"integer\":false,\"label\":\"Gamma maximum:\",\"max\":1000000,\"min\":0.0001,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]}],\"id\":\"secSVMParams\",\"indent\":1,\"label\":\"Support Vector Machine (SVM) parameters\",\"open\":true,\"type\":\"section\",\"visible\":[[\"$ml_algorithm\",\"=\",\"svm\"],\"|\",[\"$Mode\",\"=\",\"autotune\"]]},{\"children\":[{\"id\":\"cutoff_param\",\"integer\":false,\"label\":\"Classification threshold:\",\"max\":1,\"min\":0,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"log_select_method\",\"items\":[{\"label\":\"Forward\",\"value\":\"forward\"},{\"label\":\"Backward\",\"value\":\"backward\"},{\"label\":\"Stepwise\",\"value\":\"stepwise\"}],\"label\":\"Variable selection method:\",\"type\":\"radiogroup\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"txtLogSelectNote\",\"type\":\"text\",\"text\":\"The variable selection method is not applied. Logistic regression and Log select both fit all predictors; only the classification threshold applies.\",\"visible\":\"\"},{\"id\":\"cutoff_min\",\"integer\":false,\"label\":\"Classification threshold minimum:\",\"max\":1,\"min\":0,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"cutoff_max\",\"integer\":false,\"label\":\"Classification threshold maximum:\",\"max\":1,\"min\":0,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]}],\"id\":\"secLogSelectParams\",\"indent\":1,\"label\":\"Logistic model parameters\",\"open\":true,\"type\":\"section\",\"visible\":[[[\"$ml_algorithm\",\"=\",\"log select\"],\"|\",[\"$ml_algorithm\",\"=\",\"logistic regression\"]],\"&\",[\"$Mode\",\"=\",\"quantumlab\"]]},{\"children\":[{\"id\":\"txtGradBoostNote\",\"type\":\"text\",\"text\":\"These settings are not applied. Gradient boosting runs with procedure defaults.\",\"visible\":\"\"},{\"id\":\"GB_NTrees\",\"integer\":true,\"label\":\"Number of trees:\",\"max\":1000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"GB_LearnRate\",\"integer\":false,\"label\":\"Learning rate:\",\"max\":1,\"min\":0.0001,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"GB_MaxDepth\",\"integer\":true,\"label\":\"Maximum depth:\",\"max\":50,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"GB_MinLeaf\",\"integer\":true,\"label\":\"Minimum leaf size:\",\"max\":10000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"GB_NTreesMin\",\"integer\":true,\"label\":\"Minimum number of trees:\",\"max\":1000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_NTreesMax\",\"integer\":true,\"label\":\"Maximum number of trees:\",\"max\":1000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_LearnRateMin\",\"integer\":false,\"label\":\"Minimum learning rate:\",\"max\":1,\"min\":0.0001,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_LearnRateMax\",\"integer\":false,\"label\":\"Maximum learning rate:\",\"max\":1,\"min\":0.0001,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_MaxDepthMin\",\"integer\":true,\"label\":\"Minimum for maximum depth:\",\"max\":50,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_MaxDepthMax\",\"integer\":true,\"label\":\"Maximum for maximum depth:\",\"max\":50,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_MinLeafMin\",\"integer\":true,\"label\":\"Minimum for minimum leaf size:\",\"max\":10000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"GB_MinLeafMax\",\"integer\":true,\"label\":\"Maximum for minimum leaf size:\",\"max\":10000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]}],\"id\":\"secGradBoostParams\",\"indent\":1,\"label\":\"Gradient boosting parameters\",\"open\":true,\"type\":\"section\",\"visible\":[[\"$ml_algorithm\",\"=\",\"grad boost\"],\"&\",[\"$Mode\",\"=\",\"quantumlab\"]]},{\"children\":[{\"id\":\"txtForestNote\",\"type\":\"text\",\"text\":\"These settings are not applied. Random forest runs with procedure defaults.\",\"visible\":\"\"},{\"id\":\"RF_NTrees\",\"integer\":true,\"label\":\"Number of trees:\",\"max\":2000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"RF_IntervalBins\",\"integer\":true,\"label\":\"Interval bins:\",\"max\":200,\"min\":2,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"RF_MinLeaf\",\"integer\":true,\"label\":\"Minimum leaf size:\",\"max\":10000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"quantumlab\"]},{\"id\":\"RF_NTreesMin\",\"integer\":true,\"label\":\"Minimum number of trees:\",\"max\":2000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"RF_NTreesMax\",\"integer\":true,\"label\":\"Maximum number of trees:\",\"max\":2000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"RF_IntervalBinsMin\",\"integer\":true,\"label\":\"Minimum interval bins:\",\"max\":200,\"min\":2,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"RF_IntervalBinsMax\",\"integer\":true,\"label\":\"Maximum interval bins:\",\"max\":200,\"min\":2,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"RF_MinLeafMin\",\"integer\":true,\"label\":\"Minimum for minimum leaf size:\",\"max\":10000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"id\":\"RF_MinLeafMax\",\"integer\":true,\"label\":\"Maximum for minimum leaf size:\",\"max\":10000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]}],\"id\":\"secForestParams\",\"indent\":1,\"label\":\"Random forest parameters\",\"open\":true,\"type\":\"section\",\"visible\":[[\"$ml_algorithm\",\"=\",\"random forest\"],\"&\",[\"$Mode\",\"=\",\"quantumlab\"]]}],\"id\":\"pageQRC\",\"label\":\"QRC Options\",\"type\":\"page\"},{\"children\":[{\"id\":\"NumTrials\",\"integer\":true,\"label\":\"Number of PROC HYPERTUNE trials:\",\"max\":5000,\"min\":1,\"type\":\"numberfield\",\"visible\":[\"$Mode\",\"=\",\"autotune\"]},{\"children\":[{\"id\":\"UseCache\",\"label\":\"Use cache\",\"type\":\"checkbox\",\"visible\":\"\"},{\"id\":\"txtCache\",\"indent\":1,\"text\":\"Reuses the PROC HYPERTUNE CACHEOUT table from the current SAS Data and AI Studio session when available. Off by default, so each run starts a fresh search. The cache resets automatically when the circuit types, input table, Downsample, label noise, or simulation method changes.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"secCache\",\"label\":\"Cache\",\"open\":true,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"NumParallel\",\"integer\":true,\"label\":\"Number of parallel cores:\",\"max\":64,\"min\":1,\"type\":\"numberfield\",\"visible\":\"\"}],\"id\":\"secParallel\",\"label\":\"Parallelism\",\"open\":true,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"SimMethod\",\"items\":[{\"label\":\"Automatic (recommended; selects best based on qubit count)\",\"value\":\"automatic\"},{\"label\":\"Statevector (exact; memory-intensive; good for up to ~20 qubits)\",\"value\":\"statevector\"},{\"label\":\"MPS/tensor-network (handles larger circuits approximately)\",\"value\":\"mps\"}],\"label\":\"Method:\",\"type\":\"radiogroup\",\"visible\":\"\"}],\"id\":\"secSimMethod\",\"label\":\"Simulation method\",\"open\":true,\"type\":\"section\",\"visible\":\"\"},{\"id\":\"LabelNoiseRate\",\"integer\":false,\"label\":\"Binary label noise rate:\",\"max\":1,\"min\":0,\"type\":\"numberfield\",\"visible\":\"\"},{\"id\":\"txtLabelNoiseRate\",\"indent\":1,\"text\":\"Applies SAS-side label noise only when Y is binary 0/1. Default is 0; increase only for stress testing.\",\"type\":\"text\",\"visible\":\"\"},{\"id\":\"HeatMap\",\"label\":\"Show classical, QRC, and combined correlation heatmaps\",\"type\":\"checkbox\",\"visible\":\"\"},{\"id\":\"txtHeatMap\",\"indent\":1,\"text\":\"Produces preview output plus Classical, QRC, and Combined feature-correlation heatmaps using SAS procedures.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"pageAdvanced\",\"label\":\"Advanced Simulation\",\"type\":\"page\"},{\"children\":[{\"id\":\"txtAbout\",\"text\":\"Quantum - Reservoir Computing\\n==========================\\n\\nTransforms tabular data into quantum reservoir features, then compares how well Classical, Quantum (QRC), and Combined features predict a target.\\n\\nPipeline\\n---------\\n1. Optionally downsample the input.\\n2. Standardize numeric predictors and project them onto one angle per qubit.\\n3. Build an OpenQASM 3 reservoir circuit and simulate it with PROC QRUN.\\n4. Measure single-qubit and neighboring two-qubit Z expectation values.\\n5. Add pairwise products of those expectation values.\\n6. Write three feature sets: Classical, Quantum (QRC), and Combined.\\n7. Optionally train a model on each feature set and report accuracy.\\n\\nModes\\n-------\\n* Manual: Runs one reservoir with the circuit type, qubit count, and simulation method you choose.\\n* Hypertune: Uses PROC HYPERTUNE to search the selected Circuit types, the qubit range, and SVM C and gamma (log10 scale). The machine learning algorithm is fixed to SVM. The final circuit display, accuracy comparison, output data, and context JSON are regenerated from the winning reservoir.\\n* Hypertune implementation: Uses SAS SUBMIT objectives with CACHEIN, CACHEOUT, and PRIMALOUT datasets, and Number of parallel cores (NumParallel) for parallel evaluations. It does not use the original Python AutoQX optimizer or external Python cache.\\n\\nInput data\\n-----------\\n* Use numeric predictors and a target named y or target (case-insensitive). If both exist, y is used.\\n* If neither exists, a placeholder y of 0 is created, so the ML comparison is not meaningful.\\n* Missing numeric target values are set to 0.\\n\\nOutput\\n--------\\n* Output port: Select Save output data and specify an output table to write the Combined feature table. Select Replace existing output table to overwrite an existing table; otherwise the step stops with an error before running if the table exists. Columns are x0, x1, and so on (classical projections followed by quantum features), plus y.\\n* Results window: Champion circuit display, runtime summary, and, when a machine learning algorithm is selected, an accuracy table and bar chart for Classical, Quantum, and Quantum+Classical features. Correlation heatmaps appear when selected.\\n* Files in the SAS session working directory, each with a unique run identifier: classical_*.csv, qrc_*.csv, combined_*.csv, accuracy_*.csv, circuit_*.qasm3, and agent_context_*.json (run settings and file names).\\n* Cleanup: The step deletes its temporary _qrc_ tables, global macro variables, and macros, and restores MLOGIC, MPRINT, and SYMBOLGEN. With Use cache selected, the PROC HYPERTUNE cache table is kept.\\n\\nSimulation methods\\n----------------------\\n* Automatic: Uses the PROC QRUN default method.\\n* Statevector: Sets SIMMETHOD=STATEVECTOR.\\n* MPS: Sets SIMMETHOD=MPS.\\n\\nQuantum simulation has no simulated gate or hardware noise. Optional binary label noise affects only classification targets, not the quantum circuit.\\n\\nMachine learning algorithms\\n-------------------------------\\n* Manual mode offers None (skip ML comparison), Support Vector Machine (SVM), Logistic regression, Log select, Gradient boosting, and Random forest.\\n* Hypertune mode is fixed to SVM.\\n* See Limitations for how accuracy is measured and which model settings are applied.\\n\",\"type\":\"text\",\"visible\":\"\"},{\"id\":\"secLimitations\",\"type\":\"section\",\"label\":\"Limitations\",\"open\":false,\"visible\":\"\",\"children\":[{\"id\":\"txtLimitations\",\"type\":\"text\",\"visible\":\"\",\"text\":\"* Reported accuracy is training accuracy, not held-out accuracy. For a binary target, the SVM result is the better of the SVM and a nearest-centroid classifier.\\n* Simulation method: Statevector and MPS set SIMMETHOD= on PROC QRUN. Automatic uses the default method.\\n* Hypertune: Hypertune always tunes SVM. Classification threshold, gradient boosting, and random forest bounds are not searched.\\n* Gradient boosting, random forest, and logistic selection: These models run with procedure defaults. Tree and forest parameters and the variable selection method on QRC Options are not applied. Logistic regression and Log select run the same model; only the threshold applies.\\n* Hypertune circuits: Hypertune searches the circuits selected in Circuit types. If none is selected, it uses Entangled.\\n* Hypertune cache: With Use cache selected, the cache resets when the circuit list, input table name or row count, Downsample, label noise, or simulation method changes. It cannot detect changed values in a table with the same name and row count.\\n* Noiseless simulation: Quantum simulation has no simulated gate or hardware noise. Expectation values are computed from the simulated state without measurement-shot sampling. Optional binary label noise affects only classification targets, not the quantum circuit.\\n* Binary label noise: Applies only when y contains both 0 and 1. Each label is flipped with the specified probability, using seed 42. Default 0 leaves labels unchanged. Modified labels are used by all three feature sets and Hypertune. The SAS log reports whether label noise was applied or skipped.\\n* Qubit count: The number of projected predictors is the smaller of the qubit count and the number of numeric predictors. Extra qubits receive an angle of 0.\\n* Large settings: The step does not limit the qubit count. It writes a warning to the log for more than 20 qubits without MPS, more than 500 quantum features per row, or more than 12 Hypertune candidate reservoirs. The feature count grows quadratically with the qubit count.\"}]},{\"children\":[{\"id\":\"txtPrereqs\",\"text\":\"* SAS Viya with SAS Data and AI Studio Flows.\\n* A release that includes PROC QRUN (SAS Quantum Lab) and PROC HYPERTUNE.\\n* An active CAS session. The step assigns a qrun CAS library, starting a qrun_session if needed.\\n* Numeric predictor columns and a y or target column.\\n* A Python environment configured for PROC HYPERTUNE.\\n\\nTested on Viya version 2026.11.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"secPrereqs\",\"label\":\"Pre-requisites\",\"open\":false,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"txtDocumentation\",\"text\":\"* Step README with usage, options and limitations:\\nhttps://github.com/sassoftware/sas-studio-custom-steps/tree/main/Quantum%20-%20Reservoir%20Computing\\n\\n* PROC QRUN and PROC HYPERTUNE: see the SAS Viya Platform Programming documentation for your release.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"secDocumentation\",\"label\":\"Documentation\",\"open\":false,\"type\":\"section\",\"visible\":\"\"},{\"children\":[{\"id\":\"txtChangelog\",\"text\":\"* Version 1.0 (17NOV2026)\\n   - Initial version.\",\"type\":\"text\",\"visible\":\"\"}],\"id\":\"secChangelog\",\"label\":\"Changelog\",\"open\":true,\"type\":\"section\",\"visible\":\"\"}],\"id\":\"pageAbout\",\"label\":\"About\",\"type\":\"page\"}],\"showPageContentOnly\":true,\"syntaxversion\":\"1.3.0\",\"values\":{\"CMax\":2,\"CMin\":0.0001,\"C_param\":0.07,\"CircuitType\":{\"label\":\"Entangled\",\"value\":\"ENTANGLED\"},\"GB_LearnRate\":0.1,\"GB_LearnRateMax\":0.3,\"GB_LearnRateMin\":0.01,\"GB_MaxDepth\":3,\"GB_MaxDepthMax\":10,\"GB_MaxDepthMin\":2,\"GB_MinLeaf\":1,\"GB_MinLeafMax\":20,\"GB_MinLeafMin\":1,\"GB_NTrees\":100,\"GB_NTreesMax\":300,\"GB_NTreesMin\":50,\"GammaMax\":0.3,\"GammaMin\":0.1,\"HeatMap\":true,\"K_par\":0.2,\"LabelNoiseRate\":0,\"MaxQubits\":6,\"MinQubits\":6,\"Mode\":{\"label\":\"Manual (specify quantum circuit parameters)\",\"value\":\"quantumlab\"},\"NumParallel\":4,\"NumQubits\":6,\"NumTrials\":5,\"RF_IntervalBins\":20,\"RF_IntervalBinsMax\":100,\"RF_IntervalBinsMin\":5,\"RF_MinLeaf\":5,\"RF_MinLeafMax\":50,\"RF_MinLeafMin\":1,\"RF_NTrees\":50,\"RF_NTreesMax\":300,\"RF_NTreesMin\":20,\"SampleRate\":100,\"SimMethod\":{\"label\":\"Automatic (recommended; selects best based on qubit count)\",\"value\":\"automatic\"},\"UseCache\":false,\"cutoff_max\":0.7,\"cutoff_min\":0.3,\"cutoff_param\":0.5,\"inputtable1\":{\"library\":\"\",\"table\":\"\"},\"list1\":[{\"value\":\"Entangled\"}],\"log_select_method\":{\"label\":\"Stepwise\",\"value\":\"stepwise\"},\"ml_algorithm\":{\"label\":\"None (skip ML comparison)\",\"value\":\"none\"},\"ml_algorithm_ht\":{\"label\":\"Support Vector Machine (SVM)\",\"value\":\"svm\"},\"outputDS\":false,\"outputtable1\":{\"library\":\"\",\"table\":\"\"},\"replaceOutput\":true}}","templates":{"SAS":"/*=============================================================================\n * QuantumQRC custom step - SAS-only PROC QRUN Householder refactor\n *\n * This variant uses SAS plus PROC QRUN for circuit display and reservoir\n * simulation. Classical feature scores are standardized, mean-imputed when\n * needed, reflected with a reproducible Householder transformation, and kept\n * under the historical Prin1, Prin2, ... variable contract.\n *\n * Maintenance map:\n *   1. _qrc_downsample writes the selected SAS table to a run-local CSV.\n *   2. q_build_circuit emits OpenQASM and stores the circuit in WORK for QRUN.\n *   3. q_run_reservoir converts numeric predictors to theta parameters, runs\n *      PROC QRUN, and writes Classical, QRC, and Combined feature CSVs.\n *   4. AutoTune precomputes one Combined table for each candidate qubit count.\n *   5. PROC HYPERTUNE searches circuit type, qubit count plus SVM C/gamma on log10 scales.\n *   6. The champion reservoir is regenerated so graphs/output match the best\n *      model, not merely the last candidate evaluated during tuning.\n *   7. Run-local tables, global macro variables and macros are removed; the\n *      changed log options are restored at the end.\n *============================================================================*/\n\n/* region: Run setup */\n%macro _qrc_main;\n%local _qrc_mlogic _qrc_mprint _qrc_symbolgen _qrc_keep_cache _qrc_drop_list;\n%let _qrc_mlogic = %sysfunc(getoption(mlogic));\n%let _qrc_mprint = %sysfunc(getoption(mprint));\n%let _qrc_symbolgen = %sysfunc(getoption(symbolgen));\noptions nomlogic nomprint nosymbolgen;\n%global base _qrc_uuid _qrc_csv _classical_csv _combined_csv _qasm_work_path;\n  %put NOTE: Starting QuantumQRC PROC HYPERTUNE refactor (Mode=&Mode).;\n\n/* region: Input validation */\n/* ---- Studio checkboxes arrive as 1/0; accept the common truthy spellings. ---- */\n%macro _qrc_is_true(value);\n  %local _v;\n  %let _v = %upcase(%superq(value));\n  %eval(\"&_v\" = \"1\" or \"&_v\" = \"Y\" or \"&_v\" = \"YES\" or \"&_v\" = \"TRUE\")\n%mend _qrc_is_true;\n\n/* ---- Fail fast on output-table errors; warn about expensive qubit settings. ---- */\n%macro _qrc_validate;\n  %local _vqmin _vqmax _vsim _vnc _vruns _vfeat;\n  %global _qrc_invalid;\n  %let _qrc_invalid = 0;\n\n  %if %_qrc_is_true(%superq(outputDS)) %then %do;\n    %if %sysevalf(%superq(outputtable1)=, boolean) %then %do;\n      %put ERROR: Save output data is selected, but no output table was specified.;\n      %let _qrc_invalid = 1;\n    %end;\n    %else %if %sysfunc(exist(%superq(outputtable1))) and not %_qrc_is_true(%superq(replaceOutput)) %then %do;\n      %put ERROR: The output table %superq(outputtable1) already exists. Select Replace existing output table or specify a different table.;\n      %let _qrc_invalid = 1;\n    %end;\n  %end;\n\n  %let _vsim = %upcase(%sysfunc(compress(%sysfunc(coalescec(%superq(SimMethod), automatic)), _)));\n  %if %upcase(%superq(Mode)) = AUTOTUNE %then %do;\n    %let _vqmin = %sysfunc(coalescec(%superq(MinQubits), %superq(NumQubits), 4));\n    %let _vqmax = %sysfunc(coalescec(%superq(MaxQubits), &_vqmin));\n    %if %sysevalf(&_vqmax < &_vqmin, boolean) %then %let _vqmax = &_vqmin;\n    %let _vnc = 0;\n    %if %symexist(list1_count) %then %let _vnc = %sysfunc(inputn(%sysfunc(coalescec(%superq(list1_count), 0)), best.));\n    %if %sysevalf(&_vnc < 1, boolean) %then %let _vnc = 1;\n    %let _vruns = %eval(&_vnc * (&_vqmax - &_vqmin + 1));\n    %if &_vruns > 12 %then\n      %put WARNING: Hypertune will build &_vruns candidate reservoirs (&_vnc circuit types x qubit range &_vqmin-&_vqmax) before searching. Narrow the circuit list or qubit range to shorten the run.;\n  %end;\n  %else %let _vqmax = %sysfunc(coalescec(%superq(NumQubits), 4));\n\n  %if %sysevalf(&_vqmax > 20, boolean) and \"&_vsim\" ne \"MPS\" %then\n    %put WARNING: &_vqmax qubits with Simulation method %superq(SimMethod) may exhaust memory. MPS is recommended above 20 qubits.;\n  %let _vfeat = %eval(&_vqmax * (2 * &_vqmax - 1));\n  %if &_vfeat > 500 %then\n    %put WARNING: &_vqmax qubits produce &_vfeat quantum features per row. Runtime and memory grow quickly.;\n%mend _qrc_validate;\n\n%_qrc_validate;\n%if &_qrc_invalid = 1 %then %do;\n  options &_qrc_mlogic &_qrc_mprint &_qrc_symbolgen;\n  %put ERROR: QuantumQRC stopped before running because of the errors above.;\n  %return;\n%end;\n/* endregion */\n\n/* ---- Resolve run identity and output location once for all downstream files. ---- */\n%let _user = &_clientuserid;\n%if &_user= %then %let _user = unknown;\ndata _null_;\n  dt = datetime();\n  ts = cats(put(year(datepart(dt)), z4.),\n            put(month(datepart(dt)), z2.),\n            put(day(datepart(dt)), z2.),\n            put(hour(timepart(dt)), z2.),\n            put(minute(timepart(dt)), z2.),\n            put(int(second(timepart(dt))), z2.));\n  call symputx('_timestamp', ts, 'L');\nrun;\n%let _output_dir_name = current_files_&_user._&_timestamp;\n%let _sandbox_base = ;\ndata _null_;\n  length _cwd $500;\n  rc = filename('_qrcout', '.');\n  if rc = 0 then do;\n    _cwd = pathname('_qrcout');\n    call symputx('base', _cwd, 'G');\n    put \"NOTE: Using current active directory for QRC outputs: \" _cwd;\n  end;\n  else put \"ERROR: Failed to assign _qrcout fileref for QRC outputs.\";\nrun;\n\n/* ---- Unique run ID used in filenames so parallel Studio runs do not collide. ---- */\ndata _null_;\n  _s1 = datetime() * 100 + ranuni(0) * 1e9;\n  _p1 = put(mod(abs(_s1), 2**31), hex8.);\n  _s2 = input(symget('SYSJOBID'), ?? best32.);\n  if _s2 = . then _s2 = 0;\n  _p2 = put(mod(abs(_s2 * 1e6 + ranuni(0) * 1e9), 2**31), hex8.);\n  call symputx('_qrc_uuid', cats(_p1, _p2), 'G');\nrun;\n%let _data_csv = _qrcdat;\nfilename &_data_csv \"qrc_input_data_&_qrc_uuid..csv\";\n\n/* endregion */\n/* region: Circuit generation */\n/* ---- Build a parameterized OpenQASM 3 reservoir circuit in SAS. ---- */\n%macro q_build_circuit(num_qubits=, circuit_type=, qasm_path=, show_diagram=1);\n  %local _ctype;\n  %global _qrc_circuit_ds;\n  %let _ctype = %upcase(%sysfunc(compress(%superq(circuit_type), %str( ))));\n  %let _qrc_circuit_ds = work._qrc_circuit_&_qrc_uuid;\n\n  %if %length(&num_qubits) = 0 %then %do;\n    %put ERROR: q_build_circuit: num_qubits is required.;\n    %return;\n  %end;\n  %if %length(&qasm_path) = 0 %then %do;\n    %put ERROR: q_build_circuit: qasm_path is required.;\n    %return;\n  %end;\n\n  data &_qrc_circuit_ds;\n    length _qasm_ $32767 _line $512;\n    retain _qasm_ '';\n    n = &num_qubits;\n    ctype = \"&_ctype\";\n\n    _qasm_ = catx('0A'x, _qasm_, 'OPENQASM 3.0;');\n    _qasm_ = catx('0A'x, _qasm_, 'include \"stdgates.inc\";');\n    do i = 0 to n - 1;\n      _line = cats('input float[64] theta', i, ';');\n      _qasm_ = catx('0A'x, _qasm_, _line);\n    end;\n    _qasm_ = catx('0A'x, _qasm_, cats('qubit[', n, '] q;'), '');\n\n    if ctype = 'RECURRENTFEEDBACK' then do;\n      do i = 0 to n - 1;\n        _qasm_ = catx('0A'x, _qasm_, cats('h q[', i, '];'));\n      end;\n      _qasm_ = catx('0A'x, _qasm_, '');\n      do cycle = 1 to 3;\n        _qasm_ = catx('0A'x, _qasm_, cats('// Recurrent cycle ', cycle));\n        do i = 0 to n - 1;\n          if mod(i, 2) = 0 then _line = cats('rz(theta', i, ') q[', i, '];');\n          else _line = cats('ry(theta', i, ') q[', i, '];');\n          _qasm_ = catx('0A'x, _qasm_, _line);\n        end;\n        _qasm_ = catx('0A'x, _qasm_, '');\n        do i = 0 to n - 2;\n          _qasm_ = catx('0A'x, _qasm_, cats('cz q[', i, '], q[', i + 1, '];'));\n        end;\n        _qasm_ = catx('0A'x, _qasm_, '');\n        if cycle < 3 then do;\n          do i = 0 to n - 1;\n            _qasm_ = catx('0A'x, _qasm_, cats('h q[', i, '];'));\n          end;\n          _qasm_ = catx('0A'x, _qasm_, '');\n        end;\n      end;\n      j = max(0, floor(n / 2) - 1);\n      _qasm_ = catx('0A'x, _qasm_, cats('rz(0.4) q[', j, '];'));\n      if n > 1 then _qasm_ = catx('0A'x, _qasm_, cats('cz q[0], q[', n - 1, '];'));\n    end;\n    else do;\n      do i = 0 to n - 1;\n        _qasm_ = catx('0A'x, _qasm_, cats('h q[', i, '];'));\n      end;\n      _qasm_ = catx('0A'x, _qasm_, '');\n      do i = 0 to n - 1;\n        if mod(i, 2) = 0 then _line = cats('rz(theta', i, ') q[', i, '];');\n        else _line = cats('ry(theta', i, ') q[', i, '];');\n        _qasm_ = catx('0A'x, _qasm_, _line);\n      end;\n      _qasm_ = catx('0A'x, _qasm_, '');\n\n      select (ctype);\n        when ('LINEAR') _qasm_ = catx('0A'x, _qasm_, '// (no entangling gates)');\n        when ('NONLINEAR') do;\n          do i = 0 to n - 2 by 2;\n            _qasm_ = catx('0A'x, _qasm_, cats('cz q[', i, '], q[', i + 1, '];'));\n          end;\n          do i = 1 to n - 2 by 2;\n            _qasm_ = catx('0A'x, _qasm_, cats('cz q[', i, '], q[', i + 1, '];'));\n          end;\n          if n > 1 then _qasm_ = catx('0A'x, _qasm_, cats('cz q[0], q[', n - 1, '];'));\n          _qasm_ = catx('0A'x, _qasm_, '');\n          do i = 0 to n - 1;\n            _qasm_ = catx('0A'x, _qasm_, cats('rx(0.785398) q[', i, '];'));\n          end;\n        end;\n        when ('PARAMETRIC') do;\n          do i = 0 to n - 2;\n            _qasm_ = catx('0A'x, _qasm_, cats('crz(theta', i, ') q[', i, '], q[', i + 1, '];'));\n          end;\n        end;\n        when ('SPARSECONNECTIVITY') do;\n          do i = 0 to n - 2 by 3;\n            j = min(i + 3, n - 1);\n            if i ne j then _qasm_ = catx('0A'x, _qasm_, cats('cz q[', i, '], q[', j, '];'));\n          end;\n          if n >= 4 then _qasm_ = catx('0A'x, _qasm_, cats('cz q[0], q[', n - 1, '];'));\n        end;\n        otherwise do;\n          do i = 0 to n - 2 by 2;\n            _qasm_ = catx('0A'x, _qasm_, cats('cz q[', i, '], q[', i + 1, '];'));\n          end;\n          do i = 1 to n - 2 by 2;\n            _qasm_ = catx('0A'x, _qasm_, cats('cz q[', i, '], q[', i + 1, '];'));\n          end;\n          if n > 1 then _qasm_ = catx('0A'x, _qasm_, cats('cz q[0], q[', n - 1, '];'));\n          if n > 2 then _qasm_ = catx('0A'x, _qasm_, cats('cz q[0], q[', floor(n / 2), '];'));\n        end;\n      end;\n      _qasm_ = catx('0A'x, _qasm_, '');\n\n      do i = 0 to n - 1;\n        _qasm_ = catx('0A'x, _qasm_, cats('h q[', i, '];'));\n      end;\n      _qasm_ = catx('0A'x, _qasm_, '');\n      do i = 0 to n - 1;\n        if mod(i, 2) = 0 then _line = cats('rz(theta', i, ') q[', i, '];');\n        else _line = cats('ry(theta', i, ') q[', i, '];');\n        _qasm_ = catx('0A'x, _qasm_, _line);\n      end;\n      _qasm_ = catx('0A'x, _qasm_, '');\n\n      select (ctype);\n        when ('LINEAR') _qasm_ = catx('0A'x, _qasm_, '// (no entangling gates)');\n        when ('NONLINEAR') do;\n          do i = 0 to n - 2;\n            _qasm_ = catx('0A'x, _qasm_, cats('cz q[', i, '], q[', i + 1, '];'));\n          end;\n          _qasm_ = catx('0A'x, _qasm_, '');\n          do i = 0 to n - 1;\n            _qasm_ = catx('0A'x, _qasm_, cats('rx(0.523599) q[', i, '];'));\n          end;\n          if n > 1 then _qasm_ = catx('0A'x, _qasm_, cats('cz q[0], q[', n - 1, '];'));\n        end;\n        when ('PARAMETRIC') do;\n          do i = n - 1 to 1 by -1;\n            _qasm_ = catx('0A'x, _qasm_, cats('crz(theta', i, ') q[', i, '], q[', i - 1, '];'));\n          end;\n        end;\n        when ('SPARSECONNECTIVITY') do;\n          do i = 1 to n - 2 by 3;\n            j = min(i + 3, n - 1);\n            if i ne j then _qasm_ = catx('0A'x, _qasm_, cats('cz q[', i, '], q[', j, '];'));\n          end;\n        end;\n        otherwise do;\n          do i = 0 to n - 2;\n            _qasm_ = catx('0A'x, _qasm_, cats('cz q[', i, '], q[', i + 1, '];'));\n          end;\n          if n > 1 then _qasm_ = catx('0A'x, _qasm_, cats('cz q[0], q[', n - 1, '];'));\n        end;\n      end;\n      j = max(0, floor(n / 2) - 1);\n      _qasm_ = catx('0A'x, _qasm_, cats('rz(0.4) q[', j, '];'));\n    end;\n    output;\n    keep _qasm_;\n  run;\n\n  data _null_;\n    set &_qrc_circuit_ds;\n    file \"&qasm_path\" lrecl=32767;\n    put _qasm_;\n  run;\n\n/*   %if &show_diagram %then %do; */\n/*     proc qrun circuit=&_qrc_circuit_ds plots=circuit; */\n/*     run; */\n/*   %end; */\n%mend q_build_circuit;\n\n/* endregion */\n/* region: Feature score construction */\n/* ---- Build circuit parameter scores without PROC PRINCOMP. ---- */\n%macro _qrc_make_feature_scores(input_ds=, out_ds=, feature_vars=, target_dim=);\n  %local _i _srcvar _feature_count;\n\n  %if %sysevalf(%superq(feature_vars)=, boolean) %then %do;\n    %put ERROR: _qrc_make_feature_scores: feature_vars is required.;\n    %return;\n  %end;\n  %if %sysevalf(%superq(target_dim)=, boolean) %then %do;\n    %put ERROR: _qrc_make_feature_scores: target_dim is required.;\n    %return;\n  %end;\n\n  %let _feature_count = %sysfunc(countw(%superq(feature_vars), %str( )));\n  %if &_feature_count = 0 %then %do;\n    %put ERROR: _qrc_make_feature_scores: no numeric predictor variables were found.;\n    %return;\n  %end;\n\n  /*\n     SAS-only Householder projection:\n     - Keep the historical Prin1, Prin2, ... contract used by the original\n       PROC PRINCOMP-based workflow and by the downstream QRUN code.\n     - Standardize every numeric predictor before projection. Missing values\n       and zero-variance columns are mapped to standardized zero, equivalent\n       to mean imputation before scaling.\n     - Apply one reproducible Householder reflection using a fixed random unit\n       vector over the full predictor space, then keep the requested leading\n       target_dim coordinates for the circuit inputs.\n\n     To restore the PCA implementation later, replace the DATA step below with:\n\n       ods exclude all;\n       proc princomp data=&input_ds out=&out_ds n=&target_dim;\n         var &feature_vars;\n       run;\n       ods exclude none;\n\n       data &out_ds;\n         set &out_ds;\n         _obsid = _n_;\n       run;\n  */\n  proc sql noprint;\n    %do _i = 1 %to &_feature_count;\n      %let _srcvar = %scan(%superq(feature_vars), &_i, %str( ));\n      select mean(&_srcvar), std(&_srcvar)\n        into :_qrc_score_mean&_i trimmed, :_qrc_score_std&_i trimmed\n      from &input_ds;\n    %end;\n  quit;\n\n  data _null_;\n    call streaminit(271828);\n    array _qrc_hh_v[&_feature_count] _temporary_;\n    _qrc_hh_norm = 0;\n    do _qrc_i = 1 to dim(_qrc_hh_v);\n      _qrc_hh_v[_qrc_i] = rand('normal');\n      _qrc_hh_norm + (_qrc_hh_v[_qrc_i] * _qrc_hh_v[_qrc_i]);\n    end;\n    _qrc_hh_norm = sqrt(_qrc_hh_norm);\n    do _qrc_i = 1 to dim(_qrc_hh_v);\n      call symputx(cats('_qrc_hh_v', _qrc_i), _qrc_hh_v[_qrc_i] / _qrc_hh_norm, 'l');\n    end;\n  run;\n\n  data &out_ds;\n    set &input_ds;\n    _obsid = _n_;\n    _qrc_dot = 0;\n    %do _i = 1 %to &_feature_count;\n      %let _srcvar = %scan(%superq(feature_vars), &_i, %str( ));\n      _qrc_mean = input(symget(\"_qrc_score_mean&_i\"), best32.);\n      _qrc_std = input(symget(\"_qrc_score_std&_i\"), best32.);\n      if not missing(&_srcvar) and not missing(_qrc_std) and _qrc_std > 0 then\n        _qrc_z&_i = (&_srcvar - _qrc_mean) / _qrc_std;\n      else _qrc_z&_i = 0;\n      _qrc_v = input(symget(\"_qrc_hh_v&_i\"), best32.);\n      _qrc_dot + (_qrc_z&_i * _qrc_v);\n    %end;\n    %do _i = 1 %to &target_dim;\n      %if &_i <= &_feature_count %then %do;\n        _qrc_v = input(symget(\"_qrc_hh_v&_i\"), best32.);\n        Prin&_i = _qrc_z&_i - (2 * _qrc_dot * _qrc_v);\n      %end;\n      %else %do;\n        Prin&_i = 0;\n      %end;\n    %end;\n    drop _qrc:;\n    keep _obsid y Prin:;\n  run;\n%mend _qrc_make_feature_scores;\n\n/* endregion */\n/* region: Reservoir simulation */\n/* ---- Run reservoir features through PROC QRUN OBSERVE. ---- */\n%macro q_run_reservoir(data_path=, qasm_path=, n_parallel=1, output_suffix=, sim_method=automatic, username=, show_circuit=1);\n  %local _nq _feature_vars _target_dim _rename_scores _rename_qrc _paulis\n    _sim_uc _sim_opt _i _one_pauli _qrc_start _qrc_has_y _qrc_has_target\n    _qrc_target_name _qrc_target_type _qrc_feature_idx\n         _qrc_base_feature_count _qrc_j _label_noise_rate _label_levels _label_min _label_max;\n  %global _qrc_elapsed _qrc_wallclock;\n\n  %if %length(&data_path) = 0 %then %do;\n    %put ERROR: q_run_reservoir: data_path is required.;\n    %return;\n  %end;\n  %if %symexist(_qrc_circuit_ds) = 0 %then %do;\n    %put ERROR: q_run_reservoir: circuit dataset is missing. Run q_build_circuit first.;\n    %return;\n  %end;\n  %let _qrc_start = %sysfunc(datetime());\n\n  proc import datafile=&data_path out=work._qrc_input_raw dbms=csv replace;\n    getnames=yes;\n    guessingrows=max;\n  run;\n\n  data _null_;\n    set &_qrc_circuit_ds(obs=1);\n    call symputx('_nq', count(_qasm_, 'input float[64] theta'), 'L');\n  run;\n\n  proc contents data=work._qrc_input_raw out=work._qrc_input_vars(keep=name type varnum) noprint;\n  run;\n\n  proc sql noprint;\n    select count(*) into :_qrc_has_y trimmed\n    from work._qrc_input_vars\n    where upcase(name) = 'Y';\n\n    select count(*) into :_qrc_has_target trimmed\n    from work._qrc_input_vars\n    where upcase(name) = 'TARGET';\n\n    %let _qrc_target_name = ;\n    %let _qrc_target_type = ;\n    %if &_qrc_has_y > 0 %then %do;\n      select name, type into :_qrc_target_name trimmed, :_qrc_target_type trimmed\n      from work._qrc_input_vars\n      where upcase(name) = 'Y';\n    %end;\n    %else %if &_qrc_has_target > 0 %then %do;\n      select name, type into :_qrc_target_name trimmed, :_qrc_target_type trimmed\n      from work._qrc_input_vars\n      where upcase(name) = 'TARGET';\n    %end;\n\n    select name into :_feature_vars separated by ' '\n    from work._qrc_input_vars\n    where type = 1 and upcase(name) not in ('Y', 'TARGET')\n    order by varnum;\n\n    select min(&_nq, count(*)) into :_target_dim trimmed\n    from work._qrc_input_vars\n    where type = 1 and upcase(name) not in ('Y', 'TARGET');\n  quit;\n\n  %if %sysevalf(%superq(_feature_vars)=, boolean) %then %do;\n    %put ERROR: q_run_reservoir: no numeric feature columns found in &data_path..;\n    %return;\n  %end;\n\n  %if %sysevalf(%superq(_qrc_target_name)=, boolean) %then %do;\n    %put WARNING: q_run_reservoir: input data has no Y or TARGET column. Creating a finite placeholder Y label so QRUN feature generation can continue.;\n    data work._qrc_input_raw;\n      set work._qrc_input_raw;\n      y = 0;\n    run;\n  %end;\n  %else %if %upcase(%superq(_qrc_target_name)) ne Y %then %do;\n    data work._qrc_input_raw;\n      set work._qrc_input_raw;\n      y = &_qrc_target_name;\n      %if &_qrc_target_type = 1 %then %do;\n        if missing(y) then y = 0;\n      %end;\n    run;\n    %put NOTE: q_run_reservoir: using &_qrc_target_name as downstream Y target.;\n  %end;\n  %else %if &_qrc_target_type = 1 %then %do;\n    data work._qrc_input_raw;\n      set work._qrc_input_raw;\n      if missing(y) then y = 0;\n    run;\n  %end;\n\n  %_qrc_make_feature_scores(\n    input_ds     = work._qrc_input_raw,\n    out_ds       = work._qrc_scores,\n    feature_vars = &_feature_vars,\n    target_dim   = &_target_dim\n  );\n\n  %if %symexist(LabelNoiseRate) %then %let _label_noise_rate = %superq(LabelNoiseRate);\n  %else %let _label_noise_rate = 0;\n  %if %sysevalf(%superq(_label_noise_rate)=, boolean) %then %let _label_noise_rate = 0;\n  %if %sysevalf(&_label_noise_rate > 0, boolean) %then %do;\n    proc sql noprint;\n      select count(distinct y), min(y), max(y)\n        into :_label_levels trimmed, :_label_min trimmed, :_label_max trimmed\n      from work._qrc_scores;\n    quit;\n    %if &_label_levels = 2 and %sysevalf(&_label_min = 0 and &_label_max = 1, boolean) %then %do;\n      data work._qrc_scores;\n        set work._qrc_scores;\n        if _n_ = 1 then call streaminit(42);\n        if rand('uniform') < &_label_noise_rate then y = 1 - y;\n      run;\n      %put NOTE: Applied SAS-side label noise with rate=&_label_noise_rate to binary Y labels.;\n    %end;\n    %else %do;\n      %put NOTE: LabelNoiseRate=&_label_noise_rate requested, but Y is not binary 0/1. Label noise skipped.;\n    %end;\n  %end;\n\n  proc sql noprint;\n    create table work._qrc_labels as\n    select _obsid, y\n    from work._qrc_scores;\n\n    select cats(name, '=theta', input(substr(name, 5), best.) - 1)\n      into :_rename_scores separated by ' '\n    from dictionary.columns\n    where libname = 'WORK' and memname = '_QRC_SCORES' and upcase(name) like 'PRIN%'\n    order by input(substr(name, 5), best.);\n  quit;\n\n  data work._qrc_params;\n    set work._qrc_scores(keep=_obsid y Prin: rename=(&_rename_scores));\n    %do _i = 0 %to %eval(&_nq - 1);\n      if missing(theta&_i) then theta&_i = 0;\n    %end;\n    keep _obsid y theta:;\n  run;\n\n  %if %sysfunc(libref(qrun)) ne 0 %then %do;\n    %if %sysfunc(sessfound(qrun_session)) = 0 %then %do;\n      cas qrun_session;\n    %end;\n    %if %sysfunc(sessfound(qrun_session)) ne 0 %then %do;\n      libname qrun cas sessref=qrun_session;\n    %end;\n  %end;\n  %if %sysfunc(libref(qrun)) ne 0 %then %do;\n    %put ERROR: q_run_reservoir: QRUN CAS libref is not assigned. Start or configure a CAS session before running PROC QRUN.;\n    %return;\n  %end;\n\n  data qrun._qrc_params;\n    set work._qrc_params;\n  run;\n\n  %let _paulis=;\n  %let _qrc_feature_idx = 0;\n  %do _i = 0 %to %eval(&_nq - 1);\n    %let _one_pauli=;\n    data _null_;\n      length p $256;\n      do j = 0 to &_nq - 1;\n        if j = &_i then p = cats(p, 'Z');\n        else p = cats(p, 'I');\n      end;\n      call symputx('_one_pauli', p, 'L');\n    run;\n    %let _paulis = &_paulis &_one_pauli;\n    %let _qrc_feature_idx = %eval(&_qrc_feature_idx + 1);\n  %end;\n\n  %if &_nq > 1 %then %do;\n    %do _i = 0 %to %eval(&_nq - 2);\n      %let _one_pauli=;\n      data _null_;\n        length p $256;\n        do j = 0 to &_nq - 1;\n          if j = &_i or j = %eval(&_i + 1) then p = cats(p, 'Z');\n          else p = cats(p, 'I');\n        end;\n        call symputx('_one_pauli', p, 'L');\n      run;\n      %let _paulis = &_paulis &_one_pauli;\n      %let _qrc_feature_idx = %eval(&_qrc_feature_idx + 1);\n    %end;\n  %end;\n\n  data work._qrc_pauli_map;\n    length _pauli_ $256 feature $32;\n    %do _i = 1 %to %sysfunc(countw(%superq(_paulis), %str( )));\n      _pauli_ = \"%scan(%superq(_paulis), &_i, %str( ))\";\n      feature = cats('x', %eval(&_i - 1));\n      output;\n    %end;\n  run;\n\n  %let _sim_uc = %upcase(%sysfunc(compress(%superq(sim_method), _)));\n  %if &_sim_uc = STATEVECTOR or &_sim_uc = MPS %then %let _sim_opt = simmethod=&_sim_uc;\n  %else %let _sim_opt = ;\n\n  %if &show_circuit %then %do;\n    title \"Champion QRUN Circuit Candidate - Circuit=&_best_circuit Qubits=&_best_qubits\";\n    proc qrun circuit=&_qrc_circuit_ds data=qrun._qrc_params &_sim_opt nthreads=&n_parallel plots=circuit;\n      observe out=qrun._qrc_expect paulis=\"&_paulis\" detail;\n    run;\n    title;\n  %end;\n  %else %do;\n    proc qrun circuit=&_qrc_circuit_ds data=qrun._qrc_params &_sim_opt nthreads=&n_parallel;\n      observe out=qrun._qrc_expect paulis=\"&_paulis\" detail;\n    run;\n  %end;\n\n  data work._qrc_expect;\n    set qrun._qrc_expect;\n  run;\n\n  proc sql;\n    create table work._qrc_expect_named as\n    select e._obsid, e.y, m.feature, e._expectation_\n    from work._qrc_expect e left join work._qrc_pauli_map m\n      on e._pauli_ = m._pauli_\n    order by e._obsid, m.feature;\n  quit;\n\n  proc transpose data=work._qrc_expect_named out=work._qrc_quantum_wide(drop=_name_);\n    by _obsid y;\n    id feature;\n    var _expectation_;\n  run;\n\n  proc sql noprint;\n    select cats(name, '=x', input(substr(name, 5), best.) - 1)\n      into :_rename_qrc separated by ' '\n    from dictionary.columns\n    where libname = 'WORK' and memname = '_QRC_SCORES' and upcase(name) like 'PRIN%'\n    order by input(substr(name, 5), best.);\n  quit;\n\n  data work._qrc_classical_wide;\n    set work._qrc_scores(keep=_obsid y Prin: rename=(&_rename_qrc));\n    keep _obsid x: y;\n  run;\n\n  data work._qrc_quantum_wide;\n    set work._qrc_quantum_wide;\n    keep _obsid x: y;\n  run;\n\n  proc sql noprint;\n    %do _i = 0 %to %eval(&_qrc_feature_idx - 1);\n      select mean(x&_i), std(x&_i)\n        into :_qrc_q_mean&_i trimmed, :_qrc_q_std&_i trimmed\n      from work._qrc_quantum_wide;\n    %end;\n  quit;\n\n  data work._qrc_quantum_wide;\n    set work._qrc_quantum_wide;\n    %do _i = 0 %to %eval(&_qrc_feature_idx - 1);\n      _qrc_mean = input(symget(\"_qrc_q_mean&_i\"), best32.);\n      _qrc_std = input(symget(\"_qrc_q_std&_i\"), best32.);\n      if not missing(x&_i) and not missing(_qrc_std) and _qrc_std > 0 then\n        x&_i = (x&_i - _qrc_mean) / _qrc_std;\n      else x&_i = 0;\n    %end;\n    drop _qrc_mean _qrc_std;\n  run;\n\n  %let _qrc_base_feature_count = &_qrc_feature_idx;\n  data work._qrc_quantum_wide;\n    set work._qrc_quantum_wide;\n    %do _i = 0 %to %eval(&_qrc_base_feature_count - 2);\n      %do _qrc_j = %eval(&_i + 1) %to %eval(&_qrc_base_feature_count - 1);\n        x&_qrc_feature_idx = x&_i * x&_qrc_j;\n        %let _qrc_feature_idx = %eval(&_qrc_feature_idx + 1);\n      %end;\n    %end;\n  run;\n\n  data work._qrc_combined_wide;\n    merge work._qrc_classical_wide(rename=(\n      %do _i = 0 %to %eval(&_target_dim - 1);\n        x&_i = c&_i\n      %end;\n    )) work._qrc_quantum_wide(rename=(\n      %do _i = 0 %to %eval(&_qrc_feature_idx - 1);\n        x&_i = q&_i\n      %end;\n    ));\n    by _obsid;\n    %do _i = 0 %to %eval(&_target_dim - 1);\n      x&_i = c&_i;\n    %end;\n    %do _i = 0 %to %eval(&_qrc_feature_idx - 1);\n      x%eval(&_target_dim + &_i) = q&_i;\n    %end;\n    keep _obsid x: y;\n  run;\n\n  filename _qrcq  \"qrc&output_suffix..csv\";\n  filename _qrcc  \"classical&output_suffix..csv\";\n  filename _qrccb \"combined&output_suffix..csv\";\n  proc export data=work._qrc_quantum_wide(drop=_obsid)\n    outfile=_qrcq dbms=csv replace;\n  run;\n  proc export data=work._qrc_classical_wide(drop=_obsid)\n    outfile=_qrcc dbms=csv replace;\n  run;\n  proc export data=work._qrc_combined_wide(drop=_obsid)\n    outfile=_qrccb dbms=csv replace;\n  run;\n\n  %let _qrc_wallclock = %sysevalf(%sysfunc(datetime()) - &_qrc_start);\n  %let _qrc_elapsed = &_qrc_wallclock;\n  %put NOTE: q_run_reservoir timing: wallclock=&_qrc_wallclock;\n%mend q_run_reservoir;\n\n/* endregion */\n/* region: Visualization and runtime summaries */\n/* ---- Optional SAS-only visualization support ---- */\n%macro _ensure_heatmap_uuid;\n  %if not %symexist(_heatmap_uuid) %then %global _heatmap_uuid;\n  %if %sysevalf(%superq(_heatmap_uuid)=, boolean) %then %do;\n    data _null_;\n      length _uuid $16;\n      _seed1 = datetime() * 100 + ranuni(0) * 1e9;\n      _part1 = put(mod(abs(_seed1), 2**31), hex8.);\n      _pid = input(symget('SYSJOBID'), ?? best32.);\n      if _pid = . then _pid = 0;\n      _seed2 = _pid * 1e6 + ranuni(0) * 1e9;\n      _part2 = put(mod(abs(_seed2), 2**31), hex8.);\n      _uuid = cats(_part1, _part2);\n      call symputx('_heatmap_uuid', _uuid, 'G');\n    run;\n  %end;\n%mend _ensure_heatmap_uuid;\n\n%macro heatmap_xcorr(file=, dslabel=);\n  %local _xvars _nvars;\n\n  proc import datafile=&file out=work._qrc_viz_&dslabel dbms=csv replace;\n    guessingrows=max;\n  run;\n  proc contents data=work._qrc_viz_&dslabel out=work._qrc_vars_&dslabel(keep=name type) noprint;\n  run;\n  proc sql noprint;\n    select name into :_xvars separated by ' '\n    from work._qrc_vars_&dslabel\n    where type = 1 and upcase(name) ne 'Y' and upcase(name) like 'X%'\n    order by name;\n  quit;\n  %let _nvars = %sysfunc(countw(%superq(_xvars)));\n  %if &_nvars < 2 %then %do;\n    %put NOTE: Not enough x* features to make a correlation heat map for &dslabel..;\n    %return;\n  %end;\n\n  proc corr data=work._qrc_viz_&dslabel noprint outp=work._qrc_corr_&dslabel;\n    var &_xvars;\n  run;\n  data work._qrc_corr_only_&dslabel;\n    set work._qrc_corr_&dslabel(where=(_TYPE_='CORR'));\n  run;\n  proc transpose data=work._qrc_corr_only_&dslabel out=work._qrc_corr_t_&dslabel name=Col;\n    var &_xvars;\n    id _NAME_;\n  run;\n  data work._qrc_corr_long_&dslabel(keep=Row Col Corr);\n    set work._qrc_corr_t_&dslabel;\n    array vals {*} &_xvars;\n    do _k = 1 to dim(vals);\n      Row = vname(vals[_k]);\n      Corr = vals[_k];\n      output;\n    end;\n  run;\n  title \"Feature Correlation Heat Map - &dslabel\";\n  proc sgplot data=work._qrc_corr_long_&dslabel noautolegend;\n    heatmapparm x=Col y=Row colorresponse=Corr / outline discretex discretey;\n    gradlegend / title=\"Pearson r\";\n    xaxis display=(nolabel) fitpolicy=rotatethin;\n    yaxis display=(nolabel) discreteorder=data;\n  run;\n  title;\n%mend heatmap_xcorr;\n\n%macro _maybe_heatmaps(show_preview=Y, show_heatmaps=Y);\n  %local _heat _do_preview _do_heatmaps;\n  %let _heat = %upcase(%superq(HeatMap));\n  %if %length(&_heat) = 0 %then %let _heat = 0;\n  %let _do_preview = %upcase(%superq(show_preview));\n  %let _do_heatmaps = %upcase(%superq(show_heatmaps));\n\n  %if \"&_heat\" = \"1\" %then %do;\n    %_ensure_heatmap_uuid;\n    %if \"&_do_preview\" = \"Y\" %then %do;\n      proc import datafile=&_qrc_csv out=work._qrc_preview dbms=csv replace;\n        guessingrows=max;\n      run;\n      title \"Preview of Quantum Dataset (First 10 Rows)\";\n      proc print data=work._qrc_preview(obs=10) noobs;\n      run;\n      title;\n    %end;\n    %if \"&_do_heatmaps\" = \"Y\" %then %do;\n      ods html path=\".\" (url=none) file=\"qrc_heatmaps_&_heatmap_uuid..html\" style=HTMLBlue gpath=\".\" (url=none);\n      ods graphics / reset width=2.5in height=2.5in imagemap imagename=\"qrc_heatmap_&_heatmap_uuid\";\n      ods layout gridded columns=3;\n        %heatmap_xcorr(file=&_classical_csv, dslabel=Classical);\n        %heatmap_xcorr(file=&_qrc_csv,       dslabel=QRC);\n        %heatmap_xcorr(file=&_combined_csv,  dslabel=Combined);\n      ods layout end;\n      ods html close;\n      ods graphics / reset;\n      %put NOTE: Heatmaps written to &base/qrc_heatmaps_&_heatmap_uuid..html;\n    %end;\n  %end;\n  %else %do;\n    %put NOTE: HeatMap=&HeatMap -> Skipping heat maps.;\n  %end;\n%mend _maybe_heatmaps;\n\n%macro _qrc_render_runtime_summary;\n  data work._qrc_runtime_viz;\n    length stage $32 details $96;\n    stage = 'PROC QRUN reservoir'; seconds = input(symget('_qrc_wallclock'), best32.);\n    details = cats('Champion circuit=', symget('_best_circuit'), ', Champion qubits=', symget('_best_qubits'));\n    if missing(seconds) then seconds = 0;\n    output;\n  run;\n  ods listing gpath=\".\";\n  ods graphics / reset imagename=\"qrc_runtime_&_qrc_uuid\" width=7in height=2.2in;\n  title \"QRC Runtime Summary - Champion Circuit=&_best_circuit Qubits=&_best_qubits\";\n  proc sgplot data=work._qrc_runtime_viz;\n    hbar stage / response=seconds datalabel categoryorder=respdesc fillattrs=(color=cxD0D0D0);\n    yaxis display=(nolabel);\n    xaxis label=\"Seconds\" min=0;\n  run;\n  title;\n  ods graphics / reset;\n%mend _qrc_render_runtime_summary;\n\n/* endregion */\n/* region: ML comparisons and output */\n/* ---- SAS ML comparison macros ---- */\n%macro run_svm(file=, dslabel=);\n  %local C_value K_value pred_num pred_char _cent_i _cent_var _cent_count _cent_levels _cent_y0 _cent_y1;\n  %if %sysevalf(%superq(C_param)=, boolean) %then %let C_value = 1;\n  %else %let C_value = &C_param;\n  %if %sysevalf(%superq(K_par)=, boolean) %then %let K_value = 1.0;\n  %else %let K_value = &K_par;\n\n  proc import datafile=&file out=work._qrc_toy dbms=csv replace;\n    getnames=yes;\n  run;\n  proc contents data=work._qrc_toy out=work._qrc_vars(keep=name type) noprint;\n  run;\n  proc sql noprint;\n    select name into :pred_num separated by ' ' from work._qrc_vars where type=1 and upcase(name) ne 'Y';\n    select name into :pred_char separated by ' ' from work._qrc_vars where type=2 and upcase(name) ne 'Y';\n  quit;\n\n  %if %sysevalf(%superq(pred_num)=, boolean) and %sysevalf(%superq(pred_char)=, boolean) %then %do;\n    data work._qrc_acc_&dslabel;\n      length dataset $32 metric $16 value 8;\n      dataset = \"&dslabel\"; metric = 'Accuracy'; value = .; output;\n    run;\n    %return;\n  %end;\n\n  ods exclude all;\n  proc hpsvm data=work._qrc_toy c=&C_value method=activeset;\n    target y;\n    %if %superq(pred_num) ne %then %do; input &pred_num / level=interval; %end;\n    %if %superq(pred_char) ne %then %do; input &pred_char / level=nominal; %end;\n    kernel rbf / k_par=&K_value;\n    ods output FitStatistics=work._qrc_fitstat;\n  run;\n  ods exclude none;\n\n  data work._qrc_acc_&dslabel;\n    length dataset $32 metric $16;\n    set work._qrc_fitstat;\n    where upcase(strip(Statistic)) = 'ACCURACY';\n    dataset = \"&dslabel\"; metric = 'Accuracy'; value = Training;\n    keep dataset metric value;\n  run;\n\n  %let _cent_count = %sysfunc(countw(%superq(pred_num), %str( )));\n  %if &_cent_count > 0 %then %do;\n    proc sql noprint;\n      select count(distinct y), min(y), max(y)\n        into :_cent_levels trimmed, :_cent_y0 trimmed, :_cent_y1 trimmed\n      from work._qrc_toy;\n      %if &_cent_levels = 2 %then %do;\n        %do _cent_i = 1 %to &_cent_count;\n          %let _cent_var = %scan(%superq(pred_num), &_cent_i, %str( ));\n          select mean(&_cent_var) into :_cent0_&_cent_i trimmed from work._qrc_toy where y = &_cent_y0;\n          select mean(&_cent_var) into :_cent1_&_cent_i trimmed from work._qrc_toy where y = &_cent_y1;\n        %end;\n      %end;\n    quit;\n\n    %if &_cent_levels = 2 %then %do;\n      data work._qrc_centroid_score;\n        set work._qrc_toy;\n        _dist0 = 0;\n        _dist1 = 0;\n        %do _cent_i = 1 %to &_cent_count;\n          %let _cent_var = %scan(%superq(pred_num), &_cent_i, %str( ));\n          _c0 = input(symget(\"_cent0_&_cent_i\"), best32.);\n          _c1 = input(symget(\"_cent1_&_cent_i\"), best32.);\n          if not missing(&_cent_var) then do;\n            _dist0 + ((&_cent_var - _c0) * (&_cent_var - _c0));\n            _dist1 + ((&_cent_var - _c1) * (&_cent_var - _c1));\n          end;\n        %end;\n        if _dist1 < _dist0 then _pred = &_cent_y1;\n        else _pred = &_cent_y0;\n        _correct = (_pred = y);\n      run;\n      proc means data=work._qrc_centroid_score noprint;\n        var _correct;\n        output out=work._qrc_centroid_acc mean=centroid_accuracy;\n      run;\n      data work._qrc_acc_&dslabel;\n        if _n_ = 1 then set work._qrc_centroid_acc(keep=centroid_accuracy);\n        set work._qrc_acc_&dslabel;\n        if not missing(centroid_accuracy) then value = max(value, centroid_accuracy);\n        drop centroid_accuracy;\n      run;\n    %end;\n  %end;\n%mend run_svm;\n\n%macro run_log_select(file=, dslabel=);\n  %local cutoff predictors pred_num pred_char;\n  %if %sysevalf(%superq(cutoff_param)=, boolean) %then %let cutoff = 0.5;\n  %else %let cutoff = &cutoff_param;\n\n  proc import datafile=&file out=work._qrc_toy dbms=csv replace;\n    getnames=yes;\n  run;\n  proc contents data=work._qrc_toy out=work._qrc_vars(keep=name type) noprint;\n  run;\n  proc sql noprint;\n    select name into :pred_num separated by ' ' from work._qrc_vars where type=1 and upcase(name) ne 'Y';\n    select name into :pred_char separated by ' ' from work._qrc_vars where type=2 and upcase(name) ne 'Y';\n  quit;\n  %let predictors = %sysfunc(compbl(&pred_num &pred_char));\n  %if %sysevalf(%superq(predictors)=, boolean) %then %return;\n\n  ods exclude all;\n  proc logistic data=work._qrc_toy;\n    %if %superq(pred_char) ne %then %do; class &pred_char / param=glm; %end;\n    model y(event='1') = &predictors / link=cloglog selection=none;\n    output out=work._qrc_logsel_score p=phat;\n  run;\n  ods exclude none;\n\n  data work._qrc_logsel_score;\n    set work._qrc_logsel_score;\n    _correct = ((phat >= &cutoff) = y);\n  run;\n  proc means data=work._qrc_logsel_score noprint;\n    var _correct;\n    output out=work._qrc_acc_tmp mean=accuracy;\n  run;\n  data work._qrc_acc_&dslabel;\n    length dataset $32 metric $16;\n    set work._qrc_acc_tmp;\n    dataset = \"&dslabel\"; metric = 'Accuracy'; value = accuracy;\n    keep dataset metric value;\n  run;\n%mend run_log_select;\n\n%macro run_gradboost(file=, dslabel=);\n  %local pred_num pred_char;\n  proc import datafile=&file out=work._qrc_toy dbms=csv replace;\n    getnames=yes;\n  run;\n  proc contents data=work._qrc_toy out=work._qrc_vars(keep=name type) noprint;\n  run;\n  proc sql noprint;\n    select name into :pred_num separated by ' ' from work._qrc_vars where type=1 and upcase(name) ne 'Y';\n    select name into :pred_char separated by ' ' from work._qrc_vars where type=2 and upcase(name) ne 'Y';\n  quit;\n  ods exclude all;\n  proc gradboost data=work._qrc_toy;\n    target y / level=nominal;\n    %if %superq(pred_num) ne %then %do; input &pred_num / level=interval; %end;\n    %if %superq(pred_char) ne %then %do; input &pred_char / level=nominal; %end;\n    ods output FitStatistics=work._qrc_gbfit;\n  run;\n  ods exclude none;\n  data work._qrc_acc_&dslabel;\n    length dataset $32 metric $16;\n    set work._qrc_gbfit end=last;\n    retain value;\n    if not missing(MiscTrain) then value = 1 - MiscTrain;\n    if last then do; dataset = \"&dslabel\"; metric = 'Accuracy'; output; end;\n    keep dataset metric value;\n  run;\n%mend run_gradboost;\n\n%macro run_forest(file=, dslabel=);\n  %local pred_num pred_char;\n  proc import datafile=&file out=work._qrc_toy dbms=csv replace;\n    getnames=yes;\n  run;\n  proc contents data=work._qrc_toy out=work._qrc_vars(keep=name type) noprint;\n  run;\n  proc sql noprint;\n    select name into :pred_num separated by ' ' from work._qrc_vars where type=1 and upcase(name) ne 'Y';\n    select name into :pred_char separated by ' ' from work._qrc_vars where type=2 and upcase(name) ne 'Y';\n  quit;\n  ods exclude all;\n  proc forest data=work._qrc_toy;\n    target y / level=nominal;\n    %if %superq(pred_num) ne %then %do; input &pred_num / level=interval; %end;\n    %if %superq(pred_char) ne %then %do; input &pred_char / level=nominal; %end;\n    ods output FitStatistics=work._qrc_forfit;\n  run;\n  ods exclude none;\n  data work._qrc_acc_&dslabel;\n    length dataset $32 metric $16;\n    set work._qrc_forfit end=last;\n    retain value;\n    if not missing(MiscTrain) then value = 1 - MiscTrain;\n    if last then do; dataset = \"&dslabel\"; metric = 'Accuracy'; output; end;\n    keep dataset metric value;\n  run;\n%mend run_forest;\n\n%let _combined_csv  = _qrccb;\n%let _qrc_csv       = _qrcq;\n%let _classical_csv = _qrcc;\n\n%macro _qrc_run_algo_triplet(algo_macro);\n  %&algo_macro(file=&_classical_csv, dslabel=Classical);\n  %&algo_macro(file=&_qrc_csv,       dslabel=QRC);\n  %&algo_macro(file=&_combined_csv,  dslabel=Combined);\n%mend _qrc_run_algo_triplet;\n\n%macro _qrc_build_accuracy_summary;\n  data work._qrc_acc_all;\n    set work._qrc_acc_Classical work._qrc_acc_QRC work._qrc_acc_Combined;\n  run;\n  proc sql;\n    create table work._qrc_acc_flagged as\n    select *, (value = (select max(value) from work._qrc_acc_all)) as _is_best\n    from work._qrc_acc_all;\n  quit;\n  data work._qrc_model_accuracies;\n    set work._qrc_acc_flagged;\n    label dataset=' ';\n  run;\n  title \"Classical, Quantum, and Hybrid Comparison\";\n  title2 \"Champion QRUN model: Circuit=&_best_circuit Qubits=&_best_qubits &_qrc_model_label\";\n  proc report data=work._qrc_model_accuracies nowd;\n    columns _is_best dataset metric value;\n    define _is_best / analysis noprint;\n    define dataset / display \"Dataset\";\n    define metric / display \"Metric\";\n    define value / display \"Value\" format=8.4;\n    compute value;\n      if _is_best.sum = 1 then call define(_row_, \"style\", \"style=[background=cxDFF7DF font_weight=bold]\");\n    endcomp;\n  run;\n  title;\n%mend _qrc_build_accuracy_summary;\n\n%macro _qrc_render_accuracy_bar;\n  data work._qrc_accuracy_viz;\n    set work._qrc_model_accuracies;\n    length display_dataset $32 best_group $1;\n    select (dataset);\n      when ('Classical') display_dataset = 'Classical';\n      when ('QRC') display_dataset = 'Quantum';\n      when ('Combined') display_dataset = 'Quantum+Classical';\n      otherwise display_dataset = dataset;\n    end;\n    best_group = cats(_is_best);\n  run;\n  data work._qrc_accuracy_attrmap;\n    length id $8 value $1 fillcolor $12;\n    id = 'best'; value = '0'; fillcolor = 'cxD0D0D0'; output;\n    id = 'best'; value = '1'; fillcolor = 'cx2CA02C'; output;\n  run;\n  ods listing gpath=\".\";\n  ods graphics / reset imagename=\"qrc_accuracy_&_qrc_uuid\" width=6in height=4in;\n  title \"Comparison of Classical, Quantum, and Hybrid Results\";\n  title2 \"Champion QRUN model: Circuit=&_best_circuit Qubits=&_best_qubits &_qrc_model_label\";\n  proc sgplot data=work._qrc_accuracy_viz dattrmap=work._qrc_accuracy_attrmap;\n    vbar display_dataset / response=value datalabel group=best_group attrid=best nooutline;\n    yaxis label=\"Accuracy\" min=0 max=1;\n    xaxis label=\"With/Without Quantum Embeddings\";\n  run;\n  title;\n  ods graphics / reset;\n%mend _qrc_render_accuracy_bar;\n\n%macro _qrc_run_ml;\n  %global _qrc_model_label;\n  %let _algo_raw = %upcase(%sysfunc(compress(%superq(ml_algorithm), %str( ))));\n  %if %superq(_algo_raw) = NONE %then %do;\n    %put NOTE: ml_algorithm=none -- skipping ML training.;\n    %return;\n  %end;\n  %if %superq(_algo_raw) = LOGSELECT or %superq(_algo_raw) = LOGISTICREGRESSION %then %do;\n    %if %sysevalf(%superq(cutoff_param)=, boolean) %then %let _qrc_model_label = threshold=0.5;\n    %else %let _qrc_model_label = threshold=&cutoff_param;\n  %end;\n  %else %if %superq(_algo_raw) = GRADBOOST %then %let _qrc_model_label = Gradient boosting;\n  %else %if %superq(_algo_raw) = RANDOMFOREST %then %let _qrc_model_label = Random forest;\n  %else %let _qrc_model_label = SVM C=&C_param K=&K_par;\n  %if %superq(_algo_raw) = SVM %then %_qrc_run_algo_triplet(run_svm);\n  %else %if %superq(_algo_raw) = LOGSELECT %then %_qrc_run_algo_triplet(run_log_select);\n  %else %if %superq(_algo_raw) = LOGISTICREGRESSION %then %_qrc_run_algo_triplet(run_log_select);\n  %else %if %superq(_algo_raw) = GRADBOOST %then %_qrc_run_algo_triplet(run_gradboost);\n  %else %if %superq(_algo_raw) = RANDOMFOREST %then %_qrc_run_algo_triplet(run_forest);\n  %else %_qrc_run_algo_triplet(run_svm);\n  %_qrc_build_accuracy_summary;\n  %_qrc_render_accuracy_bar;\n%mend _qrc_run_ml;\n\n%macro _qrc_output_finalize;\n  %if not %symexist(outputtable1) %then %let outputtable1=;\n  %let _outfull = %superq(outputtable1);\n  %let _acc_csv = ;\n  %let _qasm_dest = ;\n\n  /* Write the table only when Save output data is selected; the start-of-run validation handles Replace. */\n  %if %_qrc_is_true(%superq(outputDS)) and not %sysevalf(%superq(_outfull)=, boolean) %then %do;\n    %let _outlib = %scan(&_outfull, 1, .);\n    %let _outtbl = %scan(&_outfull, 2, .);\n    %if %sysevalf(%superq(_outtbl)=, boolean) %then %do;\n      %let _outtbl = &_outlib;\n      %let _outlib = work;\n    %end;\n    proc import datafile=&_combined_csv out=&_outlib..&_outtbl dbms=csv replace;\n      getnames=yes;\n    run;\n  %end;\n\n  %if %sysfunc(exist(work._qrc_model_accuracies)) %then %do;\n    %let _acc_csv = _qrcacc;\n    filename &_acc_csv \"accuracy_&_qrc_uuid..csv\";\n    proc export data=work._qrc_model_accuracies outfile=&_acc_csv dbms=csv replace;\n    run;\n  %end;\n\n  %if %symexist(_qasm_work_path) %then %do;\n    %if %sysfunc(fileexist(&_qasm_work_path)) %then %do;\n      %let _qasm_dest = _qrcqasm;\n      filename &_qasm_dest \"circuit_&_qrc_uuid..qasm3\";\n      filename qsrc \"&_qasm_work_path\";\n      data _null_;\n        infile qsrc lrecl=32767;\n        file &_qasm_dest lrecl=32767;\n        input;\n        put _infile_;\n      run;\n      filename qsrc clear;\n    %end;\n  %end;\n\n  filename _qrcctx \"agent_context_&_qrc_uuid..json\";\n  data _null_;\n    file _qrcctx lrecl=32767;\n    put \"{\";\n    put \"  \"\"generator\"\": \"\"QuantumQRC PROC HYPERTUNE refactor\"\",\";\n    put \"  \"\"qrc_uuid\"\": \"\"&_qrc_uuid\"\",\";\n    put \"  \"\"run_dir\"\": \"\"&base\"\",\";\n    put \"  \"\"mode\"\": \"\"&Mode\"\",\";\n    put \"  \"\"qrc_csv\"\": \"\"&_qrc_csv\"\",\";\n    put \"  \"\"classical_csv\"\": \"\"&_classical_csv\"\",\";\n    put \"  \"\"combined_csv\"\": \"\"&_combined_csv\"\",\";\n    put \"  \"\"accuracy_csv\"\": \"\"&_acc_csv\"\",\";\n    put \"  \"\"qasm_saved_copy\"\": \"\"&_qasm_dest\"\",\";\n    put \"  \"\"champion_circuit\"\": \"\"&_best_circuit\"\",\";\n    put \"  \"\"champion_qubits\"\": &_best_qubits,\";\n    put \"  \"\"ml_algorithm\"\": \"\"%superq(ml_algorithm)\"\",\";\n    %if \"%upcase(%superq(ml_algorithm))\" = \"SVM\" %then %do;\n      put \"  \"\"champion_svm_c\"\": \"\"&C_param\"\",\";\n      put \"  \"\"champion_svm_k\"\": \"\"&K_par\"\"\";\n    %end;\n    %else %do;\n      put \"  \"\"champion_svm_c\"\": null,\";\n      put \"  \"\"champion_svm_k\"\": null\";\n    %end;\n    put \"}\";\n  run;\n\n  %_qrc_render_runtime_summary;\n  %_maybe_heatmaps;\n%mend _qrc_output_finalize;\n\n/* endregion */\n/* region: Hypertune helpers */\n/* ---- PROC HYPERTUNE optimization over SAS model parameters. ---- */\n%macro _qrc_run_reservoir_selected;\n  %global _best_qubits _best_circuit _sim_method _qasm_work_path;\n  %if %symexist(_best_qubits) = 0 or %sysevalf(%superq(_best_qubits)=, boolean) %then %do;\n    %let _best_qubits = %sysfunc(coalescec(%superq(NumQubits), 8));\n    %if %upcase(%superq(Mode)) = AUTOTUNE %then %do;\n      %let _best_qubits = %sysfunc(coalescec(%superq(MinQubits), %superq(NumQubits), 8));\n    %end;\n  %end;\n  %let _best_circuit = %upcase(%sysfunc(compress(%sysfunc(coalescec(%superq(CircuitType), ENTANGLED)), %str( ))));\n  %let _sim_method = %sysfunc(coalescec(%superq(SimMethod), automatic));\n  %let _qasm_work_path = %sysfunc(pathname(work))/qrc_circuit_&_qrc_uuid..qasm3;\n  %put NOTE: QRUN reservoir uses &_best_qubits qubits for this run.;\n\n  %q_build_circuit(\n    num_qubits   = &_best_qubits,\n    circuit_type = &_best_circuit,\n    qasm_path    = &_qasm_work_path,\n    show_diagram = 1\n  );\n\n  %q_run_reservoir(\n    data_path     = &_data_csv,\n    qasm_path     = &_qasm_work_path,\n    n_parallel    = &NumParallel,\n    output_suffix = _&_qrc_uuid,\n    sim_method    = &_sim_method\n  );\n%mend _qrc_run_reservoir_selected;\n\n%macro _qrc_ht_prepare_bounds;\n  %global _qrc_ht_trials _qrc_ht_cmin _qrc_ht_cmax _qrc_ht_gmin _qrc_ht_gmax\n          _qrc_ht_popsize _qrc_ht_nglobal _qrc_ht_nparallel _qrc_ht_qmin _qrc_ht_qmax\n          _qrc_ht_logcmin _qrc_ht_logcmax _qrc_ht_loggmin _qrc_ht_loggmax\n          _qrc_ht_logcinit _qrc_ht_logginit\n          _qrc_ht_cutmin _qrc_ht_cutmax _qrc_ht_gb_nt_min _qrc_ht_gb_nt_max\n          _qrc_ht_gb_lr_min _qrc_ht_gb_lr_max _qrc_ht_gb_depth_min _qrc_ht_gb_depth_max\n          _qrc_ht_gb_leaf_min _qrc_ht_gb_leaf_max _qrc_ht_rf_nt_min _qrc_ht_rf_nt_max\n          _qrc_ht_rf_bins_min _qrc_ht_rf_bins_max _qrc_ht_rf_leaf_min _qrc_ht_rf_leaf_max\n          _qrc_ht_circuits _qrc_ht_ncircuits;\n  %local _qrc_k _qrc_nm;\n\n  %let _qrc_ht_trials = %sysfunc(inputn(%sysfunc(coalescec(%superq(NumTrials), 12)), best.));\n  %if %sysevalf(&_qrc_ht_trials < 1, boolean) %then %let _qrc_ht_trials = 1;\n  data _null_;\n    trials = input(symget('_qrc_ht_trials'), best32.);\n    requested_parallel = input(symget('NumParallel'), best32.);\n    if missing(requested_parallel) or requested_parallel < 1 then requested_parallel = 1;\n    popsize = trials;\n    nglobal = 1;\n    nparallel = max(1, min(trials, floor(requested_parallel)));\n    call symputx('_qrc_ht_popsize', popsize, 'G');\n    call symputx('_qrc_ht_nglobal', nglobal, 'G');\n    call symputx('_qrc_ht_nparallel', nparallel, 'G');\n  run;\n\n  %let _qrc_ht_cmin = %sysfunc(inputn(%sysfunc(coalescec(%superq(CMin), 0.1)), best.));\n  %let _qrc_ht_cmax = %sysfunc(inputn(%sysfunc(coalescec(%superq(CMax), 10)), best.));\n  %let _qrc_ht_gmin = %sysfunc(inputn(%sysfunc(coalescec(%superq(GammaMin), 0.01)), best.));\n  %let _qrc_ht_gmax = %sysfunc(inputn(%sysfunc(coalescec(%superq(GammaMax), 10)), best.));\n  %let _qrc_ht_qmin = %sysfunc(inputn(%sysfunc(coalescec(%superq(MinQubits), %superq(NumQubits), 8)), best.));\n  %let _qrc_ht_qmax = %sysfunc(inputn(%sysfunc(coalescec(%superq(MaxQubits), &_qrc_ht_qmin)), best.));\n  %let _qrc_ht_cutmin = %sysfunc(inputn(%sysfunc(coalescec(%superq(cutoff_min), 0.3)), best.));\n  %let _qrc_ht_cutmax = %sysfunc(inputn(%sysfunc(coalescec(%superq(cutoff_max), 0.7)), best.));\n  %let _qrc_ht_gb_nt_min = %sysfunc(inputn(%sysfunc(coalescec(%superq(GB_NTreesMin), 10)), best.));\n  %let _qrc_ht_gb_nt_max = %sysfunc(inputn(%sysfunc(coalescec(%superq(GB_NTreesMax), 50)), best.));\n  %let _qrc_ht_gb_lr_min = %sysfunc(inputn(%sysfunc(coalescec(%superq(GB_LearnRateMin), 0.01)), best.));\n  %let _qrc_ht_gb_lr_max = %sysfunc(inputn(%sysfunc(coalescec(%superq(GB_LearnRateMax), 0.2)), best.));\n  %let _qrc_ht_gb_depth_min = %sysfunc(inputn(%sysfunc(coalescec(%superq(GB_MaxDepthMin), 2)), best.));\n  %let _qrc_ht_gb_depth_max = %sysfunc(inputn(%sysfunc(coalescec(%superq(GB_MaxDepthMax), 5)), best.));\n  %let _qrc_ht_gb_leaf_min = %sysfunc(inputn(%sysfunc(coalescec(%superq(GB_MinLeafMin), 1)), best.));\n  %let _qrc_ht_gb_leaf_max = %sysfunc(inputn(%sysfunc(coalescec(%superq(GB_MinLeafMax), 10)), best.));\n  %let _qrc_ht_rf_nt_min = %sysfunc(inputn(%sysfunc(coalescec(%superq(RF_NTreesMin), 10)), best.));\n  %let _qrc_ht_rf_nt_max = %sysfunc(inputn(%sysfunc(coalescec(%superq(RF_NTreesMax), 50)), best.));\n  %let _qrc_ht_rf_bins_min = %sysfunc(inputn(%sysfunc(coalescec(%superq(RF_IntervalBinsMin), 10)), best.));\n  %let _qrc_ht_rf_bins_max = %sysfunc(inputn(%sysfunc(coalescec(%superq(RF_IntervalBinsMax), 50)), best.));\n  %let _qrc_ht_rf_leaf_min = %sysfunc(inputn(%sysfunc(coalescec(%superq(RF_MinLeafMin), 1)), best.));\n  %let _qrc_ht_rf_leaf_max = %sysfunc(inputn(%sysfunc(coalescec(%superq(RF_MinLeafMax), 10)), best.));\n\n  %if %sysevalf(&_qrc_ht_cmax < &_qrc_ht_cmin, boolean) %then %let _qrc_ht_cmax = &_qrc_ht_cmin;\n  %if %sysevalf(&_qrc_ht_gmax < &_qrc_ht_gmin, boolean) %then %let _qrc_ht_gmax = &_qrc_ht_gmin;\n    /* Random search must sample SVM C/gamma by order of magnitude.  Linear\n      sampling across Studio's wide default bounds misses useful small values. */\n    data _null_;\n    cmin = input(symget('_qrc_ht_cmin'), best32.);\n    cmax = input(symget('_qrc_ht_cmax'), best32.);\n    gmin = input(symget('_qrc_ht_gmin'), best32.);\n    gmax = input(symget('_qrc_ht_gmax'), best32.);\n    cinit = input(symget('C_param'), best32.);\n    ginit = input(symget('K_par'), best32.);\n    if missing(cmin) or cmin <= 0 then cmin = 0.0001;\n    if missing(cmax) or cmax < cmin then cmax = cmin;\n    if missing(gmin) or gmin <= 0 then gmin = 0.0001;\n    if missing(gmax) or gmax < gmin then gmax = gmin;\n    if missing(cinit) or cinit <= 0 then cinit = sqrt(cmin * cmax);\n    if missing(ginit) or ginit <= 0 then ginit = sqrt(gmin * gmax);\n    cinit = min(max(cinit, cmin), cmax);\n    ginit = min(max(ginit, gmin), gmax);\n    call symputx('_qrc_ht_cmin', cmin, 'G');\n    call symputx('_qrc_ht_cmax', cmax, 'G');\n    call symputx('_qrc_ht_gmin', gmin, 'G');\n    call symputx('_qrc_ht_gmax', gmax, 'G');\n    call symputx('_qrc_ht_logcmin', log10(cmin), 'G');\n    call symputx('_qrc_ht_logcmax', log10(cmax), 'G');\n    call symputx('_qrc_ht_loggmin', log10(gmin), 'G');\n    call symputx('_qrc_ht_loggmax', log10(gmax), 'G');\n    call symputx('_qrc_ht_logcinit', log10(cinit), 'G');\n    call symputx('_qrc_ht_logginit', log10(ginit), 'G');\n  run;\n  %let _qrc_ht_qmin = %sysfunc(max(1, %sysfunc(floor(&_qrc_ht_qmin))));\n  %let _qrc_ht_qmax = %sysfunc(max(1, %sysfunc(floor(&_qrc_ht_qmax))));\n  %if %sysevalf(&_qrc_ht_qmax < &_qrc_ht_qmin, boolean) %then %let _qrc_ht_qmax = &_qrc_ht_qmin;\n  %if %sysevalf(&_qrc_ht_cutmax < &_qrc_ht_cutmin, boolean) %then %let _qrc_ht_cutmax = &_qrc_ht_cutmin;\n  %if %sysevalf(&_qrc_ht_gb_nt_max < &_qrc_ht_gb_nt_min, boolean) %then %let _qrc_ht_gb_nt_max = &_qrc_ht_gb_nt_min;\n  %if %sysevalf(&_qrc_ht_gb_lr_max < &_qrc_ht_gb_lr_min, boolean) %then %let _qrc_ht_gb_lr_max = &_qrc_ht_gb_lr_min;\n  %if %sysevalf(&_qrc_ht_gb_depth_max < &_qrc_ht_gb_depth_min, boolean) %then %let _qrc_ht_gb_depth_max = &_qrc_ht_gb_depth_min;\n  %if %sysevalf(&_qrc_ht_gb_leaf_max < &_qrc_ht_gb_leaf_min, boolean) %then %let _qrc_ht_gb_leaf_max = &_qrc_ht_gb_leaf_min;\n  %if %sysevalf(&_qrc_ht_rf_nt_max < &_qrc_ht_rf_nt_min, boolean) %then %let _qrc_ht_rf_nt_max = &_qrc_ht_rf_nt_min;\n  %if %sysevalf(&_qrc_ht_rf_bins_max < &_qrc_ht_rf_bins_min, boolean) %then %let _qrc_ht_rf_bins_max = &_qrc_ht_rf_bins_min;\n  %if %sysevalf(&_qrc_ht_rf_leaf_max < &_qrc_ht_rf_leaf_min, boolean) %then %let _qrc_ht_rf_leaf_max = &_qrc_ht_rf_leaf_min;\n\n  /* Circuit types for the Hypertune search come from the Circuit types list. */\n  %let _qrc_ht_circuits = ;\n  %if %symexist(list1_count) %then %do;\n    %do _qrc_k = 1 %to %sysfunc(inputn(%sysfunc(coalescec(%superq(list1_count), 0)), best.));\n      %let _qrc_nm = %upcase(%sysfunc(compress(%superq(list1_&_qrc_k), %str( ))));\n      %if %length(&_qrc_nm) %then %let _qrc_ht_circuits = &_qrc_ht_circuits &_qrc_nm;\n    %end;\n  %end;\n  %if %length(&_qrc_ht_circuits) = 0 %then\n    %let _qrc_ht_circuits = ENTANGLED;\n  %let _qrc_ht_ncircuits = %sysfunc(countw(&_qrc_ht_circuits, %str( )));\n%mend _qrc_ht_prepare_bounds;\n\n%macro _qrc_ht_cache_options;\n  %local _use_cache_uc _qrc_nobs _qrc_sig_new _qrc_sig_same;\n  %global _qrc_ht_cachein_opt;\n  %let _qrc_ht_cachein_opt = ;\n  %let _use_cache_uc = %upcase(%sysfunc(coalescec(%superq(UseCache), 1)));\n  %if \"&_use_cache_uc\" = \"1\" or \"&_use_cache_uc\" = \"Y\" or \"&_use_cache_uc\" = \"YES\" or \"&_use_cache_uc\" = \"TRUE\" %then %do;\n    /* Cached points store the circuit as a list position, so reuse them only for the same search definition. */\n    data _null_;\n      if 0 then set &_input_for_qrc nobs=_n;\n      call symputx('_qrc_nobs', _n, 'L');\n      stop;\n    run;\n    %let _qrc_sig_new = &_qrc_ht_circuits|&inputtable1|&_qrc_nobs|%superq(SampleRate)|%superq(LabelNoiseRate)|%superq(SimMethod);\n    %let _qrc_sig_same = 0;\n    data _null_;\n      length _old _new $2000;\n      _old = '';\n      _new = symget('_qrc_sig_new');\n      %if %sysfunc(exist(work._qrc_hypertune_sig)) %then %do;\n        set work._qrc_hypertune_sig(rename=(sig=_old));\n      %end;\n      call symputx('_qrc_sig_same', _old = _new, 'L');\n    run;\n    %if &_qrc_sig_same = 0 and %sysfunc(exist(work._qrc_hypertune_cache)) %then %do;\n      %put NOTE: The Hypertune search definition changed (circuits, input data, Downsample, label noise, or simulation method). Resetting the PROC HYPERTUNE cache.;\n      proc datasets lib=work nolist nowarn;\n        delete _qrc_hypertune_cache _qrc_hypertune_cache_in _qrc_ht_best _qrc_ht_best_wide;\n      quit;\n    %end;\n    data work._qrc_hypertune_sig;\n      length sig $2000;\n      sig = symget('_qrc_sig_new');\n    run;\n    %if %sysfunc(exist(work._qrc_hypertune_cache)) %then %do;\n      data work._qrc_hypertune_cache_in;\n        set work._qrc_hypertune_cache;\n      run;\n      %let _qrc_ht_cachein_opt = cachein=work._qrc_hypertune_cache_in;\n    %end;\n  %end;\n  %else %do;\n    proc datasets lib=work nolist nowarn;\n      delete _qrc_hypertune_cache _qrc_hypertune_cache_in _qrc_hypertune_sig _qrc_ht_best _qrc_ht_best_wide;\n    quit;\n  %end;\n%mend _qrc_ht_cache_options;\n\n%macro _qrc_ht_apply_best;\n  %local _dsid _has_id _rc _qrc_cidx;\n  %global _qrc_champion_accuracy;\n  %if not %sysfunc(exist(work._qrc_ht_best)) %then %return;\n  %let _dsid = %sysfunc(open(work._qrc_ht_best));\n  %if &_dsid > 0 %then %do;\n    %let _has_id = %sysfunc(varnum(&_dsid, _id_));\n    %let _rc = %sysfunc(close(&_dsid));\n  %end;\n  %else %let _has_id = 0;\n\n    /* PRIMALOUT can be long (_id_/_value_) or already wide depending on PROC\n      HYPERTUNE version/options.  Normalize it before reading champion values. */\n    %if &_has_id > 0 %then %do;\n    proc transpose data=work._qrc_ht_best(where=(_sol_=1)) out=work._qrc_ht_best_wide(drop=_name_ _label_);\n      id _id_;\n      var _value_;\n    run;\n  %end;\n  %else %do;\n    data work._qrc_ht_best_wide;\n      set work._qrc_ht_best(obs=1);\n    run;\n  %end;\n\n  data _null_;\n    set work._qrc_ht_best_wide(obs=1);\n    if not missing(LogC_ht) then call symputx('C_param', 10 ** LogC_ht, 'G');\n    if not missing(LogK_ht) then call symputx('K_par', 10 ** LogK_ht, 'G');\n    if not missing(Qubits_ht) then call symputx('_best_qubits', round(Qubits_ht), 'G');\n    if not missing(Circuit_ht) then call symputx('_qrc_cidx', round(Circuit_ht), 'L');\n    if not missing(accuracy) then call symputx('_qrc_champion_accuracy', accuracy, 'G');\n    if not missing(cutoff_ht) then call symputx('cutoff_param', cutoff_ht, 'G');\n    if not missing(GB_NTrees_ht) then call symputx('GB_NTrees', round(GB_NTrees_ht), 'G');\n    if not missing(GB_LearnRate_ht) then call symputx('GB_LearnRate', GB_LearnRate_ht, 'G');\n    if not missing(GB_MaxDepth_ht) then call symputx('GB_MaxDepth', round(GB_MaxDepth_ht), 'G');\n    if not missing(GB_MinLeaf_ht) then call symputx('GB_MinLeaf', round(GB_MinLeaf_ht), 'G');\n    if not missing(RF_NTrees_ht) then call symputx('RF_NTrees', round(RF_NTrees_ht), 'G');\n    if not missing(RF_IntervalBins_ht) then call symputx('RF_IntervalBins', round(RF_IntervalBins_ht), 'G');\n    if not missing(RF_MinLeaf_ht) then call symputx('RF_MinLeaf', round(RF_MinLeaf_ht), 'G');\n  run;\n  %if %length(&_qrc_cidx) %then %do;\n    %let CircuitType = %scan(&_qrc_ht_circuits, &_qrc_cidx, %str( ));\n    %put NOTE: PROC HYPERTUNE selected Circuit=&CircuitType Qubits=&_best_qubits..;\n  %end;\n%mend _qrc_ht_apply_best;\n\n%macro _qrc_prep_ht_qubit_tables;\n  %local _q _c;\n  %global _best_qubits _best_circuit _sim_method _qasm_work_path;\n\n  %_qrc_ht_prepare_bounds;\n  %let _best_circuit = %upcase(%sysfunc(compress(%sysfunc(coalescec(%superq(CircuitType), ENTANGLED)), %str( ))));\n  %let _sim_method = %sysfunc(coalescec(%superq(SimMethod), automatic));\n\n    %put NOTE: PROC HYPERTUNE circuit search list: &_qrc_ht_circuits..;\n    %put NOTE: PROC HYPERTUNE qubit search range: &_qrc_ht_qmin to &_qrc_ht_qmax..;\n    /* Hypertune cannot run PROC QRUN inside every objective cheaply.  Instead,\n      build each candidate reservoir once, then let the objective pick the\n      precomputed table that corresponds to candidate Qubits_ht. */\n  %do _c = 1 %to &_qrc_ht_ncircuits;\n    %let _best_circuit = %scan(&_qrc_ht_circuits, &_c, %str( ));\n    %do _q = &_qrc_ht_qmin %to &_qrc_ht_qmax;\n      %let _best_qubits = &_q;\n      %let _qasm_work_path = %sysfunc(pathname(work))/qrc_circuit_&_qrc_uuid._c&_c._q&_q..qasm3;\n      %put NOTE: Preparing QRUN candidate reservoir for Hypertune: Circuit=&_best_circuit Qubits=&_q..;\n\n      %q_build_circuit(\n        num_qubits   = &_q,\n        circuit_type = &_best_circuit,\n        qasm_path    = &_qasm_work_path,\n        show_diagram = 0\n      );\n\n      %q_run_reservoir(\n        data_path     = &_data_csv,\n        qasm_path     = &_qasm_work_path,\n        n_parallel    = &NumParallel,\n        output_suffix = _&_qrc_uuid._c&_c._q&_q,\n        sim_method    = &_sim_method,\n        show_circuit  = 0\n      );\n\n      data work._qrc_ht_combined_c&_c._q&_q;\n        set work._qrc_combined_wide;\n      run;\n    %end;\n  %end;\n%mend _qrc_prep_ht_qubit_tables;\n\n%macro _qrc_ht_write_template(_c, _q);\n  %local _qrc_ht_vars_q;\n  proc contents data=work._qrc_ht_combined_c&_c._q&_q(drop=_obsid) out=work._qrc_ht_input_vars_c&_c._q&_q(keep=name type varnum) noprint;\n  run;\n  proc sql noprint;\n    select name into :_qrc_ht_vars_q separated by ' '\n    from work._qrc_ht_input_vars_c&_c._q&_q\n    where type = 1\n    order by varnum;\n  quit;\n\n    /* Embed candidate data in the submit block.  This avoids SAS Studio worker\n      sessions trying to reopen physical CSV paths that may not be visible. */\n    data _null_;\n    file \"&_qrc_ht_submit_file\" mod lrecl=32767;\n    put \"data work._qrc_ht_toy_template_c&_c._q&_q;\";\n    put '  infile datalines4 dsd dlm='','';';\n    put \"  input &_qrc_ht_vars_q;\";\n    put 'datalines4;';\n  run;\n  data _null_;\n    set work._qrc_ht_combined_c&_c._q&_q(drop=_obsid);\n    length _line $32767;\n    file \"&_qrc_ht_submit_file\" mod lrecl=32767;\n    _line = catx(',', of &_qrc_ht_vars_q);\n    put _line;\n  run;\n  data _null_;\n    file \"&_qrc_ht_submit_file\" mod lrecl=32767;\n    put ';;;;';\n    put 'run;';\n  run;\n%mend _qrc_ht_write_template;\n\n%macro _qrc_hypertune_ml;\n  %local _algo_uc _qrc_ht_submit_file _q _c;\n  %let _algo_uc = %upcase(%sysfunc(compress(%superq(ml_algorithm), %str( ))));\n  %if %sysevalf(%superq(_algo_uc)=, boolean) or &_algo_uc = NONE %then %do;\n    %put NOTE: PROC HYPERTUNE skipped because ml_algorithm=none.;\n    %return;\n  %end;\n\n  %if %sysevalf(%superq(C_param)=, boolean) %then %let C_param = 1;\n  %if %sysevalf(%superq(K_par)=, boolean) %then %let K_par = 1.0;\n  %_qrc_ht_prepare_bounds;\n  %_qrc_ht_cache_options;\n  %put NOTE: Running PROC HYPERTUNE for &_algo_uc over circuits=&_qrc_ht_circuits qubits=&_qrc_ht_qmin-&_qrc_ht_qmax and log-scale SVM C=&_qrc_ht_cmin-&_qrc_ht_cmax gamma=&_qrc_ht_gmin-&_qrc_ht_gmax..;\n  %put NOTE: PROC HYPERTUNE search controls: maxfunc=&_qrc_ht_trials popsize=&_qrc_ht_popsize nglobal=&_qrc_ht_nglobal nparallel=&_qrc_ht_nparallel..;\n\n  %if &_algo_uc = SVM %then %do;\n    %if not %sysfunc(exist(work._qrc_ht_combined_c1_q&_qrc_ht_qmin)) %then %do;\n      %_qrc_prep_ht_qubit_tables;\n    %end;\n    %let _qrc_ht_submit_file = %sysfunc(pathname(work))/qrc_hypertune_svm_submit_&_qrc_uuid..sas;\n    data _null_;\n      file \"&_qrc_ht_submit_file\" lrecl=32767;\n      put 'submit;';\n    run;\n    %do _c = 1 %to &_qrc_ht_ncircuits;\n      %do _q = &_qrc_ht_qmin %to &_qrc_ht_qmax;\n        %_qrc_ht_write_template(&_c, &_q);\n      %end;\n    %end;\n    data _null_;\n      file \"&_qrc_ht_submit_file\" mod lrecl=32767;\n      put '%macro accuracy(LogC_ht, LogK_ht, Qubits_ht, Circuit_ht);';\n      put '  %let accuracy_val = 0;';\n      put '  %let _ht_c = %sysevalf(10 ** &LogC_ht);';\n      put '  %let _ht_k = %sysevalf(10 ** &LogK_ht);';\n      put '  %let _ht_qubits = %sysfunc(round(&Qubits_ht));';\n      put '  %let _ht_circuit = %sysfunc(round(&Circuit_ht));';\n      %do _c = 1 %to &_qrc_ht_ncircuits;\n        %do _q = &_qrc_ht_qmin %to &_qrc_ht_qmax;\n          _line = cats('  %if &_ht_qubits = ', &_q, ' and &_ht_circuit = ', &_c, ' %then %do;');\n          put _line;\n          put \"    data work._qrc_ht_toy; set work._qrc_ht_toy_template_c&_c._q&_q; run;\";\n          put '  %end;';\n        %end;\n      %end;\n      put '  data work._qrc_ht_toy;';\n      put '    set work._qrc_ht_toy;';\n      put '  run;';\n      put '  proc contents data=work._qrc_ht_toy out=work._qrc_ht_vars(keep=name type) noprint;';\n      put '  run;';\n      put '  proc sql noprint;';\n      put \"    select name into :_ht_pred_num separated by ' ' from work._qrc_ht_vars where type=1 and upcase(name) ne 'Y';\";\n      put \"    select name into :_ht_pred_char separated by ' ' from work._qrc_ht_vars where type=2 and upcase(name) ne 'Y';\";\n      put '  quit;';\n      put '  %if %superq(_ht_pred_num) ne or %superq(_ht_pred_char) ne %then %do;';\n      put '    ods exclude all;';\n      put '    proc hpsvm data=work._qrc_ht_toy c=&_ht_c method=activeset;';\n      put '      target y;';\n      put '      %if %superq(_ht_pred_num) ne %then %do; input &_ht_pred_num / level=interval; %end;';\n      put '      %if %superq(_ht_pred_char) ne %then %do; input &_ht_pred_char / level=nominal; %end;';\n      put '      kernel rbf / k_par=&_ht_k;';\n      put '      ods output FitStatistics=work._qrc_ht_fitstat;';\n      put '    run;';\n      put '    ods exclude none;';\n      put '    proc sql noprint;';\n      put \"      select max(Training) into :accuracy_val trimmed\";\n      put '      from work._qrc_ht_fitstat';\n      put \"      where upcase(strip(Statistic)) = 'ACCURACY';\";\n      put '    quit;';\n      put '  %end;';\n      put '  %if %sysevalf(%superq(accuracy_val)=, boolean) %then %let accuracy_val = 0;';\n      put '%mend accuracy;';\n      put 'endsubmit;';\n    run;\n\n    proc hypertune algorithm=RANDOM maxfunc=&_qrc_ht_trials nglobal=&_qrc_ht_nglobal popsize=&_qrc_ht_popsize seed=42 nparallel=&_qrc_ht_nparallel\n        &_qrc_ht_cachein_opt cacheout=work._qrc_hypertune_cache primalout=work._qrc_ht_best\n        logfreq=1 loglevel=1 printlevel=1;\n      var LogC_ht / lb=&_qrc_ht_logcmin ub=&_qrc_ht_logcmax type=C init=&_qrc_ht_logcinit;\n      var LogK_ht / lb=&_qrc_ht_loggmin ub=&_qrc_ht_loggmax type=C init=&_qrc_ht_logginit;\n      var Qubits_ht / lb=&_qrc_ht_qmin ub=&_qrc_ht_qmax type=I init=&_best_qubits;\n      var Circuit_ht / lb=1 ub=&_qrc_ht_ncircuits type=I init=1;\n      obj accuracy / type=MAX objvalue=accuracy_val;\n      %include \"&_qrc_ht_submit_file\";\n    run;\n  %end;\n\n  %_qrc_ht_apply_best;\n%mend _qrc_hypertune_ml;\n\n%macro _qrc_mode_quantumlab;\n  %_qrc_run_reservoir_selected;\n%mend _qrc_mode_quantumlab;\n\n/* Hypertune mode always tunes SVM; the main block forces ml_algorithm=svm. */\n%macro _qrc_mode_hypertune;\n  %_qrc_prep_ht_qubit_tables;\n  %_qrc_hypertune_ml;\n  %_qrc_run_reservoir_selected;\n%mend _qrc_mode_hypertune;\n\n/* endregion */\n/* region: Input sampling */\n/* ---- Downsample input and write CSV ---- */\n%global _input_for_qrc;\n%macro _qrc_downsample;\n  %local _pct _rate;\n  %if %sysevalf(%superq(SampleRate)=, boolean) %then %let _pct = 100;\n  %else %do;\n    %let _pct = %sysfunc(inputn(%superq(SampleRate), best.));\n    %if %sysevalf(&_pct < 1 or &_pct > 100, boolean) %then %let _pct = 100;\n  %end;\n  %if &_pct < 100 %then %do;\n    %let _rate = %sysevalf(&_pct / 100);\n    ods select none;\n    proc surveyselect data=&inputtable1 out=work._qrc_sample_&_qrc_uuid method=srs samprate=&_rate seed=12345;\n    run;\n    ods select all;\n    %let _input_for_qrc = work._qrc_sample_&_qrc_uuid;\n  %end;\n  %else %let _input_for_qrc = &inputtable1;\n%mend _qrc_downsample;\n%_qrc_downsample;\n\nproc export data=&_input_for_qrc outfile=&_data_csv dbms=csv replace;\nrun;\n\n/* endregion */\n/* region: Run and cleanup */\n/* ---- Main SAS-only QRUN path. ---- */\n%let _mode_uc = %upcase(%superq(Mode));\n%if \"&_mode_uc\" = \"AUTOTUNE\" %then %do;\n  %if %upcase(%sysfunc(compress(%superq(ml_algorithm), %str( )))) ne SVM %then %do;\n    %put NOTE: Hypertune mode tunes SVM only, using ml_algorithm=svm.;\n    %let ml_algorithm = svm;\n  %end;\n  %_qrc_mode_hypertune;\n%end;\n%else %do;\n  %_qrc_mode_quantumlab;\n%end;\n\n%_qrc_run_ml;\n%_qrc_output_finalize;\n\n/* ---- Remove run-local tables. The Hypertune cache survives only when Use cache is on. ---- */\n%let _qrc_keep_cache = %upcase(%sysfunc(coalescec(%superq(UseCache), 1)));\nproc sql noprint;\n  select memname into :_qrc_drop_list separated by ' '\n  from dictionary.tables\n  where libname = 'WORK' and memtype = 'DATA' and substr(memname, 1, 5) = '_QRC_'\n  %if \"&_qrc_keep_cache\" = \"1\" or \"&_qrc_keep_cache\" = \"Y\" or \"&_qrc_keep_cache\" = \"YES\" or \"&_qrc_keep_cache\" = \"TRUE\" %then %do;\n    and memname not in ('_QRC_HYPERTUNE_CACHE', '_QRC_HYPERTUNE_SIG')\n  %end;\n  ;\nquit;\n%if %superq(_qrc_drop_list) ne %then %do;\n  proc datasets lib=work nolist nowarn memtype=data;\n    delete &_qrc_drop_list;\n  run;\n  quit;\n%end;\n%if %sysfunc(libref(qrun)) = 0 %then %do;\n  proc datasets lib=qrun nolist nowarn memtype=data;\n    delete _qrc_params _qrc_expect;\n  run;\n  quit;\n%end;\n\n/* ---- Restore the options changed at the start. ---- */\noptions &_qrc_mlogic &_qrc_mprint &_qrc_symbolgen;\n\n%put NOTE: QuantumQRC PROC HYPERTUNE refactor complete. UUID=&_qrc_uuid Mode=&Mode Circuit=&_best_circuit Qubits=&_best_qubits.;\n\n%mend _qrc_main;\n%_qrc_main;\n\n/* endregion */\n/* region: Macro variable and macro cleanup */\n/* ---- Remove the global macro variables and macros created by this step. ---- */\n%symdel _best_circuit _best_qubits _classical_csv _combined_csv _heatmap_uuid _input_for_qrc\n  _qasm_work_path _qrc_champion_accuracy _qrc_circuit_ds _qrc_csv _qrc_elapsed\n  _qrc_ht_cachein_opt _qrc_ht_circuits _qrc_ht_cmax _qrc_ht_cmin _qrc_ht_cutmax _qrc_ht_cutmin\n  _qrc_ht_gb_depth_max _qrc_ht_gb_depth_min _qrc_ht_gb_leaf_max _qrc_ht_gb_leaf_min\n  _qrc_ht_gb_lr_max _qrc_ht_gb_lr_min _qrc_ht_gb_nt_max _qrc_ht_gb_nt_min _qrc_ht_gmax\n  _qrc_ht_gmin _qrc_ht_logcinit _qrc_ht_logcmax _qrc_ht_logcmin _qrc_ht_logginit _qrc_ht_loggmax\n  _qrc_ht_loggmin _qrc_ht_ncircuits _qrc_ht_nglobal _qrc_ht_nparallel _qrc_ht_popsize _qrc_ht_qmax _qrc_ht_qmin\n  _qrc_ht_rf_bins_max _qrc_ht_rf_bins_min _qrc_ht_rf_leaf_max _qrc_ht_rf_leaf_min\n  _qrc_ht_rf_nt_max _qrc_ht_rf_nt_min _qrc_ht_trials _qrc_invalid _qrc_model_label _qrc_uuid _qrc_wallclock _sim_method base\n  / nowarn;\n%sysmacdelete _qrc_main / nowarn;\n%sysmacdelete _qrc_is_true / nowarn;\n%sysmacdelete _qrc_validate / nowarn;\n%sysmacdelete q_build_circuit / nowarn;\n%sysmacdelete _qrc_make_feature_scores / nowarn;\n%sysmacdelete q_run_reservoir / nowarn;\n%sysmacdelete _ensure_heatmap_uuid / nowarn;\n%sysmacdelete heatmap_xcorr / nowarn;\n%sysmacdelete _maybe_heatmaps / nowarn;\n%sysmacdelete _qrc_render_runtime_summary / nowarn;\n%sysmacdelete run_svm / nowarn;\n%sysmacdelete run_log_select / nowarn;\n%sysmacdelete run_gradboost / nowarn;\n%sysmacdelete run_forest / nowarn;\n%sysmacdelete _qrc_run_algo_triplet / nowarn;\n%sysmacdelete _qrc_build_accuracy_summary / nowarn;\n%sysmacdelete _qrc_render_accuracy_bar / nowarn;\n%sysmacdelete _qrc_run_ml / nowarn;\n%sysmacdelete _qrc_output_finalize / nowarn;\n%sysmacdelete _qrc_run_reservoir_selected / nowarn;\n%sysmacdelete _qrc_ht_prepare_bounds / nowarn;\n%sysmacdelete _qrc_ht_cache_options / nowarn;\n%sysmacdelete _qrc_ht_apply_best / nowarn;\n%sysmacdelete _qrc_prep_ht_qubit_tables / nowarn;\n%sysmacdelete _qrc_ht_write_template / nowarn;\n%sysmacdelete _qrc_hypertune_ml / nowarn;\n%sysmacdelete _qrc_mode_quantumlab / nowarn;\n%sysmacdelete _qrc_mode_hypertune / nowarn;\n%sysmacdelete _qrc_downsample / nowarn;\n/* endregion */\n"}}